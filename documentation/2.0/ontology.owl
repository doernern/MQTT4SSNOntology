    <!-- http://qudt.org/schema/qudt/currencyCode -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/currencyCode">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/currencyExponent -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/currencyExponent">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <terms:description>
  The currency exponent indicates the number of decimal places between a major currency unit and its minor currency unit. 
  For example, the US dollar is the major currency unit of the United States, and the US cent is the minor currency unit. Since one cent is 1/100 of a dollar, the US dollar has a currency exponent of 2. 
  However, the Japanese Yen has no minor currency units, so the yen has a currency exponent of 0.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>currency exponent</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/currencyNumber -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/currencyNumber">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


