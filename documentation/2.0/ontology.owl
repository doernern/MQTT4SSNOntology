        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a factor unit its exponent</terms:description>
        <qudt:plainTextDescription>Defines the exponent of a factor unit</qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>exponent</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://qudt.org/schema/qudt/expression -->


    <owl:AnnotationProperty rdf:about="http://qudt.org/schema/qudt/expression">
        <terms:description>
  An &apos;expression&apos; is a finite combination of symbols that are well-formed according to rules that apply to units of measure, quantity kinds and their dimensions.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>expression</rdfs:label>
    </owl:AnnotationProperty>
    


