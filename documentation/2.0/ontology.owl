        <rdfs:label xml:lang="en">Network Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#NetworkParticipant -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#NetworkParticipant">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkEntity"/>
        <rdfs:comment xml:lang="en">An entity participating in an MQTT network, such as an MQTT Client or an MQTT Broker.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Network Participant</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#NetworkSession -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#NetworkSession">
