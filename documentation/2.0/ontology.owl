                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubackVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubscribeVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeVariableHeader"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Properties"/>
        <rdfs:comment xml:lang="en">Links an MQTT Control Packet or higher-level message individual to its MQTT 5.0 Properties collection (variable header properties).</rdfs:comment>
        <rdfs:label xml:lang="en">has Properties</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPropertySubject -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPropertySubject">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasSubject"/>
