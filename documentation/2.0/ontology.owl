    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Actuation"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ActuationCollection"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ObservationCollection"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Property"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#Activity"/>
            <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage"/>
            <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket"/>
            <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader"/>
