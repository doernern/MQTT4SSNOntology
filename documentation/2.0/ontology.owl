        <rdfs:label xml:lang="en">MQTT Pubcomp Properties</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#PubcompVariableHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubcompVariableHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader"/>
