        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#WillProperties"/>
        <rdfs:comment xml:lang="en">Links a CONNECT packet or Will Message individual to its WillProperties collection.</rdfs:comment>
        <rdfs:label xml:lang="en">has Will Properties</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasWillTopic -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasWillTopic">
        <owl:inverseOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#isWillTopicOf"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectPayload"/>
        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Topic"/>
        <rdfs:comment xml:lang="en">Links a CONNECT packet or Will Message to its Will Topic (Topic Name used when publishing the Will).</rdfs:comment>
        <rdfs:label xml:lang="en">has Will Topic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hosts -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hosts">
        <owl:inverseOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#isHostedBy"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Client"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/ssn/System"/>
        <rdfs:comment xml:lang="en">Links an MQTT Client (as a SOSA platform) to SSN systems (sensors/actuators) it hosts.</rdfs:comment>
        <rdfs:label xml:lang="en">hosts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#isAcceptedBy -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#isAcceptedBy">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkConnection"/>
        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Broker"/>
        <rdfs:comment xml:lang="en">Indicates the MQTT Broker that accepted the client&apos;s connection request.</rdfs:comment>
        <rdfs:label xml:lang="en">is accepted by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#isActObsSubjectOf -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#isActObsSubjectOf">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#isSubjectOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Actuation"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ActuationCollection"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ObservationCollection"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Topic"/>
        <rdfs:comment xml:lang="en">Links a topic subject (Actuation, Actuation collection, Observation or Observation Collection) to the MQTT Topic that carries it.</rdfs:comment>
        <rdfs:label xml:lang="en">is topic subject (Actuation, Actuation collection, Observation or Observation Collection) of</rdfs:label>
    </owl:ObjectProperty>
    


