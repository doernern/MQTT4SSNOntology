        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#PublishPayload"/>
        <rdfs:comment xml:lang="en">Inverse of hasApplicationMessage: links an ApplicationMessage to the PUBLISH packet that carries it.</rdfs:comment>
        <rdfs:label xml:lang="en">is Application Message of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#isAuthFixedHeaderOf -->


