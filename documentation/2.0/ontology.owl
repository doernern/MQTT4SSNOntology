        <rdfs:label xml:lang="en">MQTT DISCONNECT Variable Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader">
