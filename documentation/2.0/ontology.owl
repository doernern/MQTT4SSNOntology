        <terms:description>Provides a way to reference information that is an authoritative source providing a standard definition</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>normative reference</rdfs:label>
    </owl:DatatypeProperty>
    


