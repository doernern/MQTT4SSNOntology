        <owl:inverseOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#isActObsSubjectOf"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Topic"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Actuation"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ActuationCollection"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ObservationCollection"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links an MQTT Topic to the subject (Actuation, Actuation collection, Observation or Observation Collection).</rdfs:comment>
        <rdfs:label xml:lang="en">has topic subject (Actuation, Actuation collection, Observation or Observation Collection)</rdfs:label>
    </owl:ObjectProperty>
    


