    <!-- http://qudt.org/schema/qudt/Prefix -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Prefix">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Concept"/>
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Verifiable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/ucumCode"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
