    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#PingrespFixedHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PingrespFixedHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader"/>
        <rdfs:comment xml:lang="en">The Fixed Header of a PINGRESP packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT PINGRESP Fixed Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#PingrespPacket -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PingrespPacket">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket"/>
        <rdfs:comment xml:lang="en">An MQTT Control Packet sent by the Server in response to a PINGREQ Packet to indicate that the Server is alive.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT PINGRESP Packet</rdfs:label>
    </owl:Class>
    


