        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>landscape</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/latexDefinition -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/latexDefinition">
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>latex definition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/latexSymbol -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/latexSymbol">
        <terms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The symbol is a glyph that is used to represent some concept, typically a unit or a quantity, in a compact form. 
  For example, the symbol for an Ohm is $ohm$. 
  This contrasts with &apos;unit:abbreviation&apos;, which gives a short alphanumeric abbreviation for the unit, &apos;ohm&apos; for Ohm.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>latex symbol</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/mathMLdefinition -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/mathMLdefinition">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/mathDefinition"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


