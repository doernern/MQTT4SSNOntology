    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrecVariableHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader"/>
        <rdfs:comment xml:lang="en">The Variable Header of a PUBREC packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT PUBREC Variable Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#PubrelFixedHeader -->


