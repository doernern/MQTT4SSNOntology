        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">For a derived unit that is not exactly the product of its factor units, this property defines the scalar with which that product has to be multiplied with.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>factorUnitScalar</rdfs:label>
    </owl:DatatypeProperty>
    


