    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#Properties">
        <rdfs:comment xml:lang="en">Abstract superclass for MQTT 5.0 Property collections. Each concrete *Properties class represents the Properties section of a specific Control Packet or Payload, encoded as a sequence of Property Identifiers and typed values.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Properties</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#PubackFixedHeader -->


