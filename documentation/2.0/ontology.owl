        <rdfs:label xml:lang="en">MQTT Fixed Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#NetworkConnection -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#NetworkConnection">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkEntity"/>
        <rdfs:comment xml:lang="en">A transport-layer connection between an MQTT Client and an MQTT Broker (optionally secured with TLS).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Network Connection</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#NetworkEntity -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#NetworkEntity">
