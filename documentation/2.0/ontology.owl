    <!-- http://qudt.org/schema/qudt/valueSN -->


    <owl:AnnotationProperty rdf:about="http://qudt.org/schema/qudt/valueSN">
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">A property to relate an observable thing with a value expressed in scientific notation</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>value scientific</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://qudt.org/schema/qudt/wikidataMatch -->


    <owl:AnnotationProperty rdf:about="http://qudt.org/schema/qudt/wikidataMatch">
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a QUDT concept to a Wikidata item. The Wikidata item is identified by the Wikidata URI, which is of the form `https://www.wikidata.org/wiki/Q{number}`.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Wikidata match</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:AnnotationProperty>
    


    <!-- http://schema.org/codeRepository -->


    <owl:AnnotationProperty rdf:about="http://schema.org/codeRepository"/>
    


    <!-- http://schema.org/domainIncludes -->


    <owl:AnnotationProperty rdf:about="http://schema.org/domainIncludes"/>
    


    <!-- http://schema.org/rangeIncludes -->


    <owl:AnnotationProperty rdf:about="http://schema.org/rangeIncludes"/>
    


    <!-- http://voag.linkedmodel.org/schema/voag#supersededBy -->


    <owl:AnnotationProperty rdf:about="http://voag.linkedmodel.org/schema/voag#supersededBy">
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>superseded by</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2001/XMLSchema#maxInclusive -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2001/XMLSchema#maxInclusive"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#minInclusive -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2001/XMLSchema#minInclusive"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#example -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#note -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom">
        <rdfs:label>was derived from</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://xmlns.com/foaf/0.1/fundedBy -->


    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/fundedBy"/>
    


    <!-- http://xmlns.com/foaf/0.1/homepage -->


    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/homepage"/>
    


    <!-- http://xmlns.com/foaf/0.1/mbox -->


    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/mbox"/>
    


    <!-- http://xmlns.com/foaf/0.1/name -->


    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/LatexString -->


    <rdfs:Datatype rdf:about="http://qudt.org/schema/qudt/LatexString"/>
    


    <!-- http://qudt.org/schema/qudt/UCUMcs -->


    <rdfs:Datatype rdf:about="http://qudt.org/schema/qudt/UCUMcs"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt/applicableCGSUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableCGSUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable CGS unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableISOUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableISOUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable ISO unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableImperialUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableImperialUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable Imperial unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicablePhysicalConstant -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicablePhysicalConstant">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable physical constant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicablePlanckUnit -->


    <rdf:Description rdf:about="http://qudt.org/schema/qudt/applicablePlanckUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
    </rdf:Description>
    


    <!-- http://qudt.org/schema/qudt/applicableSIUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableSIUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable SI unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableSystem -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableSystem">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <terms:description>
  This property relates a unit of measure with a unit system that may or may not define the unit,
   but within which the unit is compatible.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableUSCustomaryUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableUSCustomaryUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable US Customary unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableUnit">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;See this page on the QUDT GitHub&lt;a href=&quot;https://github.com/qudt/qudt-public-repo/wiki/Advanced-User-Guide#4-computing-applicable-units-for-a-quantitykind&quot;&gt;Wiki&lt;/a&gt;
   on how &quot;qudt:applicableUnit&quot; is computed from &quot;qudt:hasQuantityKind&quot; and then materialized.
  &lt;/p&gt;</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/baseDimensionEnumeration -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/baseDimensionEnumeration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Enumeration"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property associates a system of quantities with an enumeration that enumerates the base dimensions of the system in canonical order.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>base dimension enumeration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/baseUnitOfSystem -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/baseUnitOfSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/definedUnitOfSystem"/>
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/hasBaseUnit"/>
        <terms:description>
  This property relates a unit of measure to the system of units in which it is defined as a base unit for the system. 
  The base units of a system are used to define the derived units of the system by expressing the derived units as products of the base units raised to a rational power.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>is base unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/belongsToSystemOfQuantities -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/belongsToSystemOfQuantities">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfQuantityKinds"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>belongs to system of quantities</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/coherentUnitSystem -->


    <rdf:Description rdf:about="http://qudt.org/schema/qudt/coherentUnitSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasUnitSystem"/>
    </rdf:Description>
    


    <!-- http://qudt.org/schema/qudt/datatype -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/datatype">
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/default -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/default">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/EnumeratedValue"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">The default element in an enumeration</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>default</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/definedUnitOfSystem -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/definedUnitOfSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/isUnitOfSystem"/>
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/hasDefinedUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a unit of measure with the unit system that defines the unit.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>defined unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/definedUnitOfSystem"/>
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/derivedUnitOfSystem"/>
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/hasDerivedCoherentUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a unit of measure to the unit system in which the unit is derived from the system&apos;s base units with a proportionality constant of one.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>is coherent derived unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/derivedNonCoherentUnitOfSystem -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/derivedNonCoherentUnitOfSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/derivedUnitOfSystem"/>
        <terms:description>
  This property relates a unit of measure to the unit system in which the unit is derived from the system&apos;s
   base units without proportionality constant of one.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>is non-coherent derived unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/derivedUnitOfSystem -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/derivedUnitOfSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/isUnitOfSystem"/>
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/hasDerivedUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <terms:description>
  This property relates a unit of measure to the system of units in which it is defined as a derived unit. 
  That is, the derived unit is defined as a product of the base units for the system raised to some rational power.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>is derived unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/dimensionInverse -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/dimensionInverse">
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/dimensionInverse"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>dimension inverse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/dimensionVectorForSI -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/dimensionVectorForSI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>dimension vector for SI</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/element -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/element">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/EnumeratedValue"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">An element of an enumeration</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>element</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/enumeratedValue -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/enumeratedValue">
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/enumeration -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/enumeration">
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/exactMatch -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/exactMatch">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Concept"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/guidance -->


    <rdf:Description rdf:about="http://qudt.org/schema/qudt/guidance">
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"/>
    </rdf:Description>
    


    <!-- http://qudt.org/schema/qudt/hasAllowedUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasAllowedUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <terms:description>
  This property relates a unit system with a unit of measure that is not defined by or part of the system,
   but is allowed for use within the system.
   An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>allowed unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasBaseQuantityKind -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasBaseQuantityKind">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasQuantityKind"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has base quantity kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasBaseUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasBaseUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasCoherentUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <terms:description>
  This property relates a system of units to a base unit defined within the system.
  The base units of a system are used to define the derived units of the system by expressing
   the derived units as products of the base units raised to a rational power.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>base unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasCoherentUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasCoherentUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasDefinedUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <terms:description>
  A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers
   of the system&apos;s base units with the proportionality factor of one.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>coherent unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasDefinedUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasDefinedUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a unit system with a unit of measure that is defined by the system.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>defined unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasDerivedCoherentUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasDerivedCoherentUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasCoherentUnit"/>
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasDerivedUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>derived coherent unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasDerivedNonCoherentUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasDerivedNonCoherentUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasDerivedUnit"/>
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/derivedNonCoherentUnitOfSystem"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has coherent derived unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasDerivedUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasDerivedUnit">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <terms:description>
  This property relates a system of units to a unit of measure that is defined within the system in terms
   of the base units for the system. 
  That is, the derived unit is defined as a product of the base units for the system raised to some rational power.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>derived unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasDimensionVector -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasDimensionVector">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKindDimensionVector"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has dimension vector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasFactorUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasFactorUnit">
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a derived unit to one of its constituent factor units</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>hasFactorUnit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasPrefixUnit -->


    <rdf:Description rdf:about="http://qudt.org/schema/qudt/hasPrefixUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasDefinedUnit"/>
    </rdf:Description>
    


    <!-- http://qudt.org/schema/qudt/hasQuantityKind -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasQuantityKind">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has quantity kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasReciprocalUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasReciprocalUnit">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <terms:description>Used to relate a unit to its reciprocal unit.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has reciprocal unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasReferenceQuantityKind -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasReferenceQuantityKind">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has reference quantity kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasRule -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasRule">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Rule"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has rule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasUnit -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasUnit">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;This property relates a factor unit to its unit or system of units with a unit of measure that is either:
  &lt;/p&gt;
  &lt;dl&gt;
  &lt;dd&gt;a) defined by the system,&lt;/dd&gt;
  &lt;dd&gt;b) accepted for use by the system and is convertible to a unit of equivalent dimension that is defined by the system,&lt;/dd&gt;
  &lt;dd&gt;c) a reference to the unit of measure of a quantity (variable or constant) of interest.&lt;/dd&gt;
  &lt;/dl&gt;
  &lt;p&gt;Systems of units may distinguish between base and derived units.
  Base units are the units which measure the base quantities for the corresponding system of quantities. 
  The base units are used to define units for all other quantities as products of powers of the base units. 
  Such units are called derived units for the system. 
  &lt;/p&gt;</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasUnitSystem -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasUnitSystem">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has unit system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/isUnitOfSystem -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/isUnitOfSystem">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <terms:description>
  This property relates a unit of measure with a system of units that either a) defines the unit
   or b) allows the unit to be used within the system.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>is unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/permissibleMaths -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/permissibleMaths">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/MathsFunctionType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>permissible maths</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/permissibleTransformation -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/permissibleTransformation">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/TransformType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>permissible transformation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/prefix -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/prefix">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Prefix"/>
        <terms:description>Associates a unit with the appropriate prefix, if any.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>prefix</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/qkdvDenominator -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/qkdvDenominator">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKindDimensionVector"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>denominator dimension vector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/qkdvNumerator -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/qkdvNumerator">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKindDimensionVector"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>numerator dimension vector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/quantity -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/quantity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Quantity"/>
        <terms:description>a property to relate an observable thing with a quantity (qud:Quantity)</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>quantity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/quantityValue -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/quantityValue">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>quantity value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/rationale -->


    <rdf:Description rdf:about="http://qudt.org/schema/qudt/rationale">
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"/>
    </rdf:Description>
    


    <!-- http://qudt.org/schema/qudt/ruleType -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/ruleType">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/RuleType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>rule type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/scaleType -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/scaleType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/ScaleType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>scale type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/scalingOf -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/scalingOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a unit that is scaled to the base unit that its qudt:conversionMultiplier converts it to</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>scalingOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/systemDerivedQuantityKind -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/systemDerivedQuantityKind">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasQuantityKind"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>system derived quantity kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/unitFor -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/unitFor">
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/hasUnit"/>
        <rdfs:domain rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>unit for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/valueQuantity -->


    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/valueQuantity">
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/quantityValue"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>value for quantity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.linkedmodel.org/schema/dtype#value -->


    <owl:ObjectProperty rdf:about="http://www.linkedmodel.org/schema/dtype#value">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/actsOnProperty -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/actsOnProperty">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isActedOnBy"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ActuatableProperty"/>
        <rdfs:comment xml:lang="en">Relation between an Actuation and the property of a FeatureOfInterest it is acting upon.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">acts on property</rdfs:label>
        <skos:definition xml:lang="en">Relation between an Actuation and the property of a FeatureOfInterest it is acting upon.</skos:definition>
        <skos:example xml:lang="en">In the activity (Actuation) of automatically closing a window if the temperature in a room drops below 20 degrees Celsius, the property on which the Actuator acts upon is the state of the window as it changes from being open to being closed. </skos:example>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasFeatureOfInterest -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isFeatureOfInterestOf"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:comment xml:lang="en">A relation between an Observation and the entity whose quality was observed, or between an Actuation and the entity whose property was modified, or between an act of Sampling and the entity that was sampled.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">has feature of interest</rdfs:label>
        <skos:definition xml:lang="en">A relation between an Observation and the entity whose quality was observed, or between an Actuation and the entity whose property was modified, or between an act of Sampling and the entity that was sampled.</skos:definition>
        <skos:example xml:lang="en">For example, in an Observation of the weight of a person, the FeatureOfInterest is the person and the property is its weight.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasResult -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasResult">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isResultOf"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Result"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:comment xml:lang="en">Relation linking an Observation or Actuation or act of Sampling and a Result or Sample.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">has result</rdfs:label>
        <skos:definition xml:lang="en">Relation linking an Observation or Actuation or act of Sampling and a Result or Sample.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasSample -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasSample">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isSampleOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:comment xml:lang="en">Relation between a FeatureOfInterest and the Sample used to represent it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">has sample</rdfs:label>
        <skos:definition xml:lang="en">Relation between a FeatureOfInterest and the Sample used to represent it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hosts -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hosts">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isHostedBy"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.w3.org/ns/ssn/inDeployment"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/ssn/deployedSystem"/>
        </owl:propertyChainAxiom>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampler"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">Relation between a Platform and a Sensor, Actuator, Sampler, or Platform, hosted or mounted on it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">hosts</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Platform and a Sensor, Actuator, Sampler, or Platform, hosted or mounted on it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isActedOnBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isActedOnBy">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ActuatableProperty"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <rdfs:comment xml:lang="en">Relation between an ActuatableProperty of a FeatureOfInterest and an Actuation changing its state.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">is acted on by</rdfs:label>
        <skos:definition xml:lang="en">Relation between an ActuatableProperty of a FeatureOfInterest and an Actuation changing its state.</skos:definition>
        <skos:example xml:lang="en">In the activity (Actuation) of automatically closing a window if the temperature in a room drops below 20 degrees Celsius, the property on which the Actuator acts upon is the state of the window as it changes from being open to being closed. </skos:example>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isFeatureOfInterestOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isFeatureOfInterestOf">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <rdfs:comment xml:lang="en">A relation between a FeatureOfInterest and an Observation about it, an Actuation acting on it, or an act of Sampling that sampled it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">is feature of interest of</rdfs:label>
        <skos:definition xml:lang="en">A relation between a FeatureOfInterest and an Observation about it, an Actuation acting on it, or an act of Sampling that sampled it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isHostedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isHostedBy">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampler"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:comment xml:lang="en">Relation between a Sensor, Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">is hosted by</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Sensor, Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isObservedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isObservedBy">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/observes"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">Relation between an ObservableProperty and the Sensor able to observe it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">is observed by</rdfs:label>
        <skos:definition xml:lang="en">Relation between an ObservableProperty and the Sensor able to observe it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isResultOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isResultOf">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Result"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <rdfs:comment xml:lang="en">Relation linking a Result to the Observation or Actuation or act of Sampling that created or caused it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">is result of</rdfs:label>
        <skos:definition xml:lang="en">Relation linking a Result to the Observation or Actuation or act of Sampling that created or caused it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isSampleOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isSampleOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="en">Relation from a Sample to the FeatureOfInterest that it is intended to be representative of.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">is sample of</rdfs:label>
        <skos:definition xml:lang="en">Relation from a Sample to the FeatureOfInterest that it is intended to be representative of.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeActuation -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeActuation">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/madeByActuator"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <rdfs:comment xml:lang="en">Relation between an Actuator and the Actuation it has made.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">made actuation</rdfs:label>
        <skos:definition xml:lang="en">Relation between an Actuator and the Actuation it has made.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeByActuator -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeByActuator">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
        <rdfs:comment xml:lang="en">Relation linking an Actuation to the Actuator that made that Actuation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">made by actuator</rdfs:label>
        <skos:definition xml:lang="en">Relation linking an Actuation to the Actuator that made that Actuation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeBySampler -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySampler">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/madeSampling"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampler"/>
        <rdfs:comment xml:lang="en">Relation linking an act of Sampling to the Sampler (sampling device or entity) that made it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">made by sampler</rdfs:label>
        <skos:definition xml:lang="en">Relation linking an act of Sampling to the Sampler (sampling device or entity) that made it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeBySensor -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/madeObservation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">Relation between an Observation and the Sensor which made the Observation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">made by sensor</rdfs:label>
        <skos:definition xml:lang="en">Relation between an Observation and the Sensor which made the Observation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeObservation -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeObservation">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment xml:lang="en">Relation between a Sensor and an Observation made by the Sensor.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">made observation</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Sensor and an Observation made by the Sensor.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeSampling -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeSampling">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampler"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <rdfs:comment xml:lang="en">Relation between a Sampler (sampling device or entity) and the Sampling act it performed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">made sampling</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Sampler (sampling device or entity) and the Sampling act it performed.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/observedProperty -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observedProperty">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">Relation linking an Observation to the property that was observed. The ObservableProperty should be a property of the FeatureOfInterest (linked by hasFeatureOfInterest) of this Observation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">observed property</rdfs:label>
        <skos:definition xml:lang="en">Relation linking an Observation to the property that was observed. The ObservableProperty should be a property of the FeatureOfInterest (linked by hasFeatureOfInterest) of this Observation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/observes -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observes">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/ssn/forProperty"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">Relation between a Sensor and an ObservableProperty that it is capable of sensing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">observes</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Sensor and an ObservableProperty that it is capable of sensing.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/phenomenonTime -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/phenomenonTime">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:comment xml:lang="en">The time that the Result of an Observation, Actuation or Sampling applies to the FeatureOfInterest. Not necessarily the same as the resultTime. May be an Interval or an Instant, or some other compound TemporalEntity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">phenomenon time</rdfs:label>
        <skos:definition xml:lang="en">The time that the Result of an Observation, Actuation or Sampling applies to the FeatureOfInterest. Not necessarily the same as the resultTime. May be an Interval or an Instant, or some other compound TemporalEntity.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/usedProcedure -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/usedProcedure">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeByActuator"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/ssn/implements"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySampler"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/ssn/implements"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySensor"/>
            <rdf:Description rdf:about="http://www.w3.org/ns/ssn/implements"/>
        </owl:propertyChainAxiom>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
        <rdfs:comment xml:lang="en">A relation to link to a re-usable Procedure used in making an Observation, an Actuation, or a Sample, typically through a Sensor, Actuator or Sampler.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">used procedure</rdfs:label>
        <skos:definition xml:lang="en">A relation to link to a re-usable Procedure used in making an Observation, an Actuation, or a Sample, typically through a Sensor, Actuator or Sampler.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/deployedOnPlatform -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/deployedOnPlatform">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/ssn/inDeployment"/>
        <rdfs:comment xml:lang="en">Relation between a Deployment and the Platform on which the Systems are deployed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">deployed on platform</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Deployment and the Platform on which the Systems are deployed.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/deployedSystem -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/deployedSystem">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/ssn/hasDeployment"/>
        <rdfs:comment xml:lang="en">Relation between a Deployment and a deployed System.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">deployed system</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Deployment and a deployed System.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/detects -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/detects">
        <rdfs:comment xml:lang="en">A relation from a Sensor to the Stimulus that the Sensor detects. The Stimulus itself will be serving as a proxy for some ObservableProperty.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">detects</rdfs:label>
        <skos:definition xml:lang="en">A relation from a Sensor to the Stimulus that the Sensor detects. The Stimulus itself will be serving as a proxy for some ObservableProperty.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/forProperty -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/forProperty">
        <rdfs:comment xml:lang="en">A relation between some aspect of an entity and a Property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">for property</rdfs:label>
        <skos:definition xml:lang="en">A relation between some aspect of an entity and a Property.</skos:definition>
        <skos:example xml:lang="en">For example, from a Sensor to the properties it can observe; from an Actuator to the properties it can act on; from a Deployment to the properties it was installed to observe or act on; from a SystemCapability to the Property the capability is described for.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/hasDeployment -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/hasDeployment">
        <rdfs:comment xml:lang="en">Relation between a System and a Deployment, recording that the System is deployed in that Deployment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">has deployment</rdfs:label>
        <skos:definition xml:lang="en">Relation between a System and a Deployment, recording that the System is deployed in that Deployment.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/hasInput -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/hasInput">
        <rdfs:comment xml:lang="en">Relation between a Procedure and an Input to it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">has input</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Procedure and an Input to it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/hasOutput -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/hasOutput">
        <rdfs:comment xml:lang="en">Relation between a Procedure and an Output of it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">has output</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Procedure and an Output of it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/hasProperty -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/hasProperty">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/ssn/isPropertyOf"/>
        <rdfs:comment xml:lang="en">Relation between an entity and a Property of that entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">has property</rdfs:label>
        <skos:definition xml:lang="en">Relation between an entity and a Property of that entity.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/hasSubSystem -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/hasSubSystem">
        <rdfs:comment xml:lang="en">Relation between a System and its component parts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">has subsystem</rdfs:label>
        <skos:definition xml:lang="en">Relation between a System and its component parts.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/implementedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/implementedBy">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/ssn/implements"/>
        <rdfs:comment xml:lang="en">Relation between a Procedure (an algorithm, procedure or method) and an entity that implements that Procedure in some executable way.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">implemented by</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Procedure (an algorithm, procedure or method) and an entity that implements that Procedure in some executable way.</skos:definition>
        <skos:example xml:lang="en">For example, the relationship between a scientific measuring Procedure and a sensor that senses via that Procedure.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/implements -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/implements">
        <rdfs:comment xml:lang="en">Relation between an entity that implements a Procedure in some executable way and the Procedure (an algorithm, procedure or method).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">implements</rdfs:label>
        <skos:definition xml:lang="en">Relation between an entity that implements a Procedure in some executable way and the Procedure (an algorithm, procedure or method).</skos:definition>
        <skos:example xml:lang="en">For example, the relationship between a sensor and the scientific measuring Procedure via which it senses.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/inDeployment -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/inDeployment">
        <rdfs:comment xml:lang="en">Relation between a Platform and a Deployment, meaning that the deployedSystems of the Deployment are hosted on the Platform.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">in deployment</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Platform and a Deployment, meaning that the deployedSystems of the Deployment are hosted on the Platform.</skos:definition>
        <skos:example xml:lang="en">For example, a relation between a buoy and a deployment of several Sensors.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/isPropertyOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/isPropertyOf">
        <rdfs:comment xml:lang="en">Relation between a Property and the entity it belongs to.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">is property of</rdfs:label>
        <skos:definition xml:lang="en">Relation between a Property and the entity it belongs to.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/isProxyFor -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/isProxyFor">
        <rdfs:comment xml:lang="en">A relation from a Stimulus to the Property that the Stimulus is serving as a proxy for.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">is proxy for</rdfs:label>
        <skos:definition xml:lang="en">A relation from a Stimulus to the Property that the Stimulus is serving as a proxy for.</skos:definition>
        <skos:example xml:lang="en">For example, the expansion of quicksilver is a stimulus that serves as a proxy for some temperature property. An increase or decrease in the velocity of spinning cups on a wind sensor is serving as a proxy for the wind speed.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/wasOriginatedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/wasOriginatedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment xml:lang="en">Relation between an Observation and the Stimulus that originated it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/ssn/"/>
        <rdfs:label xml:lang="en">was originated by</rdfs:label>
        <skos:definition xml:lang="en">Relation between an Observation and the Stimulus that originated it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://www.w3.org/2019/wot/mqtt#hasPayload -->


    <owl:ObjectProperty rdf:about="https://www.w3.org/2019/wot/mqtt#hasPayload">
        <owl:equivalentProperty rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasPayload"/>
    </owl:ObjectProperty>
    


    <!-- https://www.w3.org/2019/wot/mqtt#hasTopicFilters -->


    <owl:ObjectProperty rdf:about="https://www.w3.org/2019/wot/mqtt#hasTopicFilters">
        <owl:equivalentProperty rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasTopicFilter"/>
    </owl:ObjectProperty>
    


    <!-- https://www.w3.org/2019/wot/mqtt#hasTopicName -->


    <owl:ObjectProperty rdf:about="https://www.w3.org/2019/wot/mqtt#hasTopicName">
        <owl:equivalentProperty rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasTopicName"/>
    </owl:ObjectProperty>
    


    <!-- https://www.w3.org/2019/wot/mqtt#sendsControlPacket -->


    <owl:ObjectProperty rdf:about="https://www.w3.org/2019/wot/mqtt#sendsControlPacket">
        <owl:equivalentProperty rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#sendsControlPacket"/>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesActivity -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesActivity">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage"/>
        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Activity"/>
        <rdfs:comment xml:lang="en">Indicates that the Application Message encodes a SOSA Activity (Observation, ObservationCollection, Actuation, ActuationCollection) command.</rdfs:comment>
        <rdfs:label xml:lang="en">Application Message encodes Activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesActuation -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesActuation">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesActivity"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <rdfs:comment xml:lang="en">Indicates that the Application Message encodes a single SOSA Actuation command.</rdfs:comment>
        <rdfs:label xml:lang="en">Application Message encodes SOSA Actuation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesActuationCollection -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesActuationCollection">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesActivity"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/ActuationCollection"/>
        <rdfs:comment xml:lang="en">Indicates that the Application Message encodes a collection of actuation commands.</rdfs:comment>
        <rdfs:label xml:lang="en">Application Message encodes SOSA Actuation Collection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesObservation -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesObservation">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesActivity"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment xml:lang="en">Indicates that the Application Message encodes a SOSA Observation.</rdfs:comment>
        <rdfs:label xml:lang="en">Application Message encodes SOSA Observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesObservationCollection -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesObservationCollection">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#applicationMessageEncodesActivity"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <rdfs:comment xml:lang="en">Indicates that the Application Message encodes a collection of SOSA Observations.</rdfs:comment>
        <rdfs:label xml:lang="en">Application Message encodes SOSA Observation Collection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#establishedByNetworkConnection -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#establishedByNetworkConnection">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#establishesSession"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkSession"/>
        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkConnection"/>
        <rdfs:comment>A Network Session is established by a Network Connection.</rdfs:comment>
        <rdfs:label xml:lang="en">established By MQTT Network Connection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#establishesSession -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#establishesSession">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkConnection"/>
        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkSession"/>
        <rdfs:comment xml:lang="en">A Network Connection establishes a Network Session.</rdfs:comment>
        <rdfs:label xml:lang="en">establishes Network Session</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasActObsSubject -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasActObsSubject">
