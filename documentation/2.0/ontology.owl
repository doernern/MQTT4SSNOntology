    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person"/>
    


    <!-- https://www.w3.org/2019/wot/mqtt#Client -->


    <owl:Class rdf:about="https://www.w3.org/2019/wot/mqtt#Client">
        <owl:equivalentClass rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Client"/>
    </owl:Class>
    


    <!-- https://www.w3.org/2019/wot/mqtt#ControlPacket -->


    <owl:Class rdf:about="https://www.w3.org/2019/wot/mqtt#ControlPacket">
        <owl:equivalentClass rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket"/>
    </owl:Class>
    


    <!-- https://www.w3.org/2019/wot/mqtt#NetworkConnection -->


    <owl:Class rdf:about="https://www.w3.org/2019/wot/mqtt#NetworkConnection">
        <owl:equivalentClass rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkConnection"/>
    </owl:Class>
    


    <!-- https://www.w3.org/2019/wot/mqtt#PUBLISH -->


    <owl:Class rdf:about="https://www.w3.org/2019/wot/mqtt#PUBLISH">
        <owl:equivalentClass rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#PublishPacket"/>
    </owl:Class>
    


    <!-- https://www.w3.org/2019/wot/mqtt#SUBSCRIBE -->


    <owl:Class rdf:about="https://www.w3.org/2019/wot/mqtt#SUBSCRIBE">
        <owl:equivalentClass rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#SubscribePacket"/>
    </owl:Class>
    


    <!-- https://www.w3.org/2019/wot/mqtt#Server -->


    <owl:Class rdf:about="https://www.w3.org/2019/wot/mqtt#Server">
        <owl:equivalentClass rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Broker"/>
    </owl:Class>
    


    <!-- https://www.w3.org/2019/wot/mqtt#TopicFilter -->


    <owl:Class rdf:about="https://www.w3.org/2019/wot/mqtt#TopicFilter">
        <owl:equivalentClass rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#TopicFilter"/>
    </owl:Class>
    


    <!-- https://www.w3.org/2019/wot/mqtt#TopicName -->


    <owl:Class rdf:about="https://www.w3.org/2019/wot/mqtt#TopicName">
        <owl:equivalentClass rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Topic"/>
    </owl:Class>
    


    <!-- https://www.w3.org/2019/wot/mqtt#UNSUBSCRIBE -->


    <owl:Class rdf:about="https://www.w3.org/2019/wot/mqtt#UNSUBSCRIBE">
        <owl:equivalentClass rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribePacket"/>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#Activity -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#Activity">
        <rdfs:comment xml:lang="en">An Generalisation of SOSA Observation, ObservationCollection, Actuation, ActuationCollection.</rdfs:comment>
        <rdfs:label xml:lang="en">SOSA Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage">
        <rdfs:comment xml:lang="en">Protocol independent Application Message description</rdfs:comment>
        <rdfs:label xml:lang="en">Application Message</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#AuthFixedHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#AuthFixedHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader"/>
        <rdfs:comment xml:lang="en">The Fixed Header of an AUTH packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT AUTH Fixed Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#AuthPacket -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#AuthPacket">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket"/>
        <rdfs:comment xml:lang="en">An MQTT Control Packet used to perform extended authentication exchanges between Client and Server.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT AUTH Packet</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#AuthProperties -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#AuthProperties">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Properties"/>
        <rdfs:comment xml:lang="en">Properties section of the AUTH packet variable header in MQTT 5.0 for Enhanced Authentication (e.g., Authentication Method, Authentication Data, Reason String, User Properties).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Auth Properties</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#AuthVariableHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#AuthVariableHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader"/>
        <rdfs:comment xml:lang="en">The Variable Header of an AUTH packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT AUTH Variable Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#Broker -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#Broker">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkParticipant"/>
        <rdfs:comment xml:lang="en">An MQTT Broker that accepts client connections, manages subscriptions, and forwards published messages.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Broker</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#Client -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#Client">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkParticipant"/>
        <rdfs:comment xml:lang="en">An MQTT Client that connects to an MQTT Broker and publishes or subscribes to MQTT Topics; may host SOSA systems.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Client</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ConnackFixedHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackFixedHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader"/>
        <rdfs:comment xml:lang="en">The Fixed Header of an CONNACK packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT CONNACK Fixed Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ConnackPacket -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackPacket">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket"/>
        <rdfs:comment xml:lang="en">An MQTT Control Packet sent by the Server in response to a CONNECT Packet, indicating the result of the connection attempt.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT CONNACK Packet</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Properties"/>
        <rdfs:comment xml:lang="en">Properties section of the CONNACK packet variable header in MQTT 5.0 (e.g., Session Expiry Interval, Receive Maximum, Maximum QoS, Retain Available, Assigned Client Identifier, Server Keep Alive, Response Information, Server Reference, capability flags, User Properties).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Connack Properties</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ConnackVariableHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackVariableHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader"/>
        <rdfs:comment xml:lang="en">The Variable Header of an CONNACK packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT CONNACK Variable Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ConnectFixedHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectFixedHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader"/>
        <rdfs:comment xml:lang="en">The Fixed Header of an CONNECT packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT CONNECT Fixed Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ConnectPacket -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectPacket">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket"/>
        <rdfs:comment xml:lang="en">An MQTT Control Packet sent by a Client to establish a connection to an MQTT Server.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT CONNECT Packet</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ConnectPayload -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectPayload">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Payload"/>
        <rdfs:comment xml:lang="en">CONNECT packet payload in MQTT 5.0. Contains Client Identifier, Will Properties/Topic/Payload (if Will Flag=1), User Name (if User Name Flag=1), and Password (if Password Flag=1).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT CONNECT Payload</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Properties"/>
        <rdfs:comment xml:lang="en">Properties section of the CONNECT packet variable header in MQTT 5.0 (e.g., Session Expiry Interval, Receive Maximum, Maximum Packet Size, Authentication Method/Data, Request Problem/Response Information, User Properties).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Connect Properties</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader"/>
        <rdfs:comment xml:lang="en">The Variable Header of an CONNECT packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT CONNECT Variable Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket">
