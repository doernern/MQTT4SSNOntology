    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/uneceCommonCode -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/uneceCommonCode">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/url -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/url">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>url</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/vectorMagnitude -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/vectorMagnitude">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>vector magnitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://qudt.org/schema/qudt/width -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt/width">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.linkedmodel.org/schema/dtype#literal -->


    <owl:DatatypeProperty rdf:about="http://www.linkedmodel.org/schema/dtype#literal">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasSimpleResult -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/hasSimpleResult">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <rdfs:comment xml:lang="en">The simple value of an Observation or Actuation or act of Sampling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">has simple result</rdfs:label>
        <skos:definition xml:lang="en">The simple value of an Observation or Actuation or act of Sampling.</skos:definition>
        <skos:example xml:lang="en">For instance, the values 23 or true.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/sosa/resultTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/resultTime">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <rdfs:comment xml:lang="en">The result time is the instant of time when the Observation, Actuation or Sampling activity was completed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">result time</rdfs:label>
        <skos:definition xml:lang="en">The result time is the instant of time when the Observation, Actuation or Sampling activity was completed.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3.org/2019/wot/mqtt#hasDUPFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3.org/2019/wot/mqtt#hasDUPFlag">
        <owl:equivalentProperty rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasDUPFlag"/>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3.org/2019/wot/mqtt#hasRetainFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3.org/2019/wot/mqtt#hasRetainFlag">
        <owl:equivalentProperty rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasRetainFlag"/>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasAssignedClientIdentifier -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasAssignedClientIdentifier">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Assigned Client Identifier Property. UTF-8 string assigned by the Server when the Client did not provide one.</rdfs:comment>
        <rdfs:label xml:lang="en">has Assigned Client Identifier</rdfs:label>
        <skos:example xml:lang="en">If the Client connects using a zero length Client Identifier, the Server MUST respond with a CONNACK containing an Assigned Client Identifier. The Assigned Client Identifier MUST be a new Client Identifier not used by any other Session currently in the Server.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasAuthReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasAuthReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeaderReasonCode"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#AuthVariableHeader"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">AUTH Reason Code. One-byte value indicating enhanced-auth result or continuation status.</rdfs:comment>
        <rdfs:label xml:lang="en">has Auth Reason Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasAuthentificationData -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasAuthentificationData">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#AuthProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#base64Binary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">has Authentification Data</rdfs:label>
        <skos:example xml:lang="en">Authentication Data Property. Binary Data for enhanced authentication.</skos:example>
        <skos:note xml:lang="en">The contents of this data are defined by the authentication method.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasAuthentificationMethod -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasAuthentificationMethod">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#AuthProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Authentication Method Property. UTF-8 string naming the enhanced-auth method.</rdfs:comment>
        <rdfs:label xml:lang="en">has Authentification Method</rdfs:label>
        <skos:example xml:lang="en">ollowed by a UTF-8 Encoded String containing the name of the authentication method. It is a Protocol Error to omit the Authentication Method or to include it more than once.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasCleanStart -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasCleanStart">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasConnectFlag"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Clean Start flag in CONNECT Flags. 1 requests a new Session; 0 continues an existing Session if present.</rdfs:comment>
        <rdfs:label xml:lang="en">has Clean Start</rdfs:label>
        <skos:example xml:lang="en">If a CONNECT packet is received with Clean Start is set to 1, the Client and Server MUST discard any existing Session and start a new Session.</skos:example>
        <skos:example xml:lang="en">If a CONNECT packet is received with Clean Start set to 0 and there is a Session associated with the Client Identifier, the Server MUST resume communications with the Client based on state from the existing Session.</skos:example>
        <skos:example xml:lang="en">If a CONNECT packet is received with Clean Start set to 0 and there is no Session associated with the Client Identifier, the Server MUST create a new Session.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasClientID -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasClientID">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Client"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The MQTT Client identifier used when connecting to an MQTT Broker.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Client identifier</rdfs:label>
        <skos:example xml:lang="en">The ClientID MUST be a UTF-8 Encoded String.</skos:example>
        <skos:example xml:lang="en">The ClientID MUST be used by Clients and by Servers to identify state that they hold relating to this MQTT Session between the Client and the Server.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasConnackFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasConnackFlag">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">CONNACK Acknowledge Flags byte. In MQTT 5.0 only Session Present (bit 0) is used; other bits are reserved.</rdfs:comment>
        <rdfs:label xml:lang="en">has Connack Flag</rdfs:label>
        <skos:example xml:lang="en">Byte 1 is the &quot;Connect Acknowledge Flags&quot;. Bits 7-1 are reserved and MUST be set to 0.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasConnackReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasConnackReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeaderReasonCode"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackVariableHeader"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">CONNACK Reason Code. One-byte value indicating the result of a CONNECT request.</rdfs:comment>
        <rdfs:label xml:lang="en">has Connack Reason Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasConnectFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasConnectFlag">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
        <rdfs:comment xml:lang="en">CONNECT Flags byte encoding User Name/Password/Will/Clean Start fields; reserved bit MUST be 0.</rdfs:comment>
        <rdfs:label xml:lang="en">has Connect Flags</rdfs:label>
        <skos:example xml:lang="en">Bit 0 = Reserved; Bit 1 = Clean Start; Bit 2 = Will Flag; Bit 3 und 4 = Will QoS; Bit 5 = Will Retain; Bit 6 = Password Flag; Bit 7 = User Name Flag.</skos:example>
        <skos:example xml:lang="en">The Server MUST validate that the reserved flag in the CONNECT packet is set to 0.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasContentType -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasContentType">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasWillProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PublishProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#WillProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Application Message content type</rdfs:comment>
        <rdfs:label xml:lang="en">has Content Type</rdfs:label>
        <skos:example xml:lang="en">3 (0x03) Byte, Identifier of the Content Type. Followed by a UTF-8 Encoded String describing the content of the Will Message. It is a Protocol Error to include the Content Type more than once. The value of the Content Type is defined by the sending and receiving application.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasControlPacketType -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasControlPacketType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">4 bits Control Packet Type or literal of the MQTT Fixed Header, indicating the type of MQTT Control Packet (e.g., CONNECT, PUBLISH, SUBSCRIBE).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Control Packet Type</rdfs:label>
        <skos:example xml:lang="en">Reserved (0): Forbidden — Reserved
CONNECT (1): Client to Server — Connection request
CONNACK (2): Server to Client — Connect acknowledgment
PUBLISH (3): Client to Server or Server to Client — Publish message
PUBACK (4): Client to Server or Server to Client — Publish acknowledgment (QoS 1)
PUBREC (5): Client to Server or Server to Client — Publish received (QoS 2 delivery part 1)
PUBREL (6): Client to Server or Server to Client — Publish release (QoS 2 delivery part 2)
PUBCOMP (7): Client to Server or Server to Client — Publish complete (QoS 2 delivery part 3)
SUBSCRIBE (8): Client to Server — Subscribe request
SUBACK (9): Server to Client — Subscribe acknowledgment
UNSUBSCRIBE (10): Client to Server — Unsubscribe request
UNSUBACK (11): Server to Client — Unsubscribe acknowledgment
PINGREQ (12): Client to Server — PING request
PINGRESP (13): Server to Client — PING response
DISCONNECT (14): Client to Server or Server to Client — Disconnect notification
AUTH (15): Client to Server or Server to Client — Authentication exchange</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasCorrelationData -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasCorrelationData">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasWillProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PublishProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#WillProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#base64Binary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Correlation Data Property. Binary Data used to correlate requests and responses.</rdfs:comment>
        <rdfs:label xml:lang="en">has Correlation Data</rdfs:label>
        <skos:example xml:lang="en">9 (0x09) Byte, Identifier of the Correlation Data. Followed by Binary Data. The Correlation Data is used by the sender of the Request Message to identify which request the Response Message refers to when it is received. It is a Protocol Error to include Correlation Data more than once. If the Correlation Data is not present, the requester does not require any correlation data.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasDUPFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasDUPFlag">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasFixedHeaderFlag"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#PublishFixedHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if this is a duplicate delivery of an earlier PUBLISH message.</rdfs:comment>
        <rdfs:label xml:lang="en">DUP flag</rdfs:label>
        <skos:example xml:lang="en">The DUP flag MUST be set to 0 for all QoS 0 messages.</skos:example>
        <skos:example xml:lang="en">The DUP flag MUST be set to 1 by the Client or Server when it attempts to re-deliver a PUBLISH packet.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasDisconnectReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasDisconnectReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeaderReasonCode"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#DisconnectVariableHeader"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">DISCONNECT Reason Code. One-byte value indicating the reason for disconnection.</rdfs:comment>
        <rdfs:label xml:lang="en">has Dissconnect Reason Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasFilterPattern -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasFilterPattern">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#TopicFilter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The MQTT Topic Filter pattern as a string (e.g., &apos;sensor/+/temp&apos; or &apos;fabrik/zentrierung/#&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Topic Filter pattern</rdfs:label>
        <skos:example xml:lang="en">An MQTT topic filter used in subscriptions to match topic names. A filter pattern may include the single-level wildcard &apos;+&apos; and the multi-level wildcard &apos;#&apos;.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasFixedHeaderFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasFixedHeaderFlag">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#PublishFixedHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
        <rdfs:comment xml:lang="en">Fixed Header flags nibble (bits 3..0 of byte 1). Packet-type-specific reserved/required flag pattern in MQTT 5.0.</rdfs:comment>
        <rdfs:label xml:lang="en">FixedHeader flag</rdfs:label>
        <skos:example xml:lang="en">Where a flag bit is marked as “Reserved”, it is reserved for future use and MUST be set to the value listed.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasHostAddress -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasHostAddress">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Broker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The hostname or IP address of an MQTT Broker.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Broker host</rdfs:label>
        <skos:example xml:lang="en">Examples: localhost, 127.0.0.1, mqtt.example.com, 192.168.0.10</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasKeepAlive -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasKeepAlive">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <rdfs:comment xml:lang="en">Keep Alive in CONNECT variable header. Two Byte Integer seconds defining maximum time between Client Control Packets.</rdfs:comment>
        <rdfs:label>has Keep Alive</rdfs:label>
        <skos:example xml:lang="en">If Keep Alive is non-zero and in the absence of sending any other MQTT Control Packets, the Client MUST send a PINGREQ packet.</skos:example>
        <skos:example xml:lang="en">If the Keep Alive value is non-zero and the Server does not receive an MQTT Control Packet from the Client within one and a half times the Keep Alive time period, it MUST close the Network Connection to the Client as if the network had failed.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasMaximumPacketSize -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasMaximumPacketSize">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
        <rdfs:comment xml:lang="en">Maximum Packet Size Property. Four Byte Integer (non-zero) limiting maximum MQTT packet size accepted.</rdfs:comment>
        <rdfs:label xml:lang="en">has Maximum Packet Size</rdfs:label>
        <skos:example xml:lang="en">39 (0x27) Byte, Identifier of the Maximum Packet Size. Followed by a Four Byte Integer representing the Maximum Packet Size the Client is willing to accept. If the Maximum Packet Size is not present, no limit on the packet size is imposed beyond the limitations in the protocol as a result of the remaining length encoding and the protocol header sizes.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasMaximumQoS -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasMaximumQoS">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
        <rdfs:comment xml:lang="en">Maximum QoS Property. Byte specifying the highest QoS level supported by the Server.</rdfs:comment>
        <rdfs:label xml:lang="en">has Maximum QoS</rdfs:label>
        <skos:example xml:lang="en">A Server that does not support QoS 1 or QoS 2 PUBLISH packets MUST still accept SUBSCRIBE packets containing a Requested QoS of 0, 1 or 2.</skos:example>
        <skos:example xml:lang="en">If a Client receives a Maximum QoS from a Server, it MUST NOT send PUBLISH packets at a QoS level exceeding the Maximum QoS level specified.</skos:example>
        <skos:example xml:lang="en">If a Server does not support QoS 1 or QoS 2 PUBLISH packets it MUST send a Maximum QoS in the CONNACK packet specifying the highest QoS it supports.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasMessageContent -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasMessageContent">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Application message content carried by PUBLISH. Conceptual higher-level view of the PUBLISH payload.</rdfs:comment>
        <rdfs:label xml:lang="en">has Application Message content</rdfs:label>
        <skos:example xml:lang="en">Example message content:
- container field: data
- encoding: UTF-8
- content type: text/csv
- delimiter: ;
- fields: RFID; JobStart; JobEnd; Correction_X; Correction_Y; Correction_Z; Sensor; Actuator

Example value:
RFID;JobStart;JobEnd;Correction_X;Correction_Y;Correction_Z;Sensor;Actuator
RFID_87A3F1;2025-12-03T09:15:02.120Z;2025-12-03T09:15:02.520Z;-0.44;-0.15;+0.10;Sensor1;Actuator1</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasMessageContentDelimiter -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasMessageContentDelimiter">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The delimiter used to separate fields in the Application Message content.</rdfs:comment>
        <rdfs:label xml:lang="en">Application Message content delimiter</rdfs:label>
        <skos:example xml:lang="en">;</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasMessageContentType -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasMessageContentType">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The MIME type of the Application Message content (e.g., &apos;application/json&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">has Message Content Type</rdfs:label>
        <skos:example xml:lang="en">The Content Type MUST be a UTF-8 Encoded String.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasMessageEncoding -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasMessageEncoding">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The character encoding or serialization used for the Application Message (e.g., &apos;UTF-8&apos;, &apos;Base64&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">Application Message encoding</rdfs:label>
        <skos:example xml:lang="en">A UTF-8 Encoded String MUST NOT include an encoding of the null character U+0000.</skos:example>
        <skos:example xml:lang="en">The character data in a UTF-8 Encoded String MUST be well-formed UTF-8 as defined by the Unicode specification [Unicode] and restated in RFC 3629 [RFC3629]. In particular, the character data MUST NOT include encodings of code points between U+D800 and U+DFFF.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasMessageExpiryInterval -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasMessageExpiryInterval">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasWillProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PublishProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#WillProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
        <rdfs:comment xml:lang="en">Message Expiry Interval Property. Four Byte Integer seconds defining PUBLISH message lifetime.</rdfs:comment>
        <rdfs:label xml:lang="en">has Message Expiry Interval</rdfs:label>
        <skos:example xml:lang="en">2 (0x02) Byte, Identifier of the Message Expiry Interval. Followed by the Four Byte Integer representing the Message Expiry Interval in seconds. If present, the Four Byte value is the lifetime of the Application Message in seconds. If absent, the Application Message does not expire.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasNoLocal -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasNoLocal">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionOption"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#SubscriptionEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Bit 2 of the Subscription Options represents the No Local option.</rdfs:comment>
        <rdfs:comment xml:lang="en">No Local subscription option. If 1, the Server MUST NOT forward messages published by this Client back to it.</rdfs:comment>
        <rdfs:label xml:lang="en">has No Local</rdfs:label>
        <skos:example xml:lang="en">If the value is 1, Application Messages MUST NOT be forwarded to a connection with a ClientID equal to the ClientID of the publishing connection.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPacketIdentifier -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPacketIdentifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubackVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubcompVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PublishVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrecVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrelVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubackVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubscribeVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeVariableHeader"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <rdfs:comment xml:lang="en">A 16-bit identifier used to correlate MQTT messages when QoS &gt; 0.</rdfs:comment>
        <rdfs:label xml:lang="en">packet identifier</rdfs:label>
        <skos:example xml:lang="en">A PUBLISH packet MUST NOT contain a Packet Identifier if its QoS value is set to 0.</skos:example>
        <skos:example xml:lang="en">Each time a Client sends a new SUBSCRIBE, UNSUBSCRIBE,or PUBLISH (where QoS &gt; 0) MQTT Control Packet it MUST assign it a non-zero Packet Identifier that is currently unused.</skos:example>
        <skos:example xml:lang="en">Each time a Server sends a new PUBLISH (with QoS &gt; 0) MQTT Control Packet it MUST assign it a non zero Packet Identifier that is currently unused.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPassword -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPassword">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectPayload"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#base64Binary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Password field in CONNECT payload. Binary Data present only if Password Flag=1.</rdfs:comment>
        <rdfs:label xml:lang="en">has Password</rdfs:label>
        <skos:example xml:lang="en">If the Password Flag is set to 0, a Password MUST NOT be present in the Payload.</skos:example>
        <skos:example xml:lang="en">If the Password Flag is set to 1, a Password MUST be present in the Payload.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPasswordFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPasswordFlag">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasConnectFlag"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Password Flag in CONNECT Flags. If 1, a Password field is present in the CONNECT payload.</rdfs:comment>
        <rdfs:label xml:lang="en">has Password Flag</rdfs:label>
        <skos:example xml:lang="en">If the Password Flag is set to 0, a Password MUST NOT be present in the Payload.</skos:example>
        <skos:example xml:lang="en">If the Password Flag is set to 1, a Password MUST be present in the Payload.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadContent -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#PublishPayload"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#base64Binary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Application Message Payload content (Binary Data; UTF-8 text if Payload Format Indicator=1).</rdfs:comment>
        <rdfs:label xml:lang="en">has Payload content</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadFormatIndicator -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadFormatIndicator">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasWillProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PublishProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#WillProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Payload Format Indicator Property. Byte 0/1; 1 means payload is UTF-8 encoded text, 0 means unspecified binary.</rdfs:comment>
        <rdfs:label xml:lang="en">has Payload Format Indicator</rdfs:label>
        <skos:example xml:lang="en">A Server MUST send the Payload Format Indicator unaltered to all subscribers receiving the Application Message.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasReasonCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubackPayload"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPayload"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Reason Code carried in a packet payload when defined by MQTT 5.0 (one-byte reason value).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Reason Code in Payload</rdfs:label>
        <skos:example xml:lang="en">MQTT 5 Reason Codes

0 / 0x00: Success — CONNACK, PUBACK, PUBREC, PUBREL, PUBCOMP, UNSUBACK, AUTH
0 / 0x00: Normal disconnection — DISCONNECT
0 / 0x00: Granted QoS 0 — SUBACK
1 / 0x01: Granted QoS 1 — SUBACK
2 / 0x02: Granted QoS 2 — SUBACK
4 / 0x04: Disconnect with Will Message — DISCONNECT
16 / 0x10: No matching subscribers — PUBACK, PUBREC
17 / 0x11: No subscription existed — UNSUBACK
24 / 0x18: Continue authentication — AUTH
25 / 0x19: Re-authenticate — AUTH
128 / 0x80: Unspecified error — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
129 / 0x81: Malformed Packet — CONNACK, DISCONNECT
130 / 0x82: Protocol Error — CONNACK, DISCONNECT
131 / 0x83: Implementation specific error — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
132 / 0x84: Unsupported Protocol Version — CONNACK
133 / 0x85: Client Identifier not valid — CONNACK
134 / 0x86: Bad User Name or Password — CONNACK
135 / 0x87: Not authorized — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
136 / 0x88: Server unavailable — CONNACK
137 / 0x89: Server busy — CONNACK, DISCONNECT
138 / 0x8A: Banned — CONNACK
139 / 0x8B: Server shutting down — DISCONNECT
140 / 0x8C: Bad authentication method — CONNACK, DISCONNECT
141 / 0x8D: Keep Alive timeout — DISCONNECT
142 / 0x8E: Session taken over — DISCONNECT
143 / 0x8F: Topic Filter invalid — SUBACK, UNSUBACK, DISCONNECT
144 / 0x90: Topic Name invalid — CONNACK, PUBACK, PUBREC, DISCONNECT
145 / 0x91: Packet Identifier in use — PUBACK, PUBREC, SUBACK, UNSUBACK
146 / 0x92: Packet Identifier not found — PUBREL, PUBCOMP
147 / 0x93: Receive Maximum exceeded — DISCONNECT
148 / 0x94: Topic Alias invalid — DISCONNECT
149 / 0x95: Packet too large — CONNACK, DISCONNECT
150 / 0x96: Message rate too high — DISCONNECT
151 / 0x97: Quota exceeded — CONNACK, PUBACK, PUBREC, SUBACK, DISCONNECT
152 / 0x98: Administrative action — DISCONNECT
153 / 0x99: Payload format invalid — CONNACK, PUBACK, PUBREC, DISCONNECT
154 / 0x9A: Retain not supported — CONNACK, DISCONNECT
155 / 0x9B: QoS not supported — CONNACK, DISCONNECT
156 / 0x9C: Use another server — CONNACK, DISCONNECT
157 / 0x9D: Server moved — CONNACK, DISCONNECT
158 / 0x9E: Shared Subscriptions not supported — SUBACK, DISCONNECT
159 / 0x9F: Connection rate exceeded — CONNACK, DISCONNECT
160 / 0xA0: Maximum connect time — DISCONNECT
161 / 0xA1: Subscription Identifiers not supported — SUBACK, DISCONNECT
162 / 0xA2: Wildcard Subscriptions not supported — SUBACK, DISCONNECT</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPortNumber -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPortNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Broker"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <rdfs:comment xml:lang="en">The TCP port on which an MQTT Broker listens.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Broker port</rdfs:label>
        <skos:example xml:lang="en">TCP ports 8883 and 1883 are registered with IANA for MQTT TLS and non-TLS communication respectively.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasProperty -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Properties"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Property identifier or property carrier for MQTT 5.0. Each Property begins with a one-byte Identifier followed by a typed value.</rdfs:comment>
        <rdfs:label xml:lang="en">has MQTT Property</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPropertyLength -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPropertyLength">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#Properties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#WillProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">Property Length field preceding a Properties collection. Variable Byte Integer giving total length in bytes of following properties.</rdfs:comment>
        <rdfs:comment xml:lang="en">The Property Length is encoded as a Variable Byte Integer. The Property Length does not include the bytes used to encode itself, but includes the length of the Properties. If there are no properties, this MUST be indicated by including a Property Length of zero.</rdfs:comment>
        <rdfs:label xml:lang="en">has MQTT Property Length</rdfs:label>
        <skos:example xml:lang="en">The length of Properties in the DISCONNECT packet Variable Header encoded as a Variable Byte Integer. If the Remaining Length is less than 2, a value of 0 is used.</skos:example>
        <skos:example xml:lang="en">The length of the Properties in the PUBACK packet Variable Header encoded as a Variable Byte Integer. If the Remaining Length is less than 4 there is no Property Length and the value of 0 is used.</skos:example>
        <skos:example xml:lang="en">The length of the Properties in the UNSUBACK packet Variable Header encoded as a Variable Byte Integer.</skos:example>
        <skos:example xml:lang="en">The length of the Properties in the Will Properties encoded as a Variable Byte Integer.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasProtocolName -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasProtocolName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Protocol Name in CONNECT. UTF-8 string that MUST equal &apos;MQTT&apos; for MQTT 5.0.</rdfs:comment>
        <rdfs:label xml:lang="en">has Protocol Name</rdfs:label>
        <skos:example xml:lang="en">The protocol name MUST be the UTF-8 String &quot;MQTT&quot;. If the Server does not want to accept the CONNECT, and wishes to reveal that it is an MQTT Server it MAY send a CONNACK packet with Reason Code of 0x84 (Unsupported Protocol Version), and then it MUST close the Network Connection.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasProtocolVersion -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasProtocolVersion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
        <rdfs:comment xml:lang="en">Protocol Version in CONNECT. One-byte value that MUST be 5 for MQTT 5.0.</rdfs:comment>
        <rdfs:label xml:lang="en">has Protocol Version</rdfs:label>
        <skos:example xml:lang="en">If the Protocol Version is not 5 and the Server does not want to accept the CONNECT packet, the Server MAY send a CONNACK packet with Reason Code 0x84 (Unsupported Protocol Version) and then MUST close the Network Connection.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPubackReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPubackReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeaderReasonCode"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#PubackVariableHeader"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">PUBACK Reason Code. One-byte value indicating result of QoS 1 PUBLISH processing.</rdfs:comment>
        <rdfs:label xml:lang="en">has Puback  Reason Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPubcompReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPubcompReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeaderReasonCode"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#PubcompVariableHeader"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">PUBCOMP Reason Code. One-byte value indicating completion of the QoS 2 flow.</rdfs:comment>
        <rdfs:label xml:lang="en">has Pubcomp Reason Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPubrecReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPubrecReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeaderReasonCode"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#PubrecVariableHeader"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">PUBREC Reason Code. One-byte value indicating result of QoS 2 PUBLISH receipt stage.</rdfs:comment>
        <rdfs:label xml:lang="en">has Pubrec Reason Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasPubrelReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasPubrelReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeaderReasonCode"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#PubrelVariableHeader"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">PUBREL Reason Code. One-byte value indicating result of QoS 2 release stage.</rdfs:comment>
        <rdfs:label xml:lang="en">has Pubrel Reason Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasQoSLevel -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasQoSLevel">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasFixedHeaderFlag"/>
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionOption"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PublishFixedHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubscriptionEntry"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Not mapped to mqv:hasQoSFlag because MQV models QoS as an object property, while mqtt:hasQosLevel is a datatype property.</rdfs:comment>
        <rdfs:comment xml:lang="en">The MQTT Quality of Service level (0 = at most once, 1 = at least once, 2 = exactly once).</rdfs:comment>
        <rdfs:label xml:lang="en">QoS level</rdfs:label>
        <skos:example xml:lang="en">MQTT QoS levels:
0 — At most once
1 — At least once
2 — Exactly once</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasReasonCode">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#AuthVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#DisconnectVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubackVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubcompVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrecVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrelVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubackPayload"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPayload"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">&quot;The CONNACK, PUBACK, PUBREC, PUBREL, PUBCOMP, DISCONNECT and AUTH Control Packets have a single Reason Code as part of the Variable Header. The SUBACK and UNSUBACK packets contain a list of one or more Reason Codes in the Payload.</rdfs:comment>
        <rdfs:comment xml:lang="en">A Reason Code is a one byte unsigned value that indicates the result of an operation. Reason Codes less than 0x80 indicate successful completion of an operation. The normal Reason Code for success is 0. Reason Code values of 0x80 or greater indicate failure.</rdfs:comment>
        <rdfs:comment xml:lang="en">Generic MQTT Reason Code. One-byte value indicating success or the reason for failure in many packet types.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT ReasonCode</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasReasonString -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasReasonString">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#AuthProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#DisconnectProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubcompProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrecProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrelProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Reason String Property. UTF-8 string providing human-readable diagnostics for a Reason Code.</rdfs:comment>
        <rdfs:label xml:lang="en">has Reason String</rdfs:label>
        <skos:example xml:lang="en">The sender MUST NOT send this property if it would increase the size of the PUBACK packet beyond the Maximum Packet Size specified by the receiver.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasReceiveMaximum -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasReceiveMaximum">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <rdfs:comment xml:lang="en">Receive Maximum Property. Two Byte Integer (non-zero) limiting concurrent QoS 1/2 PUBLISH in-flight.</rdfs:comment>
        <rdfs:label xml:lang="en">has Receive Maximum</rdfs:label>
        <skos:example xml:lang="en">33 (0x21) Byte, Identifier of the Receive Maximum. Followed by the Two Byte Integer representing the Receive Maximum value. It is a Protocol Error to include the Receive Maximum value more than once or for it to have the value 0.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasRemainingLength -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasRemainingLength">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#byte"/>
        <rdfs:comment xml:lang="en">The Remaining Length is a Variable Byte Integer that represents the number of bytes remaining within the current Control Packet, including data in the Variable Header and the Payload. The Remaining Length does not include the bytes used to encode the Remaining Length. The packet size is the total number of bytes in an MQTT Control Packet, this is equal to the length of the Fixed Header plus the Remaining Length.</rdfs:comment>
        <rdfs:comment xml:lang="en">This is the length of the Variable Header (plus the length of the Payload), encoded as a Variable Byte Integer.</rdfs:comment>
        <rdfs:label xml:lang="en">Remaining Length of MQTT Control Packet </rdfs:label>
        <skos:example xml:lang="en">PUBACK: This is the length of the Variable Header, encoded as a Variable Byte Integer.</skos:example>
        <skos:example xml:lang="en">PUBLISH: This is the length of Variable Header plus the length of the Payload, encoded as a Variable Byte Integer.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasRequestProblemInformation -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasRequestProblemInformation">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Request Problem Information Property in CONNECT. Byte 0/1 indicating whether the Server should include Reason String/User Properties on errors.</rdfs:comment>
        <rdfs:label xml:lang="en">has Request Problem Information</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasRequestResponseInformation -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasRequestResponseInformation">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Request Response Information Property in CONNECT. Byte 0/1 indicating whether the Server should return Response Information in CONNACK.</rdfs:comment>
        <rdfs:label xml:lang="en">has Request Response Information</rdfs:label>
        <skos:example xml:lang="en">A value of 0 indicates that the Server MUST NOT return Response Information.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasResponseInformation -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasResponseInformation">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Response Information Property. UTF-8 string providing response metadata for request/response patterns.</rdfs:comment>
        <rdfs:label xml:lang="en">has Response Information</rdfs:label>
        <skos:example xml:lang="en">25 (0x19) Byte, Identifier of the Request Response Information. Followed by a Byte with a value of either 0 or 1.  A value of 0 indicates that the Server MUST NOT return Response Information. If the value is 1 the Server MAY return Response Information in the CONNACK packet.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasRetainAsPublished -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasRetainAsPublished">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionOption"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#SubscriptionEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Retain As Published subscription option. If 1, forwarded messages keep the original RETAIN flag.</rdfs:comment>
        <rdfs:label xml:lang="en">has Retain As Published</rdfs:label>
        <skos:example xml:lang="en">If the value of Retain As Published subscription option is set to 0, the Server MUST set the RETAIN flag to 0 when forwarding an Application Message regardless of how the RETAIN flag was set in the received PUBLISH packet. If the value of Retain As Published subscription option is set to 1, the Server MUST set the RETAIN flag equal to the RETAIN flag in the received PUBLISH packet.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasRetainAvailable -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasRetainAvailable">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Retain Available Property in CONNACK. Byte 0/1 indicating whether retained messages are supported.</rdfs:comment>
        <rdfs:label xml:lang="en">has Retain Available</rdfs:label>
        <skos:example xml:lang="en">A Client receiving Retain Available set to 0 from the Server MUST NOT send a PUBLISH packet with the RETAIN flag set to 1.</skos:example>
        <skos:example xml:lang="en">If a Server receives a CONNECT packet containing a Will Message with the Will Retain set to 1, and it does not support retained messages, the Server MUST reject the connection request. It SHOULD send CONNACK with Reason Code 0x9A (Retain not supported) and then it MUST close the Network Connection.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasRetainFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasRetainFlag">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasFixedHeaderFlag"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#PublishFixedHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if the message should be retained on the MQTT Broker.</rdfs:comment>
        <rdfs:label xml:lang="en">RETAIN flag</rdfs:label>
        <skos:example xml:lang="en">If the RETAIN flag is 0 in a PUBLISH packet sent by a Client to a Server, the Server MUST NOT store the message as a retained message and MUST NOT remove or replace any existing retained message.</skos:example>
        <skos:example xml:lang="en">If the RETAIN flag is set to 1 in a PUBLISH packet sent by a Client to a Server, the Server MUST replace any existing retained message for this topic and store the Application Message.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasRetainHandling -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasRetainHandling">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionOption"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#SubscriptionEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
        <rdfs:comment xml:lang="en">Retain Handling subscription option. Two-bit field: 0=send retained, 1=send retained only if subscription new, 2=do not send retained.</rdfs:comment>
        <rdfs:label xml:lang="en">has Retain Handling</rdfs:label>
        <skos:example xml:lang="en">If Retain Handling is set to 0 the Server MUST send the retained messages matching the Topic Filter of the subscription to the Client.</skos:example>
        <skos:example xml:lang="en">If Retain Handling is set to 1 then if the subscription did not already exist, the Server MUST send all retained message matching the Topic Filter of the subscription to the Client, and if the subscription did exist the Server MUST NOT send the retained messages.</skos:example>
        <skos:example xml:lang="en">If Retain Handling is set to 2, the Server MUST NOT send the retained messages.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasServerKeepAlive -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasServerKeepAlive">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <rdfs:comment xml:lang="en">Server Keep Alive Property in CONNACK. Two Byte Integer seconds overriding the Client Keep Alive for this connection.</rdfs:comment>
        <rdfs:label xml:lang="en">has Server Keep Alive</rdfs:label>
        <skos:example xml:lang="en">If the Server does not send the Server Keep Alive, the Server MUST use the Keep Alive value set by the Client on CONNECT.</skos:example>
        <skos:example xml:lang="en">If the Server sends a Server Keep Alive on the CONNACK packet, the Client MUST use this value instead of the Keep Alive value the Client sent on CONNECT.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasServerReference -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasServerReference">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#DisconnectProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Server Reference Property. UTF-8 string suggesting an alternate Server the Client may use.</rdfs:comment>
        <rdfs:label xml:lang="en">has Server Reference</rdfs:label>
        <skos:example xml:lang="en">Followed by a UTF-8 Encoded String which can be used by the Client to identify another Server to use.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasSessionExpiryInterval -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasSessionExpiryInterval">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#DisconnectProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
        <rdfs:comment xml:lang="en">Session Expiry Interval Property. Four Byte Integer seconds defining session lifetime after disconnect.</rdfs:comment>
        <rdfs:label xml:lang="en">has Session Expiry Interval</rdfs:label>
        <skos:example xml:lang="en">The Session Expiry Interval MUST NOT be sent on a DISCONNECT by the Server.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasSessionPresentFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasSessionPresentFlag">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasConnackFlag"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Session Present flag in CONNACK. If 1, a prior Session exists and is resumed.</rdfs:comment>
        <rdfs:label xml:lang="en">has Session Present Flag</rdfs:label>
        <skos:example xml:lang="en">If the Server accepts a connection with Clean Start set to 0 and the Server has Session State for the ClientID, it MUST set Session Present to 1 in the CONNACK packet, otherwise it MUST set Session Present to 0 in the CONNACK packet. In both cases it MUST set a 0x00 (Success) Reason Code in the CONNACK packet.</skos:example>
        <skos:example xml:lang="en">If the Server accepts a connection with Clean Start set to 1, the Server MUST set Session Present to 0 in the CONNACK packet in addition to setting a 0x00 (Success) Reason Code in the CONNACK packet.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasSharedSubscriptionAvailable -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasSharedSubscriptionAvailable">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Shared Subscription Available Property in CONNACK. Byte 0/1 indicating server support for shared subscriptions.</rdfs:comment>
        <rdfs:label xml:lang="en">has Shared Subscription Available</rdfs:label>
        <skos:example xml:lang="en">Followed by a Byte field. If present, this byte declares whether the Server supports Shared Subscriptions. A value is 0 means that Shared Subscriptions are not supported. A value of 1 means Shared Subscriptions are supported.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasSubackReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasSubackReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadReasonCode"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#SubackPayload"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">SUBACK Reason Code. One-byte value per subscription indicating success or reason for failure.</rdfs:comment>
        <rdfs:label xml:lang="en">has Suback Reason Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionIdentifier -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionIdentifier">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PublishProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubscribeProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">Subscription Identifier Property. Variable Byte Integer (value &gt; 0) identifying a subscription; returned in PUBLISH as applicable.</rdfs:comment>
        <rdfs:label xml:lang="en">has Subscription Identifier</rdfs:label>
        <skos:example xml:lang="en">The Subscription Identifier can have the value of 1 to 268,435,455.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionIdentifierAvailable -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionIdentifierAvailable">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Subscription Identifier Available Property in CONNACK. Byte 0/1 indicating support for Subscription Identifiers.</rdfs:comment>
        <rdfs:label xml:lang="en">has Subscription Identifier Available</rdfs:label>
        <skos:example xml:lang="en">If present, this byte declares whether the Server supports Subscription Identifiers. A value is 0 means that Subscription Identifiers are not supported. A value of 1 means Subscription Identifiers are supported.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionOption -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionOption">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#SubscriptionEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
        <rdfs:comment xml:lang="en">Subscription Options byte for a Topic Filter in SUBSCRIBE. Encodes QoS, No Local, Retain As Published, and Retain Handling.</rdfs:comment>
        <rdfs:label xml:lang="en">has Subscription Option</rdfs:label>
        <skos:example xml:lang="en">Bits 0 and 1 of the Subscription Options represent Maximum QoS field. This gives the maximum QoS level at which the Server can send Application Messages to the Client. It is a Protocol Error if the Maximum QoS field has the value 3.</skos:example>
        <skos:example xml:lang="en">Bits 0-1: Maximum QoS
0 = QoS 0
1 = QoS 1
2 = QoS 2
3 = Protocol Error

Bit 2: No Local
0 = Forward messages normally
1 = Do not forward messages from the same ClientID

Bit 3: Retain As Published
0 = Forwarded messages have RETAIN set to 0
1 = Forwarded messages keep the published RETAIN flag

Bits 4-5: Retain Handling
0 = Send retained messages at the time of subscribe
1 = Send retained messages only if the subscription does not already exist
2 = Do not send retained messages at subscribe
3 = Protocol Error

Bits 6-7: Reserved
Must be 0; otherwise the SUBSCRIBE packet is malformed.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasTopicAlias -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasTopicAlias">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PublishProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#Topic"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <rdfs:comment xml:lang="en">Topic Alias Property in PUBLISH. Two Byte Integer (non-zero) alias for Topic Name.</rdfs:comment>
        <rdfs:label xml:lang="en">has Topic Alias</rdfs:label>
        <skos:example xml:lang="en">A Client MUST NOT send a PUBLISH packet with a Topic Alias greater than the Topic Alias Maximum value returned by the Server in the CONNACK packet. A Client MUST accept all Topic Alias values greater than 0 and less than or equal to the Topic Alias Maximum value that it sent in the CONNECT packet.</skos:example>
        <skos:example xml:lang="en">A Server MUST NOT send a PUBLISH packet with a Topic Alias greater than the Topic Alias Maximum value sent by the Client in the CONNECT packet. A Server MUST accept all Topic Alias values greater than 0 and less than or equal to the Topic Alias Maximum value that it returned in the CONNACK packet.</skos:example>
        <skos:example xml:lang="en">A sender MUST NOT send a PUBLISH packet containing a Topic Alias which has the value 0.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasTopicAliasMaximum -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasTopicAliasMaximum">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <rdfs:comment xml:lang="en">Topic Alias Maximum Property. Two Byte Integer indicating the maximum Topic Alias value accepted.</rdfs:comment>
        <rdfs:label xml:lang="en">has Topic Alias Maximum</rdfs:label>
        <skos:example xml:lang="en">The Server MUST NOT send a Topic Alias in a PUBLISH packet to the Client greater than Topic Alias Maximum.</skos:example>
        <skos:example xml:lang="en">Topic Alias Maximum is absent or zero, the Server MUST NOT send any Topic Aliases to the Client.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasUnsubackReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasUnsubackReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadReasonCode"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPayload"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">UNSUBACK Reason Code. One-byte value per topic filter indicating unsubscribe success or failure.</rdfs:comment>
        <rdfs:label xml:lang="en">has Unsuback Reason Code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasUserName -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasUserName">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectPayload"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">User Name in CONNECT payload. UTF-8 string present only if User Name Flag=1.</rdfs:comment>
        <rdfs:label xml:lang="en">has User Name</rdfs:label>
        <skos:example xml:lang="en">The User Name MUST be a UTF-8 Encoded String.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasUserNameFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasUserNameFlag">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasConnectFlag"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">User Name Flag in CONNECT Flags. If 1, User Name is present in CONNECT payload.</rdfs:comment>
        <rdfs:label xml:lang="en">has Username Flag</rdfs:label>
        <skos:example xml:lang="en">If the User Name Flag is set to 1, a User Name MUST be present in the Payload.</skos:example>
        <skos:example xml:lang="en">f the User Name Flag is set to 0, a User Name MUST NOT be present in the Payload.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasUserPropertyName -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasUserPropertyName">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#UserProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">User Property Name (first UTF-8 string of a User Property string pair).</rdfs:comment>
        <rdfs:label xml:lang="en">has User Propery Name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasUserPropertyValue -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasUserPropertyValue">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#UserProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">User Property Value (second UTF-8 string of a User Property string pair).</rdfs:comment>
        <rdfs:label xml:lang="en">has User Property Value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeaderReasonCode -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeaderReasonCode">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasReasonCode"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#AuthVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#DisconnectVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubackVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubcompVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrecVariableHeader"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrelVariableHeader"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Reason Code carried in a packet variable header when defined by MQTT 5.0 (one-byte reason value).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Reason Code in Variable Header</rdfs:label>
        <skos:example xml:lang="en">MQTT 5 Reason Codes

0 / 0x00: Success — CONNACK, PUBACK, PUBREC, PUBREL, PUBCOMP, UNSUBACK, AUTH
0 / 0x00: Normal disconnection — DISCONNECT
0 / 0x00: Granted QoS 0 — SUBACK
1 / 0x01: Granted QoS 1 — SUBACK
2 / 0x02: Granted QoS 2 — SUBACK
4 / 0x04: Disconnect with Will Message — DISCONNECT
16 / 0x10: No matching subscribers — PUBACK, PUBREC
17 / 0x11: No subscription existed — UNSUBACK
24 / 0x18: Continue authentication — AUTH
25 / 0x19: Re-authenticate — AUTH
128 / 0x80: Unspecified error — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
129 / 0x81: Malformed Packet — CONNACK, DISCONNECT
130 / 0x82: Protocol Error — CONNACK, DISCONNECT
131 / 0x83: Implementation specific error — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
132 / 0x84: Unsupported Protocol Version — CONNACK
133 / 0x85: Client Identifier not valid — CONNACK
134 / 0x86: Bad User Name or Password — CONNACK
135 / 0x87: Not authorized — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
136 / 0x88: Server unavailable — CONNACK
137 / 0x89: Server busy — CONNACK, DISCONNECT
138 / 0x8A: Banned — CONNACK
139 / 0x8B: Server shutting down — DISCONNECT
140 / 0x8C: Bad authentication method — CONNACK, DISCONNECT
141 / 0x8D: Keep Alive timeout — DISCONNECT
142 / 0x8E: Session taken over — DISCONNECT
143 / 0x8F: Topic Filter invalid — SUBACK, UNSUBACK, DISCONNECT
144 / 0x90: Topic Name invalid — CONNACK, PUBACK, PUBREC, DISCONNECT
145 / 0x91: Packet Identifier in use — PUBACK, PUBREC, SUBACK, UNSUBACK
146 / 0x92: Packet Identifier not found — PUBREL, PUBCOMP
147 / 0x93: Receive Maximum exceeded — DISCONNECT
148 / 0x94: Topic Alias invalid — DISCONNECT
149 / 0x95: Packet too large — CONNACK, DISCONNECT
150 / 0x96: Message rate too high — DISCONNECT
151 / 0x97: Quota exceeded — CONNACK, PUBACK, PUBREC, SUBACK, DISCONNECT
152 / 0x98: Administrative action — DISCONNECT
153 / 0x99: Payload format invalid — CONNACK, PUBACK, PUBREC, DISCONNECT
154 / 0x9A: Retain not supported — CONNACK, DISCONNECT
155 / 0x9B: QoS not supported — CONNACK, DISCONNECT
156 / 0x9C: Use another server — CONNACK, DISCONNECT
157 / 0x9D: Server moved — CONNACK, DISCONNECT
158 / 0x9E: Shared Subscriptions not supported — SUBACK, DISCONNECT
159 / 0x9F: Connection rate exceeded — CONNACK, DISCONNECT
160 / 0xA0: Maximum connect time — DISCONNECT
161 / 0xA1: Subscription Identifiers not supported — SUBACK, DISCONNECT
162 / 0xA2: Wildcard Subscriptions not supported — SUBACK, DISCONNECT</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasWildcardSubscriptionAvailable -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasWildcardSubscriptionAvailable">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Wildcard Subscription Available Property in CONNACK. Byte 0/1 indicating support for wildcard topic filters.</rdfs:comment>
        <rdfs:label xml:lang="en">has Wildcard Subscription Available</rdfs:label>
        <skos:example xml:lang="en">If a new Network Connection to this Session is made before the Will Delay Interval has passed, the Server MUST NOT send the Will Message.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasWillDelayInterval -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasWillDelayInterval">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#WillProperties"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
        <rdfs:comment xml:lang="en">Will Delay Interval Property. Four Byte Integer seconds delaying Will publication after connection loss.</rdfs:comment>
        <rdfs:label xml:lang="en">has Will Delay Interval</rdfs:label>
        <skos:example xml:lang="en">If a new Network Connection to this Session is made before the Will Delay Interval has passed, the Server MUST NOT send the Will Message</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasWillFlag -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasWillFlag">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasConnectFlag"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Will Flag in CONNECT Flags. If 1, Will Properties/Topic/Payload are present.</rdfs:comment>
        <rdfs:label xml:lang="en">has Will Flag</rdfs:label>
        <skos:example xml:lang="en">If the Will Flag is set to 1 this indicates that a Will Message MUST be stored on the Server and associated with the Session.</skos:example>
        <skos:example xml:lang="en">If the Will Flag is set to 1, the Will Properties, Will Topic, and Will Payload fields MUST be present in the Payload.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasWillPayload -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasWillPayload">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectPayload"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#base64Binary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Will Payload in CONNECT payload. Binary Data constituting the Will Message payload.</rdfs:comment>
        <rdfs:label xml:lang="en">has Will Payload</rdfs:label>
        <skos:example xml:lang="en">The Will Payload defines the Application Message Payload that is to be published to the Will Topic.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasWillProperty -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasWillProperty">
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#WillProperties"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#base64Binary"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#hexBinary"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Will Properties container in CONNECT payload. Set of MQTT 5.0 Properties applying to the Will Message.</rdfs:comment>
        <rdfs:label xml:lang="en">has MQTT Will Property</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasWillQoS -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasWillQoS">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasConnectFlag"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedByte"/>
        <rdfs:comment xml:lang="en">Will QoS in CONNECT Flags. Two-bit field with values 0, 1, or 2 for the Will Message QoS.</rdfs:comment>
        <rdfs:label xml:lang="en">has Will QoS</rdfs:label>
        <skos:example xml:lang="en">If the Will Flag is set to 0, then the Will QoS MUST be set to 0 (0x00).</skos:example>
        <skos:example xml:lang="en">If the Will Flag is set to 1, the value of Will QoS can be 0 (0x00), 1 (0x01), or 2 (0x02).</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasWillRetain -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasWillRetain">
        <rdfs:subPropertyOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasConnectFlag"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Will Retain in CONNECT Flags. If 1, the Will Message is published as retained.</rdfs:comment>
        <rdfs:label xml:lang="en">has Will Retain</rdfs:label>
        <skos:example xml:lang="en">If the Will Flag is set to 0, then Will Retain MUST be set to 0.</skos:example>
        <skos:example xml:lang="en">If the Will Flag is set to 1 and Will Retain is set to 0, the Server MUST publish the Will Message as a non-retained message.</skos:example>
        <skos:example xml:lang="en">If the Will Flag is set to 1 and Will Retain is set to 1, the Server MUST publish the Will Message as a retained message.</skos:example>
    </owl:DatatypeProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#usesTLS -->


    <owl:DatatypeProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#usesTLS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#NetworkConnection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if the Network Connection is protected via TLS, otherwise false.</rdfs:comment>
        <rdfs:label xml:lang="en">uses TLS</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/vocommons/voaf#Vocabulary -->


    <owl:Class rdf:about="http://purl.org/vocommons/voaf#Vocabulary"/>
    


    <!-- http://qudt.org/schema/qudt/AbstractQuantityKind -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/AbstractQuantityKind">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
                <owl:allValuesFrom rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/latexSymbol"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Quantity Kind (abstract)</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/AngleUnit -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/AngleUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/DimensionlessUnit"/>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Aspect -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Aspect"/>
    


    <!-- http://qudt.org/schema/qudt/AspectClass -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/AspectClass">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Aspect Class</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/BaseDimensionMagnitude -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/BaseDimensionMagnitude">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasBaseQuantityKind"/>
                <owl:allValuesFrom rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasBaseQuantityKind"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasBaseQuantityKind"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasBaseQuantityKind"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/vectorMagnitude"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/vectorMagnitude"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/vectorMagnitude"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/vectorMagnitude"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;A &lt;em&gt;Dimension&lt;/em&gt; expresses a magnitude for a base quantity kind such as mass, length and time.
  &lt;/p&gt;
  &lt;p&gt;DEPRECATED - each exponent is expressed as a property. 
  Keep until a validation of this has been done.
  &lt;/p&gt;</terms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://web.mit.edu/2.25/www/pdf/DA_unified.pdf</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Dimensional_analysis</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Base Dimension Magnitude</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/BinaryPrefix -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/BinaryPrefix">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Prefix"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;A &lt;em&gt;Binary Prefix&lt;/em&gt; is a prefix for multiples of units in data processing, data transmission, and digital information,
   notably the bit and the byte, to indicate multiplication by a power of 2.
   &lt;/p&gt;
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Binary Prefix</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Citation -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Citation">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/url"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/description"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/description"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/description"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/url"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Provides a simple way of making citations.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Citation</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Comment -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Comment">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Verifiable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/rationale"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/rationale"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/description"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Comment</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Concept -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Concept">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/abbreviation"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/deprecatedInVersion"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/exactMatch"/>
                <owl:allValuesFrom rdf:resource="http://qudt.org/schema/qudt/Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/guidance"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasRule"/>
                <owl:allValuesFrom rdf:resource="http://qudt.org/schema/qudt/Rule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/id"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/deprecated"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/abbreviation"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/deprecated"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/deprecatedInVersion"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/id"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">The root class for all QUDT concepts.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>QUDT Concept</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/ConstantValue -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/ConstantValue">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/exactConstant"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/exactConstant"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Used to specify the values of a constant.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Constant value</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/ContextualUnit -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/ContextualUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
                <owl:allValuesFrom rdf:resource="http://qudt.org/schema/qudt/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Contextual Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/CountingUnit -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/CountingUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/DimensionlessUnit"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;A &lt;em&gt;Counting Unit&lt;/em&gt; is used for all units that express counts. 
  Examples are Atomic Number, Number, Number per Year, Percent and Sample per Second.
  &lt;/p&gt;
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Counting Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/CurrencyUnit -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/CurrencyUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/DimensionlessUnit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/currencyCode"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/currencyNumber"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/currencyExponent"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  Currency Units have their own subclass of unit because:
   (a) they have additional properties such as &apos;country&apos; and
   (b) their URIs do not conform to the same rules as other units.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Currency Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/DataItem -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/DataItem">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Concept"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;A &lt;em&gt;Data Item&lt;/em&gt; holds a value that maybe a scalar or structured datatype.
  &lt;em&gt;Quantity Value&lt;/em&gt; specifies which case applies.
  &lt;/p&gt;</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Data Item</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Datatype -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Datatype">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Concept"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
   &lt;p&gt;A &lt;em&gt;Datatype&lt;/em&gt; is a definition of the type of the &quot;value&quot; of a data item (for example, &quot;all integers between 0 and 10&quot;),
   and the allowable operations on those values; the meaning of the data; and the way values of that type can be stored. 
  Some types are primitive - built-in to the language, with no visible internal structure.
  For example &quot;Boolean&quot;; others are composite - constructed from one or more other types (of either kind).
  For example lists, arrays, structures, unions. 
  Some languages provide strong typing, others allow implicit type conversion and/or explicit type conversion.
  &lt;/p&gt;</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Datatype</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/DecimalPrefix -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/DecimalPrefix">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Prefix"/>
        <terms:description>
  A &lt;em&gt;Decimal Prefix&lt;/em&gt; is a prefix for multiples of units that are powers of 10.
  </terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Decimal Prefix</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/DerivedUnit -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/DerivedUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/DigitalCurrencyUnit -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/DigitalCurrencyUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/CurrencyUnit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/blockchainNetwork"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/currencyCode"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasDTICode"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/currencyExponent"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/blockchainNetwork"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/currencyCode"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/currencyExponent"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasDTICode"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:description xml:lang="en">A currency-like unit for cryptographic or tokenized assets. Instances should reference an ISO 24165 Digital Token Identifier (DTI) when available.</terms:description>
        <qudt:informativeReference rdf:resource="https://dtif.org/"/>
        <qudt:informativeReference rdf:resource="https://www.iso.org/standard/79891.html"/>
        <rdfs:comment xml:lang="en">A currency-like unit for cryptographic or tokenized assets. Instances should reference an ISO 24165 Digital Token Identifier (DTI) when available.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label xml:lang="en">Digital Currency Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/DimensionlessUnit -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/DimensionlessUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;A &lt;em&gt;Dimensionless Unit&lt;/em&gt; is a quantity for which all the exponents of the factors corresponding to the base quantities in its quantity dimension are zero.
  &lt;/p&gt;</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Dimensionless Unit</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Discipline -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Discipline">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Discipline</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/EnumeratedQuantity -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/EnumeratedQuantity">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/enumeratedValue"/>
                <owl:allValuesFrom rdf:resource="http://qudt.org/schema/qudt/EnumeratedValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/enumeration"/>
                <owl:allValuesFrom rdf:resource="http://qudt.org/schema/qudt/Enumeration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/enumeratedValue"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/enumeration"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Enumerated Quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/EnumeratedValue -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/EnumeratedValue">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Verifiable"/>
        <rdfs:subClassOf rdf:resource="http://www.linkedmodel.org/schema/dtype#EnumeratedValue"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/abbreviation"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/description"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/abbreviation"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;An &lt;em&gt;Enumerated Value&lt;/em&gt; class defines the members of an enumeration. 
  An enumeration is a set of literals from which a single value is selected. 
  Each literal can have a tag as an integer within a standard encoding appropriate to the range of integer values. 
  Consistency of enumeration types will allow them, and the enumerated values, to be referred to unambiguously either through symbolic name or encoding. 
  &lt;/p&gt;
  &lt;p&gt;Enumerated values are also controlled vocabularies and as such need to be standardized. 
  Without this consistency enumeration literals can be stated differently and result in  data conflicts and misinterpretations.
  &lt;/p&gt;
  &lt;p&gt;The tags are a set of positive whole numbers, not necessarily contiguous and having no numerical significance, each corresponding to the associated literal identifier. 
  An order attribute can also be given on the enumeration elements. 
  An enumeration can itself be a member of an enumeration. 
  This allows enumerations to be enumerated in a selection. 
  &lt;/p&gt;
  &lt;p&gt;Enumerations are also subclasses of Scalar Datatype. 
  This allows them to be used as the reference of a datatype specification.
  &lt;/p&gt;
  </terms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Enumeration</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Enumerated Value</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Enumeration -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Enumeration">
