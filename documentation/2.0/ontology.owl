        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader"/>
        <rdfs:comment xml:lang="en">Links an MQTT Control Packet to its Variable Header.</rdfs:comment>
        <rdfs:label xml:lang="en">has Variable Header</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasWillProperties -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasWillProperties">
