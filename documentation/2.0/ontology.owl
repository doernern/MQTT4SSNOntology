        <rdfs:domain rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPacket"/>
        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPayload"/>
