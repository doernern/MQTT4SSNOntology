        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackVariableHeader"/>
        <rdfs:comment xml:lang="en">Links a UNSUBACK packet to its specific Variable Header.</rdfs:comment>
        <rdfs:label xml:lang="en">has UNSUBACK Variable Header</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasUnsubscribeFixedHeader -->


