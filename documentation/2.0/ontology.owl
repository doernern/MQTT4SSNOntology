    <!-- https://www.w3id.org/MQTT4SSN-Ontology#DisconnectPacket -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#DisconnectPacket">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket"/>
        <rdfs:comment xml:lang="en">An MQTT Control Packet sent by a Client or Server to indicate that the connection is being closed intentionally.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT DISCONNECT Packet</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#DisconnectProperties -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#DisconnectProperties">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Properties"/>
        <rdfs:comment xml:lang="en">Properties section of the DISCONNECT packet variable header in MQTT 5.0 (e.g., Session Expiry Interval, Reason String, Server Reference, User Properties) accompanying the Disconnect Reason Code.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Disconnect Properties</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#DisconnectVariableHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#DisconnectVariableHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader"/>
