    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasUserProperty -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasUserProperty">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#AuthProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#DisconnectProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubcompProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PublishProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrecProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#PubrelProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubscribeProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeProperties"/>
                    <rdf:Description rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#WillProperties"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#UserProperty"/>
        <rdfs:comment xml:lang="en">Links a Properties collection to one contained UserProperty (Name/Value pair). Multiple values may occur.</rdfs:comment>
        <rdfs:label xml:lang="en">has User Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeader -->


    <owl:ObjectProperty rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeader">
        <owl:inverseOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#isVariableHeaderOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
