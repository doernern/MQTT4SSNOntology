    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#SubscribeVariableHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubscribeVariableHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader"/>
        <rdfs:comment xml:lang="en">The Variable Header of a SUBSCRIBE packet; typically includes the packet identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT SUBSCRIBE Variable Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#SubscriptionEntry -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#SubscriptionEntry">
        <rdfs:comment xml:lang="en">A single requested subscription consisting of an MQTT Topic Filter and an associated QoS level.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Subscription Entry</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#Topic -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#Topic">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasActObsSubject"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Actuation"/>
                            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ActuationCollection"/>
                            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation"/>
                            <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ObservationCollection"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasFoISubject"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#hasPropertySubject"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A hierarchical MQTT Topic to which MQTT Clients publish and/or subscribe.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Topic</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#TopicFilter -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#TopicFilter">
        <rdfs:comment xml:lang="en">A filter expression (e.g., with wildcards) used in SUBSCRIBE/UNSUBSCRIBE to match MQTT Topics.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Topic Filter</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#TopicSubject -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#TopicSubject">
        <rdfs:comment xml:lang="en">A conceptual subject carried on an MQTT Topic, e.g., an Observation, Actuation, Property, or Feature of Interest.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Topic Subject</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UnsubackFixedHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackFixedHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader"/>
        <rdfs:comment xml:lang="en">The Fixed Header of an UNSUBACK packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT UNSUBACK Fixed Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPacket -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPacket">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket"/>
        <rdfs:comment xml:lang="en">An MQTT Control Packet sent by the Server to acknowledge an UNSUBSCRIBE request.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT UNSUBACK Packet</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPayload -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPayload">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Payload"/>
        <rdfs:comment xml:lang="en">UNSUBACK packet payload in MQTT 5.0. Sequence of Unsuback Reason Codes, one for each Topic Filter in the corresponding UNSUBSCRIBE request.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT UNSUBACK Payload</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UnsubackProperties -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackProperties">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Properties"/>
        <rdfs:comment xml:lang="en">Properties section of the UNSUBACK packet variable header in MQTT 5.0 (e.g., Reason String, User Properties) accompanying the Unsuback Payload.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Unsuback Properties</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UnsubackVariableHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubackVariableHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader"/>
        <rdfs:comment xml:lang="en">The Variable Header of an UNSUBACK packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT UNSUBACK Variable Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeFixedHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeFixedHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader"/>
        <rdfs:comment xml:lang="en">The Fixed Header used in UNSUBSCRIBE packets.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT UNSUBSCRIBE Fixed Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribePacket -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribePacket">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket"/>
        <rdfs:comment xml:lang="en">An MQTT Control Packet used by an MQTT Client to remove one or more subscriptions.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT UNSUBSCRIBE Packet</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribePayload -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribePayload">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Payload"/>
        <rdfs:comment xml:lang="en">The payload of an UNSUBSCRIBE packet, listing MQTT Topic Filters to be removed.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT UNSUBSCRIBE Payload</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeProperties -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeProperties">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#Properties"/>
        <rdfs:comment xml:lang="en">Properties section of the UNSUBSCRIBE packet variable header in MQTT 5.0 (e.g., User Properties).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Unsubscribe Properties</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeVariableHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeVariableHeader">
        <rdfs:subClassOf rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader"/>
        <rdfs:comment xml:lang="en">The Variable Header of an UNSUBSCRIBE packet.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT UNSUBSCRIBE Variable Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#UserProperty -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#UserProperty">
        <rdfs:comment xml:lang="en">MQTT 5.0 User Property. A UTF-8 String Pair (Name, Value) that can appear in many packet property sets. Semantics are application-defined.</rdfs:comment>
        <rdfs:label xml:lang="en">User Property</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader">
        <rdfs:comment xml:lang="en">The optional header carrying packet-specific metadata (e.g., packet identifier, MQTT Topic name).</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Variable Header</rdfs:label>
    </owl:Class>
    


    <!-- https://www.w3id.org/MQTT4SSN-Ontology#WillProperties -->


    <owl:Class rdf:about="https://www.w3id.org/MQTT4SSN-Ontology#WillProperties">
        <rdfs:comment xml:lang="en">Will Properties in the CONNECT payload in MQTT 5.0 (e.g., Will Delay Interval, Payload Format Indicator, Message Expiry Interval, Content Type, Response Topic, Correlation Data, User Properties) applying to the Will Message.</rdfs:comment>
        <rdfs:label xml:lang="en">MQTT Will Properties</rdfs:label>
    </owl:Class>
    


