        <rdfs:range rdf:resource="https://www.w3id.org/MQTT4SSN-Ontology#ConnackPacket"/>
        <rdfs:comment xml:lang="en">Links a CONNACK Variable Header to its MQTT Control Packet.</rdfs:comment>
