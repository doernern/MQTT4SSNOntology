        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>prefix multiplier</rdfs:label>
    </owl:DatatypeProperty>
    


