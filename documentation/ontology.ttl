                                              owl:equivalentProperty :hasDUPFlag .


###  https://www.w3.org/2019/wot/mqtt#hasRetainFlag
<https://www.w3.org/2019/wot/mqtt#hasRetainFlag> rdf:type owl:DatatypeProperty ;
                                                 owl:equivalentProperty :hasRetainFlag .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasAssignedClientIdentifier
:hasAssignedClientIdentifier rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf :hasProperty ;
                             rdf:type owl:FunctionalProperty ;
                             rdfs:domain :ConnackProperties ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Assigned Client Identifier Property. UTF-8 string assigned by the Server when the Client did not provide one."@en ;
                             rdfs:label "has Assigned Client Identifier"@en ;
                             <http://www.w3.org/2004/02/skos/core#example> "If the Client connects using a zero length Client Identifier, the Server MUST respond with a CONNACK containing an Assigned Client Identifier. The Assigned Client Identifier MUST be a new Client Identifier not used by any other Session currently in the Server."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasAuthReasonCode
:hasAuthReasonCode rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :hasVariableHeaderReasonCode ;
                   rdfs:domain :AuthVariableHeader ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:unionOf ( xsd:hexBinary
                                              xsd:string
                                              xsd:unsignedByte
                                            )
                              ] ;
                   rdfs:comment "AUTH Reason Code. One-byte value indicating enhanced-auth result or continuation status."@en ;
                   rdfs:label "has Auth Reason Code"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasAuthentificationData
:hasAuthentificationData rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf :hasProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :AuthProperties
                                                     :ConnackProperties
                                                     :ConnectProperties
                                                   )
                                     ] ;
                         rdfs:range [ rdf:type rdfs:Datatype ;
                                      owl:unionOf ( xsd:base64Binary
                                                    xsd:hexBinary
                                                  )
                                    ] ;
                         rdfs:label "has Authentification Data"@en ;
                         <http://www.w3.org/2004/02/skos/core#example> "Authentication Data Property. Binary Data for enhanced authentication."@en ;
                         <http://www.w3.org/2004/02/skos/core#note> "The contents of this data are defined by the authentication method."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasAuthentificationMethod
:hasAuthentificationMethod rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf :hasProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( :AuthProperties
                                                       :ConnackProperties
                                                       :ConnectProperties
                                                     )
                                       ] ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Authentication Method Property. UTF-8 string naming the enhanced-auth method."@en ;
                           rdfs:label "has Authentification Method"@en ;
                           <http://www.w3.org/2004/02/skos/core#example> "ollowed by a UTF-8 Encoded String containing the name of the authentication method. It is a Protocol Error to omit the Authentication Method or to include it more than once."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasCleanStart
:hasCleanStart rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :hasConnectFlag ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :ConnectVariableHeader ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Clean Start flag in CONNECT Flags. 1 requests a new Session; 0 continues an existing Session if present."@en ;
               rdfs:label "has Clean Start"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "If a CONNECT packet is received with Clean Start is set to 1, the Client and Server MUST discard any existing Session and start a new Session."@en ,
                                                             "If a CONNECT packet is received with Clean Start set to 0 and there is a Session associated with the Client Identifier, the Server MUST resume communications with the Client based on state from the existing Session."@en ,
                                                             "If a CONNECT packet is received with Clean Start set to 0 and there is no Session associated with the Client Identifier, the Server MUST create a new Session."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasClientID
:hasClientID rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Client ;
             rdfs:range xsd:string ;
             rdfs:comment "The MQTT Client identifier used when connecting to an MQTT Broker."@en ;
             rdfs:label "MQTT Client identifier"@en ;
             <http://www.w3.org/2004/02/skos/core#example> "The ClientID MUST be a UTF-8 Encoded String."@en ,
                                                           "The ClientID MUST be used by Clients and by Servers to identify state that they hold relating to this MQTT Session between the Client and the Server."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasConnackFlag
:hasConnackFlag rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :ConnackVariableHeader ;
                rdfs:range xsd:boolean ;
                rdfs:comment "CONNACK Acknowledge Flags byte. In MQTT 5.0 only Session Present (bit 0) is used; other bits are reserved."@en ;
                rdfs:label "has Connack Flag"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "Byte 1 is the \"Connect Acknowledge Flags\". Bits 7-1 are reserved and MUST be set to 0."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasConnackReasonCode
:hasConnackReasonCode rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasVariableHeaderReasonCode ;
                      rdfs:domain :ConnackVariableHeader ;
                      rdfs:range [ rdf:type rdfs:Datatype ;
                                   owl:unionOf ( xsd:hexBinary
                                                 xsd:string
                                                 xsd:unsignedByte
                                               )
                                 ] ;
                      rdfs:comment "CONNACK Reason Code. One-byte value indicating the result of a CONNECT request."@en ;
                      rdfs:label "has Connack Reason Code"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasConnectFlag
:hasConnectFlag rdf:type owl:DatatypeProperty ;
                rdfs:domain :ConnectVariableHeader ;
                rdfs:range xsd:unsignedByte ;
                rdfs:comment "CONNECT Flags byte encoding User Name/Password/Will/Clean Start fields; reserved bit MUST be 0."@en ;
                rdfs:label "has Connect Flags"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "Bit 0 = Reserved; Bit 1 = Clean Start; Bit 2 = Will Flag; Bit 3 und 4 = Will QoS; Bit 5 = Will Retain; Bit 6 = Password Flag; Bit 7 = User Name Flag."@en ,
                                                              "The Server MUST validate that the reserved flag in the CONNECT packet is set to 0."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasContentType
:hasContentType rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :hasProperty ,
                                   :hasWillProperty ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :PublishProperties
                                            :WillProperties
                                          )
                            ] ;
                rdfs:range xsd:string ;
                rdfs:comment "Application Message content type"@en ;
                rdfs:label "has Content Type"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "3 (0x03) Byte, Identifier of the Content Type. Followed by a UTF-8 Encoded String describing the content of the Will Message. It is a Protocol Error to include the Content Type more than once. The value of the Content Type is defined by the sending and receiving application."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasControlPacketType
:hasControlPacketType rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :FixedHeader ;
                      rdfs:range [ rdf:type rdfs:Datatype ;
                                   owl:unionOf ( xsd:string
                                                 xsd:unsignedShort
                                               )
                                 ] ;
                      rdfs:comment "4 bits Control Packet Type or literal of the MQTT Fixed Header, indicating the type of MQTT Control Packet (e.g., CONNECT, PUBLISH, SUBSCRIBE)."@en ;
                      rdfs:label "MQTT Control Packet Type"@en ;
                      <http://www.w3.org/2004/02/skos/core#example> """Reserved (0): Forbidden — Reserved
CONNECT (1): Client to Server — Connection request
CONNACK (2): Server to Client — Connect acknowledgment
PUBLISH (3): Client to Server or Server to Client — Publish message
PUBACK (4): Client to Server or Server to Client — Publish acknowledgment (QoS 1)
PUBREC (5): Client to Server or Server to Client — Publish received (QoS 2 delivery part 1)
PUBREL (6): Client to Server or Server to Client — Publish release (QoS 2 delivery part 2)
PUBCOMP (7): Client to Server or Server to Client — Publish complete (QoS 2 delivery part 3)
SUBSCRIBE (8): Client to Server — Subscribe request
SUBACK (9): Server to Client — Subscribe acknowledgment
UNSUBSCRIBE (10): Client to Server — Unsubscribe request
UNSUBACK (11): Server to Client — Unsubscribe acknowledgment
PINGREQ (12): Client to Server — PING request
PINGRESP (13): Server to Client — PING response
DISCONNECT (14): Client to Server or Server to Client — Disconnect notification
AUTH (15): Client to Server or Server to Client — Authentication exchange"""@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasCorrelationData
:hasCorrelationData rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :hasProperty ,
                                       :hasWillProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :PublishProperties
                                                :WillProperties
                                              )
                                ] ;
                    rdfs:range [ rdf:type rdfs:Datatype ;
                                 owl:unionOf ( xsd:base64Binary
                                               xsd:hexBinary
                                               xsd:string
                                             )
                               ] ;
                    rdfs:comment "Correlation Data Property. Binary Data used to correlate requests and responses."@en ;
                    rdfs:label "has Correlation Data"@en ;
                    <http://www.w3.org/2004/02/skos/core#example> "9 (0x09) Byte, Identifier of the Correlation Data. Followed by Binary Data. The Correlation Data is used by the sender of the Request Message to identify which request the Response Message refers to when it is received. It is a Protocol Error to include Correlation Data more than once. If the Correlation Data is not present, the requester does not require any correlation data."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasDUPFlag
:hasDUPFlag rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :hasFixedHeaderFlag ;
            rdfs:domain :PublishFixedHeader ;
            rdfs:range xsd:boolean ;
            rdfs:comment "True if this is a duplicate delivery of an earlier PUBLISH message."@en ;
            rdfs:label "DUP flag"@en ;
            <http://www.w3.org/2004/02/skos/core#example> "The DUP flag MUST be set to 0 for all QoS 0 messages."@en ,
                                                          "The DUP flag MUST be set to 1 by the Client or Server when it attempts to re-deliver a PUBLISH packet."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasDisconnectReasonCode
:hasDisconnectReasonCode rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf :hasVariableHeaderReasonCode ;
                         rdfs:domain :DisconnectVariableHeader ;
                         rdfs:range [ rdf:type rdfs:Datatype ;
                                      owl:unionOf ( xsd:hexBinary
                                                    xsd:string
                                                    xsd:unsignedByte
                                                  )
                                    ] ;
                         rdfs:comment "DISCONNECT Reason Code. One-byte value indicating the reason for disconnection."@en ;
                         rdfs:label "has Dissconnect Reason Code"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasFilterPattern
:hasFilterPattern rdf:type owl:DatatypeProperty ;
                  rdfs:domain :TopicFilter ;
                  rdfs:range xsd:string ;
                  rdfs:comment "The MQTT Topic Filter pattern as a string (e.g., 'sensor/+/temp' or 'fabrik/zentrierung/#')."@en ;
                  rdfs:label "MQTT Topic Filter pattern"@en ;
                  <http://www.w3.org/2004/02/skos/core#example> "An MQTT topic filter used in subscriptions to match topic names. A filter pattern may include the single-level wildcard '+' and the multi-level wildcard '#'."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasFixedHeaderFlag
:hasFixedHeaderFlag rdf:type owl:DatatypeProperty ;
                    rdfs:domain :PublishFixedHeader ;
                    rdfs:range xsd:unsignedByte ;
                    rdfs:comment "Fixed Header flags nibble (bits 3..0 of byte 1). Packet-type-specific reserved/required flag pattern in MQTT 5.0."@en ;
                    rdfs:label "FixedHeader flag"@en ;
                    <http://www.w3.org/2004/02/skos/core#example> "Where a flag bit is marked as “Reserved”, it is reserved for future use and MUST be set to the value listed."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasHostAddress
:hasHostAddress rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Broker ;
                rdfs:range xsd:string ;
                rdfs:comment "The hostname or IP address of an MQTT Broker."@en ;
                rdfs:label "MQTT Broker host"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "Examples: localhost, 127.0.0.1, mqtt.example.com, 192.168.0.10"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasKeepAlive
:hasKeepAlive rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :ConnectVariableHeader ;
              rdfs:range xsd:unsignedShort ;
              rdfs:comment "Keep Alive in CONNECT variable header. Two Byte Integer seconds defining maximum time between Client Control Packets."@en ;
              rdfs:label "has Keep Alive" ;
              <http://www.w3.org/2004/02/skos/core#example> "If Keep Alive is non-zero and in the absence of sending any other MQTT Control Packets, the Client MUST send a PINGREQ packet."@en ,
                                                            "If the Keep Alive value is non-zero and the Server does not receive an MQTT Control Packet from the Client within one and a half times the Keep Alive time period, it MUST close the Network Connection to the Client as if the network had failed."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasMaximumPacketSize
:hasMaximumPacketSize rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :ConnackProperties
                                                  :ConnectProperties
                                                )
                                  ] ;
                      rdfs:range xsd:unsignedInt ;
                      rdfs:comment "Maximum Packet Size Property. Four Byte Integer (non-zero) limiting maximum MQTT packet size accepted."@en ;
                      rdfs:label "has Maximum Packet Size"@en ;
                      <http://www.w3.org/2004/02/skos/core#example> "39 (0x27) Byte, Identifier of the Maximum Packet Size. Followed by a Four Byte Integer representing the Maximum Packet Size the Client is willing to accept. If the Maximum Packet Size is not present, no limit on the packet size is imposed beyond the limitations in the protocol as a result of the remaining length encoding and the protocol header sizes."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasMaximumQoS
:hasMaximumQoS rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :hasProperty ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :ConnackProperties ;
               rdfs:range xsd:unsignedByte ;
               rdfs:comment "Maximum QoS Property. Byte specifying the highest QoS level supported by the Server."@en ;
               rdfs:label "has Maximum QoS"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "A Server that does not support QoS 1 or QoS 2 PUBLISH packets MUST still accept SUBSCRIBE packets containing a Requested QoS of 0, 1 or 2."@en ,
                                                             "If a Client receives a Maximum QoS from a Server, it MUST NOT send PUBLISH packets at a QoS level exceeding the Maximum QoS level specified."@en ,
                                                             "If a Server does not support QoS 1 or QoS 2 PUBLISH packets it MUST send a Maximum QoS in the CONNACK packet specifying the highest QoS it supports."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasMessageContent
:hasMessageContent rdf:type owl:DatatypeProperty ;
                   rdfs:domain :ApplicationMessage ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Application message content carried by PUBLISH. Conceptual higher-level view of the PUBLISH payload."@en ;
                   rdfs:label "has Application Message content"@en ;
                   <http://www.w3.org/2004/02/skos/core#example> """Example message content:
- container field: data
- encoding: UTF-8
- content type: text/csv
- delimiter: ;
- fields: RFID; JobStart; JobEnd; Correction_X; Correction_Y; Correction_Z; Sensor; Actuator

Example value:
RFID;JobStart;JobEnd;Correction_X;Correction_Y;Correction_Z;Sensor;Actuator
RFID_87A3F1;2025-12-03T09:15:02.120Z;2025-12-03T09:15:02.520Z;-0.44;-0.15;+0.10;Sensor1;Actuator1"""@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasMessageContentDelimiter
:hasMessageContentDelimiter rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain :ApplicationMessage ;
                            rdfs:range xsd:string ;
                            rdfs:comment "The delimiter used to separate fields in the Application Message content."@en ;
                            rdfs:label "Application Message content delimiter"@en ;
                            <http://www.w3.org/2004/02/skos/core#example> ";"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasMessageContentType
:hasMessageContentType rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf owl:topDataProperty ;
                       rdfs:domain :ApplicationMessage ;
                       rdfs:range xsd:string ;
                       rdfs:comment "The MIME type of the Application Message content (e.g., 'application/json')."@en ;
                       rdfs:label "has Message Content Type"@en ;
                       <http://www.w3.org/2004/02/skos/core#example> "The Content Type MUST be a UTF-8 Encoded String."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasMessageEncoding
:hasMessageEncoding rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :ApplicationMessage ;
                    rdfs:range xsd:string ;
                    rdfs:comment "The character encoding or serialization used for the Application Message (e.g., 'UTF-8', 'Base64')."@en ;
                    rdfs:label "Application Message encoding"@en ;
                    <http://www.w3.org/2004/02/skos/core#example> "A UTF-8 Encoded String MUST NOT include an encoding of the null character U+0000."@en ,
                                                                  "The character data in a UTF-8 Encoded String MUST be well-formed UTF-8 as defined by the Unicode specification [Unicode] and restated in RFC 3629 [RFC3629]. In particular, the character data MUST NOT include encodings of code points between U+D800 and U+DFFF."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasMessageExpiryInterval
:hasMessageExpiryInterval rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf :hasProperty ,
                                             :hasWillProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( :PublishProperties
                                                      :WillProperties
                                                    )
                                      ] ;
                          rdfs:range xsd:unsignedInt ;
                          rdfs:comment "Message Expiry Interval Property. Four Byte Integer seconds defining PUBLISH message lifetime."@en ;
                          rdfs:label "has Message Expiry Interval"@en ;
                          <http://www.w3.org/2004/02/skos/core#example> "2 (0x02) Byte, Identifier of the Message Expiry Interval. Followed by the Four Byte Integer representing the Message Expiry Interval in seconds. If present, the Four Byte value is the lifetime of the Application Message in seconds. If absent, the Application Message does not expire."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasNoLocal
:hasNoLocal rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :hasSubscriptionOption ;
            rdfs:domain :SubscriptionEntry ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Bit 2 of the Subscription Options represents the No Local option."@en ,
                         "No Local subscription option. If 1, the Server MUST NOT forward messages published by this Client back to it."@en ;
            rdfs:label "has No Local"@en ;
            <http://www.w3.org/2004/02/skos/core#example> "If the value is 1, Application Messages MUST NOT be forwarded to a connection with a ClientID equal to the ClientID of the publishing connection."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPacketIdentifier
:hasPacketIdentifier rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :PubackVariableHeader
                                                 :PubcompVariableHeader
                                                 :PublishVariableHeader
                                                 :PubrecVariableHeader
                                                 :PubrelVariableHeader
                                                 :SubackVariableHeader
                                                 :SubscribeVariableHeader
                                                 :UnsubackVariableHeader
                                                 :UnsubscribeVariableHeader
                                               )
                                 ] ;
                     rdfs:range xsd:unsignedShort ;
                     rdfs:comment "A 16-bit identifier used to correlate MQTT messages when QoS > 0."@en ;
                     rdfs:label "packet identifier"@en ;
                     <http://www.w3.org/2004/02/skos/core#example> "A PUBLISH packet MUST NOT contain a Packet Identifier if its QoS value is set to 0."@en ,
                                                                   "Each time a Client sends a new SUBSCRIBE, UNSUBSCRIBE,or PUBLISH (where QoS > 0) MQTT Control Packet it MUST assign it a non-zero Packet Identifier that is currently unused."@en ,
                                                                   "Each time a Server sends a new PUBLISH (with QoS > 0) MQTT Control Packet it MUST assign it a non zero Packet Identifier that is currently unused."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPassword
:hasPassword rdf:type owl:DatatypeProperty ;
             rdfs:domain :ConnectPayload ;
             rdfs:range [ rdf:type rdfs:Datatype ;
                          owl:unionOf ( xsd:base64Binary
                                        xsd:hexBinary
                                        xsd:string
                                      )
                        ] ;
             rdfs:comment "Password field in CONNECT payload. Binary Data present only if Password Flag=1."@en ;
             rdfs:label "has Password"@en ;
             <http://www.w3.org/2004/02/skos/core#example> "If the Password Flag is set to 0, a Password MUST NOT be present in the Payload."@en ,
                                                           "If the Password Flag is set to 1, a Password MUST be present in the Payload."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPasswordFlag
:hasPasswordFlag rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :hasConnectFlag ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:domain :ConnectVariableHeader ;
                 rdfs:range xsd:boolean ;
                 rdfs:comment "Password Flag in CONNECT Flags. If 1, a Password field is present in the CONNECT payload."@en ;
                 rdfs:label "has Password Flag"@en ;
                 <http://www.w3.org/2004/02/skos/core#example> "If the Password Flag is set to 0, a Password MUST NOT be present in the Payload."@en ,
                                                               "If the Password Flag is set to 1, a Password MUST be present in the Payload."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadContent
:hasPayloadContent rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :PublishPayload ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:unionOf ( xsd:base64Binary
                                              xsd:hexBinary
                                              xsd:string
                                            )
                              ] ;
                   rdfs:comment "Application Message Payload content (Binary Data; UTF-8 text if Payload Format Indicator=1)."@en ;
                   rdfs:label "has Payload content"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadFormatIndicator
:hasPayloadFormatIndicator rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf :hasProperty ,
                                              :hasWillProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( :PublishProperties
                                                       :WillProperties
                                                     )
                                       ] ;
                           rdfs:range xsd:boolean ;
                           rdfs:comment "Payload Format Indicator Property. Byte 0/1; 1 means payload is UTF-8 encoded text, 0 means unspecified binary."@en ;
                           rdfs:label "has Payload Format Indicator"@en ;
                           <http://www.w3.org/2004/02/skos/core#example> "A Server MUST send the Payload Format Indicator unaltered to all subscribers receiving the Application Message."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPayloadReasonCode
:hasPayloadReasonCode rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasReasonCode ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :SubackPayload
                                                  :UnsubackPayload
                                                )
                                  ] ;
                      rdfs:range [ rdf:type rdfs:Datatype ;
                                   owl:unionOf ( xsd:hexBinary
                                                 xsd:string
                                                 xsd:unsignedByte
                                               )
                                 ] ;
                      rdfs:comment "Reason Code carried in a packet payload when defined by MQTT 5.0 (one-byte reason value)."@en ;
                      rdfs:label "MQTT Reason Code in Payload"@en ;
                      <http://www.w3.org/2004/02/skos/core#example> """MQTT 5 Reason Codes

0 / 0x00: Success — CONNACK, PUBACK, PUBREC, PUBREL, PUBCOMP, UNSUBACK, AUTH
0 / 0x00: Normal disconnection — DISCONNECT
0 / 0x00: Granted QoS 0 — SUBACK
1 / 0x01: Granted QoS 1 — SUBACK
2 / 0x02: Granted QoS 2 — SUBACK
4 / 0x04: Disconnect with Will Message — DISCONNECT
16 / 0x10: No matching subscribers — PUBACK, PUBREC
17 / 0x11: No subscription existed — UNSUBACK
24 / 0x18: Continue authentication — AUTH
25 / 0x19: Re-authenticate — AUTH
128 / 0x80: Unspecified error — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
129 / 0x81: Malformed Packet — CONNACK, DISCONNECT
130 / 0x82: Protocol Error — CONNACK, DISCONNECT
131 / 0x83: Implementation specific error — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
132 / 0x84: Unsupported Protocol Version — CONNACK
133 / 0x85: Client Identifier not valid — CONNACK
134 / 0x86: Bad User Name or Password — CONNACK
135 / 0x87: Not authorized — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
136 / 0x88: Server unavailable — CONNACK
137 / 0x89: Server busy — CONNACK, DISCONNECT
138 / 0x8A: Banned — CONNACK
139 / 0x8B: Server shutting down — DISCONNECT
140 / 0x8C: Bad authentication method — CONNACK, DISCONNECT
141 / 0x8D: Keep Alive timeout — DISCONNECT
142 / 0x8E: Session taken over — DISCONNECT
143 / 0x8F: Topic Filter invalid — SUBACK, UNSUBACK, DISCONNECT
144 / 0x90: Topic Name invalid — CONNACK, PUBACK, PUBREC, DISCONNECT
145 / 0x91: Packet Identifier in use — PUBACK, PUBREC, SUBACK, UNSUBACK
146 / 0x92: Packet Identifier not found — PUBREL, PUBCOMP
147 / 0x93: Receive Maximum exceeded — DISCONNECT
148 / 0x94: Topic Alias invalid — DISCONNECT
149 / 0x95: Packet too large — CONNACK, DISCONNECT
150 / 0x96: Message rate too high — DISCONNECT
151 / 0x97: Quota exceeded — CONNACK, PUBACK, PUBREC, SUBACK, DISCONNECT
152 / 0x98: Administrative action — DISCONNECT
153 / 0x99: Payload format invalid — CONNACK, PUBACK, PUBREC, DISCONNECT
154 / 0x9A: Retain not supported — CONNACK, DISCONNECT
155 / 0x9B: QoS not supported — CONNACK, DISCONNECT
156 / 0x9C: Use another server — CONNACK, DISCONNECT
157 / 0x9D: Server moved — CONNACK, DISCONNECT
158 / 0x9E: Shared Subscriptions not supported — SUBACK, DISCONNECT
159 / 0x9F: Connection rate exceeded — CONNACK, DISCONNECT
160 / 0xA0: Maximum connect time — DISCONNECT
161 / 0xA1: Subscription Identifiers not supported — SUBACK, DISCONNECT
162 / 0xA2: Wildcard Subscriptions not supported — SUBACK, DISCONNECT"""@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPortNumber
:hasPortNumber rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Broker ;
               rdfs:range xsd:unsignedShort ;
               rdfs:comment "The TCP port on which an MQTT Broker listens."@en ;
               rdfs:label "MQTT Broker port"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "TCP ports 8883 and 1883 are registered with IANA for MQTT TLS and non-TLS communication respectively."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasProperty
:hasProperty rdf:type owl:DatatypeProperty ;
             rdfs:domain :Properties ;
             rdfs:range [ rdf:type rdfs:Datatype ;
                          owl:unionOf ( xsd:hexBinary
                                        xsd:string
                                        xsd:unsignedByte
                                      )
                        ] ;
             rdfs:comment "Property identifier or property carrier for MQTT 5.0. Each Property begins with a one-byte Identifier followed by a typed value."@en ;
             rdfs:label "has MQTT Property"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPropertyLength
:hasPropertyLength rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Properties
                                               :WillProperties
                                             )
                               ] ;
                   rdfs:range xsd:nonNegativeInteger ;
                   rdfs:comment "Property Length field preceding a Properties collection. Variable Byte Integer giving total length in bytes of following properties."@en ,
                                "The Property Length is encoded as a Variable Byte Integer. The Property Length does not include the bytes used to encode itself, but includes the length of the Properties. If there are no properties, this MUST be indicated by including a Property Length of zero."@en ;
                   rdfs:label "has MQTT Property Length"@en ;
                   <http://www.w3.org/2004/02/skos/core#example> "The length of Properties in the DISCONNECT packet Variable Header encoded as a Variable Byte Integer. If the Remaining Length is less than 2, a value of 0 is used."@en ,
                                                                 "The length of the Properties in the PUBACK packet Variable Header encoded as a Variable Byte Integer. If the Remaining Length is less than 4 there is no Property Length and the value of 0 is used."@en ,
                                                                 "The length of the Properties in the UNSUBACK packet Variable Header encoded as a Variable Byte Integer."@en ,
                                                                 "The length of the Properties in the Will Properties encoded as a Variable Byte Integer."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasProtocolName
:hasProtocolName rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :ConnectVariableHeader ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Protocol Name in CONNECT. UTF-8 string that MUST equal 'MQTT' for MQTT 5.0."@en ;
                 rdfs:label "has Protocol Name"@en ;
                 <http://www.w3.org/2004/02/skos/core#example> "The protocol name MUST be the UTF-8 String \"MQTT\". If the Server does not want to accept the CONNECT, and wishes to reveal that it is an MQTT Server it MAY send a CONNACK packet with Reason Code of 0x84 (Unsupported Protocol Version), and then it MUST close the Network Connection."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasProtocolVersion
:hasProtocolVersion rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :ConnectVariableHeader ;
                    rdfs:range xsd:unsignedByte ;
                    rdfs:comment "Protocol Version in CONNECT. One-byte value that MUST be 5 for MQTT 5.0."@en ;
                    rdfs:label "has Protocol Version"@en ;
                    <http://www.w3.org/2004/02/skos/core#example> "If the Protocol Version is not 5 and the Server does not want to accept the CONNECT packet, the Server MAY send a CONNACK packet with Reason Code 0x84 (Unsupported Protocol Version) and then MUST close the Network Connection."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPubackReasonCode
:hasPubackReasonCode rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf :hasVariableHeaderReasonCode ;
                     rdfs:domain :PubackVariableHeader ;
                     rdfs:range [ rdf:type rdfs:Datatype ;
                                  owl:unionOf ( xsd:hexBinary
                                                xsd:string
                                                xsd:unsignedByte
                                              )
                                ] ;
                     rdfs:comment "PUBACK Reason Code. One-byte value indicating result of QoS 1 PUBLISH processing."@en ;
                     rdfs:label "has Puback  Reason Code"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPubcompReasonCode
:hasPubcompReasonCode rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasVariableHeaderReasonCode ;
                      rdfs:domain :PubcompVariableHeader ;
                      rdfs:range [ rdf:type rdfs:Datatype ;
                                   owl:unionOf ( xsd:hexBinary
                                                 xsd:string
                                                 xsd:unsignedByte
                                               )
                                 ] ;
                      rdfs:comment "PUBCOMP Reason Code. One-byte value indicating completion of the QoS 2 flow."@en ;
                      rdfs:label "has Pubcomp Reason Code"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPubrecReasonCode
:hasPubrecReasonCode rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf :hasVariableHeaderReasonCode ;
                     rdfs:domain :PubrecVariableHeader ;
                     rdfs:range [ rdf:type rdfs:Datatype ;
                                  owl:unionOf ( xsd:hexBinary
                                                xsd:string
                                                xsd:unsignedByte
                                              )
                                ] ;
                     rdfs:comment "PUBREC Reason Code. One-byte value indicating result of QoS 2 PUBLISH receipt stage."@en ;
                     rdfs:label "has Pubrec Reason Code"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasPubrelReasonCode
:hasPubrelReasonCode rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf :hasVariableHeaderReasonCode ;
                     rdfs:domain :PubrelVariableHeader ;
                     rdfs:range [ rdf:type rdfs:Datatype ;
                                  owl:unionOf ( xsd:hexBinary
                                                xsd:string
                                                xsd:unsignedByte
                                              )
                                ] ;
                     rdfs:comment "PUBREL Reason Code. One-byte value indicating result of QoS 2 release stage."@en ;
                     rdfs:label "has Pubrel Reason Code"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasQoSLevel
:hasQoSLevel rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :hasFixedHeaderFlag ,
                                :hasSubscriptionOption ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :PublishFixedHeader
                                         :SubscriptionEntry
                                       )
                         ] ;
             rdfs:range [ rdf:type rdfs:Datatype ;
                          owl:onDatatype xsd:integer ;
                          owl:withRestrictions ( [ xsd:minInclusive 0
                                                 ]
                                                 [ xsd:maxInclusive 2
                                                 ]
                                               )
                        ] ;
             rdfs:comment "Not mapped to mqv:hasQoSFlag because MQV models QoS as an object property, while mqtt:hasQosLevel is a datatype property."@en ,
                          "The MQTT Quality of Service level (0 = at most once, 1 = at least once, 2 = exactly once)."@en ;
             rdfs:label "QoS level"@en ;
             <http://www.w3.org/2004/02/skos/core#example> """MQTT QoS levels:
0 — At most once
1 — At least once
2 — Exactly once"""@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasReasonCode
:hasReasonCode rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :AuthVariableHeader
                                           :ConnackVariableHeader
                                           :DisconnectVariableHeader
                                           :PubackVariableHeader
                                           :PubcompVariableHeader
                                           :PubrecVariableHeader
                                           :PubrelVariableHeader
                                           :SubackPayload
                                           :UnsubackPayload
                                         )
                           ] ;
               rdfs:range [ rdf:type rdfs:Datatype ;
                            owl:unionOf ( xsd:hexBinary
                                          xsd:string
                                          xsd:unsignedByte
                                        )
                          ] ;
               rdfs:comment "\"The CONNACK, PUBACK, PUBREC, PUBREL, PUBCOMP, DISCONNECT and AUTH Control Packets have a single Reason Code as part of the Variable Header. The SUBACK and UNSUBACK packets contain a list of one or more Reason Codes in the Payload."@en ,
                            "A Reason Code is a one byte unsigned value that indicates the result of an operation. Reason Codes less than 0x80 indicate successful completion of an operation. The normal Reason Code for success is 0. Reason Code values of 0x80 or greater indicate failure."@en ,
                            "Generic MQTT Reason Code. One-byte value indicating success or the reason for failure in many packet types."@en ;
               rdfs:label "MQTT ReasonCode"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasReasonString
:hasReasonString rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :hasProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :AuthProperties
                                             :ConnackProperties
                                             :DisconnectProperties
                                             :PubackProperties
                                             :PubcompProperties
                                             :PubrecProperties
                                             :PubrelProperties
                                             :SubackProperties
                                             :UnsubackProperties
                                           )
                             ] ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Reason String Property. UTF-8 string providing human-readable diagnostics for a Reason Code."@en ;
                 rdfs:label "has Reason String"@en ;
                 <http://www.w3.org/2004/02/skos/core#example> "The sender MUST NOT send this property if it would increase the size of the PUBACK packet beyond the Maximum Packet Size specified by the receiver."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasReceiveMaximum
:hasReceiveMaximum rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :hasProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :ConnackProperties
                                               :ConnectProperties
                                             )
                               ] ;
                   rdfs:range xsd:unsignedShort ;
                   rdfs:comment "Receive Maximum Property. Two Byte Integer (non-zero) limiting concurrent QoS 1/2 PUBLISH in-flight."@en ;
                   rdfs:label "has Receive Maximum"@en ;
                   <http://www.w3.org/2004/02/skos/core#example> "33 (0x21) Byte, Identifier of the Receive Maximum. Followed by the Two Byte Integer representing the Receive Maximum value. It is a Protocol Error to include the Receive Maximum value more than once or for it to have the value 0."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasRemainingLength
:hasRemainingLength rdf:type owl:DatatypeProperty ;
                    rdfs:domain :FixedHeader ;
                    rdfs:range xsd:byte ;
                    rdfs:comment "The Remaining Length is a Variable Byte Integer that represents the number of bytes remaining within the current Control Packet, including data in the Variable Header and the Payload. The Remaining Length does not include the bytes used to encode the Remaining Length. The packet size is the total number of bytes in an MQTT Control Packet, this is equal to the length of the Fixed Header plus the Remaining Length."@en ,
                                 "This is the length of the Variable Header (plus the length of the Payload), encoded as a Variable Byte Integer."@en ;
                    rdfs:label "Remaining Length of MQTT Control Packet "@en ;
                    <http://www.w3.org/2004/02/skos/core#example> "PUBACK: This is the length of the Variable Header, encoded as a Variable Byte Integer."@en ,
                                                                  "PUBLISH: This is the length of Variable Header plus the length of the Payload, encoded as a Variable Byte Integer."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasRequestProblemInformation
:hasRequestProblemInformation rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf :hasProperty ;
                              rdf:type owl:FunctionalProperty ;
                              rdfs:domain :ConnectProperties ;
                              rdfs:range xsd:boolean ;
                              rdfs:comment "Request Problem Information Property in CONNECT. Byte 0/1 indicating whether the Server should include Reason String/User Properties on errors."@en ;
                              rdfs:label "has Request Problem Information"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasRequestResponseInformation
:hasRequestResponseInformation rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf :hasProperty ;
                               rdf:type owl:FunctionalProperty ;
                               rdfs:domain :ConnectProperties ;
                               rdfs:range xsd:boolean ;
                               rdfs:comment "Request Response Information Property in CONNECT. Byte 0/1 indicating whether the Server should return Response Information in CONNACK."@en ;
                               rdfs:label "has Request Response Information"@en ;
                               <http://www.w3.org/2004/02/skos/core#example> "A value of 0 indicates that the Server MUST NOT return Response Information."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasResponseInformation
:hasResponseInformation rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf :hasProperty ;
                        rdf:type owl:FunctionalProperty ;
                        rdfs:domain :ConnackProperties ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Response Information Property. UTF-8 string providing response metadata for request/response patterns."@en ;
                        rdfs:label "has Response Information"@en ;
                        <http://www.w3.org/2004/02/skos/core#example> "25 (0x19) Byte, Identifier of the Request Response Information. Followed by a Byte with a value of either 0 or 1.  A value of 0 indicates that the Server MUST NOT return Response Information. If the value is 1 the Server MAY return Response Information in the CONNACK packet."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasRetainAsPublished
:hasRetainAsPublished rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasSubscriptionOption ;
                      rdfs:domain :SubscriptionEntry ;
                      rdfs:range xsd:boolean ;
                      rdfs:comment "Retain As Published subscription option. If 1, forwarded messages keep the original RETAIN flag."@en ;
                      rdfs:label "has Retain As Published"@en ;
                      <http://www.w3.org/2004/02/skos/core#example> "If the value of Retain As Published subscription option is set to 0, the Server MUST set the RETAIN flag to 0 when forwarding an Application Message regardless of how the RETAIN flag was set in the received PUBLISH packet. If the value of Retain As Published subscription option is set to 1, the Server MUST set the RETAIN flag equal to the RETAIN flag in the received PUBLISH packet."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasRetainAvailable
:hasRetainAvailable rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :hasProperty ;
                    rdf:type owl:FunctionalProperty ;
                    rdfs:domain :ConnackProperties ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Retain Available Property in CONNACK. Byte 0/1 indicating whether retained messages are supported."@en ;
                    rdfs:label "has Retain Available"@en ;
                    <http://www.w3.org/2004/02/skos/core#example> "A Client receiving Retain Available set to 0 from the Server MUST NOT send a PUBLISH packet with the RETAIN flag set to 1."@en ,
                                                                  "If a Server receives a CONNECT packet containing a Will Message with the Will Retain set to 1, and it does not support retained messages, the Server MUST reject the connection request. It SHOULD send CONNACK with Reason Code 0x9A (Retain not supported) and then it MUST close the Network Connection."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasRetainFlag
:hasRetainFlag rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :hasFixedHeaderFlag ;
               rdfs:domain :PublishFixedHeader ;
               rdfs:range xsd:boolean ;
               rdfs:comment "True if the message should be retained on the MQTT Broker."@en ;
               rdfs:label "RETAIN flag"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "If the RETAIN flag is 0 in a PUBLISH packet sent by a Client to a Server, the Server MUST NOT store the message as a retained message and MUST NOT remove or replace any existing retained message."@en ,
                                                             "If the RETAIN flag is set to 1 in a PUBLISH packet sent by a Client to a Server, the Server MUST replace any existing retained message for this topic and store the Application Message."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasRetainHandling
:hasRetainHandling rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :hasSubscriptionOption ;
                   rdfs:domain :SubscriptionEntry ;
                   rdfs:range xsd:unsignedByte ;
                   rdfs:comment "Retain Handling subscription option. Two-bit field: 0=send retained, 1=send retained only if subscription new, 2=do not send retained."@en ;
                   rdfs:label "has Retain Handling"@en ;
                   <http://www.w3.org/2004/02/skos/core#example> "If Retain Handling is set to 0 the Server MUST send the retained messages matching the Topic Filter of the subscription to the Client."@en ,
                                                                 "If Retain Handling is set to 1 then if the subscription did not already exist, the Server MUST send all retained message matching the Topic Filter of the subscription to the Client, and if the subscription did exist the Server MUST NOT send the retained messages."@en ,
                                                                 "If Retain Handling is set to 2, the Server MUST NOT send the retained messages."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasServerKeepAlive
:hasServerKeepAlive rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :hasProperty ;
                    rdf:type owl:FunctionalProperty ;
                    rdfs:domain :ConnackProperties ;
                    rdfs:range xsd:unsignedShort ;
                    rdfs:comment "Server Keep Alive Property in CONNACK. Two Byte Integer seconds overriding the Client Keep Alive for this connection."@en ;
                    rdfs:label "has Server Keep Alive"@en ;
                    <http://www.w3.org/2004/02/skos/core#example> "If the Server does not send the Server Keep Alive, the Server MUST use the Keep Alive value set by the Client on CONNECT."@en ,
                                                                  "If the Server sends a Server Keep Alive on the CONNACK packet, the Client MUST use this value instead of the Keep Alive value the Client sent on CONNECT."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasServerReference
:hasServerReference rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :hasProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :ConnackProperties
                                                :DisconnectProperties
                                              )
                                ] ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Server Reference Property. UTF-8 string suggesting an alternate Server the Client may use."@en ;
                    rdfs:label "has Server Reference"@en ;
                    <http://www.w3.org/2004/02/skos/core#example> "Followed by a UTF-8 Encoded String which can be used by the Client to identify another Server to use."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasSessionExpiryInterval
:hasSessionExpiryInterval rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf :hasProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( :ConnackProperties
                                                      :ConnectProperties
                                                      :DisconnectProperties
                                                    )
                                      ] ;
                          rdfs:range xsd:unsignedInt ;
                          rdfs:comment "Session Expiry Interval Property. Four Byte Integer seconds defining session lifetime after disconnect."@en ;
                          rdfs:label "has Session Expiry Interval"@en ;
                          <http://www.w3.org/2004/02/skos/core#example> "The Session Expiry Interval MUST NOT be sent on a DISCONNECT by the Server."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasSessionPresentFlag
:hasSessionPresentFlag rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf :hasConnackFlag ;
                       rdf:type owl:FunctionalProperty ;
                       rdfs:domain :ConnackVariableHeader ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Session Present flag in CONNACK. If 1, a prior Session exists and is resumed."@en ;
                       rdfs:label "has Session Present Flag"@en ;
                       <http://www.w3.org/2004/02/skos/core#example> "If the Server accepts a connection with Clean Start set to 0 and the Server has Session State for the ClientID, it MUST set Session Present to 1 in the CONNACK packet, otherwise it MUST set Session Present to 0 in the CONNACK packet. In both cases it MUST set a 0x00 (Success) Reason Code in the CONNACK packet."@en ,
                                                                     "If the Server accepts a connection with Clean Start set to 1, the Server MUST set Session Present to 0 in the CONNACK packet in addition to setting a 0x00 (Success) Reason Code in the CONNACK packet."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasSharedSubscriptionAvailable
:hasSharedSubscriptionAvailable rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf :hasProperty ;
                                rdf:type owl:FunctionalProperty ;
                                rdfs:domain :ConnackProperties ;
                                rdfs:range xsd:boolean ;
                                rdfs:comment "Shared Subscription Available Property in CONNACK. Byte 0/1 indicating server support for shared subscriptions."@en ;
                                rdfs:label "has Shared Subscription Available"@en ;
                                <http://www.w3.org/2004/02/skos/core#example> "Followed by a Byte field. If present, this byte declares whether the Server supports Shared Subscriptions. A value is 0 means that Shared Subscriptions are not supported. A value of 1 means Shared Subscriptions are supported."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasSubackReasonCode
:hasSubackReasonCode rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf :hasPayloadReasonCode ;
                     rdfs:domain :SubackPayload ;
                     rdfs:range [ rdf:type rdfs:Datatype ;
                                  owl:unionOf ( xsd:hexBinary
                                                xsd:string
                                                xsd:unsignedByte
                                              )
                                ] ;
                     rdfs:comment "SUBACK Reason Code. One-byte value per subscription indicating success or reason for failure."@en ;
                     rdfs:label "has Suback Reason Code"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionIdentifier
:hasSubscriptionIdentifier rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf :hasProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( :PublishProperties
                                                       :SubscribeProperties
                                                     )
                                       ] ;
                           rdfs:range xsd:nonNegativeInteger ;
                           rdfs:comment "Subscription Identifier Property. Variable Byte Integer (value > 0) identifying a subscription; returned in PUBLISH as applicable."@en ;
                           rdfs:label "has Subscription Identifier"@en ;
                           <http://www.w3.org/2004/02/skos/core#example> "The Subscription Identifier can have the value of 1 to 268,435,455."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionIdentifierAvailable
:hasSubscriptionIdentifierAvailable rdf:type owl:DatatypeProperty ;
                                    rdfs:subPropertyOf :hasProperty ;
                                    rdf:type owl:FunctionalProperty ;
                                    rdfs:domain :ConnackProperties ;
                                    rdfs:range xsd:boolean ;
                                    rdfs:comment "Subscription Identifier Available Property in CONNACK. Byte 0/1 indicating support for Subscription Identifiers."@en ;
                                    rdfs:label "has Subscription Identifier Available"@en ;
                                    <http://www.w3.org/2004/02/skos/core#example> "If present, this byte declares whether the Server supports Subscription Identifiers. A value is 0 means that Subscription Identifiers are not supported. A value of 1 means Subscription Identifiers are supported."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasSubscriptionOption
:hasSubscriptionOption rdf:type owl:DatatypeProperty ;
                       rdfs:domain :SubscriptionEntry ;
                       rdfs:range xsd:unsignedByte ;
                       rdfs:comment "Subscription Options byte for a Topic Filter in SUBSCRIBE. Encodes QoS, No Local, Retain As Published, and Retain Handling."@en ;
                       rdfs:label "has Subscription Option"@en ;
                       <http://www.w3.org/2004/02/skos/core#example> "Bits 0 and 1 of the Subscription Options represent Maximum QoS field. This gives the maximum QoS level at which the Server can send Application Messages to the Client. It is a Protocol Error if the Maximum QoS field has the value 3."@en ,
                                                                     """Bits 0-1: Maximum QoS
0 = QoS 0
1 = QoS 1
2 = QoS 2
3 = Protocol Error

Bit 2: No Local
0 = Forward messages normally
1 = Do not forward messages from the same ClientID

Bit 3: Retain As Published
0 = Forwarded messages have RETAIN set to 0
1 = Forwarded messages keep the published RETAIN flag

Bits 4-5: Retain Handling
0 = Send retained messages at the time of subscribe
1 = Send retained messages only if the subscription does not already exist
2 = Do not send retained messages at subscribe
3 = Protocol Error

Bits 6-7: Reserved
Must be 0; otherwise the SUBSCRIBE packet is malformed."""@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasTopicAlias
:hasTopicAlias rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :hasProperty ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :PublishProperties
                                           :Topic
                                         )
                           ] ;
               rdfs:range xsd:unsignedShort ;
               rdfs:comment "Topic Alias Property in PUBLISH. Two Byte Integer (non-zero) alias for Topic Name."@en ;
               rdfs:label "has Topic Alias"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "A Client MUST NOT send a PUBLISH packet with a Topic Alias greater than the Topic Alias Maximum value returned by the Server in the CONNACK packet. A Client MUST accept all Topic Alias values greater than 0 and less than or equal to the Topic Alias Maximum value that it sent in the CONNECT packet."@en ,
                                                             "A Server MUST NOT send a PUBLISH packet with a Topic Alias greater than the Topic Alias Maximum value sent by the Client in the CONNECT packet. A Server MUST accept all Topic Alias values greater than 0 and less than or equal to the Topic Alias Maximum value that it returned in the CONNACK packet."@en ,
                                                             "A sender MUST NOT send a PUBLISH packet containing a Topic Alias which has the value 0."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasTopicAliasMaximum
:hasTopicAliasMaximum rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :ConnackProperties
                                                  :ConnectProperties
                                                )
                                  ] ;
                      rdfs:range xsd:unsignedShort ;
                      rdfs:comment "Topic Alias Maximum Property. Two Byte Integer indicating the maximum Topic Alias value accepted."@en ;
                      rdfs:label "has Topic Alias Maximum"@en ;
                      <http://www.w3.org/2004/02/skos/core#example> "The Server MUST NOT send a Topic Alias in a PUBLISH packet to the Client greater than Topic Alias Maximum."@en ,
                                                                    "Topic Alias Maximum is absent or zero, the Server MUST NOT send any Topic Aliases to the Client."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasUnsubackReasonCode
:hasUnsubackReasonCode rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf :hasPayloadReasonCode ;
                       rdfs:domain :UnsubackPayload ;
                       rdfs:range [ rdf:type rdfs:Datatype ;
                                    owl:unionOf ( xsd:hexBinary
                                                  xsd:string
                                                  xsd:unsignedByte
                                                )
                                  ] ;
                       rdfs:comment "UNSUBACK Reason Code. One-byte value per topic filter indicating unsubscribe success or failure."@en ;
                       rdfs:label "has Unsuback Reason Code"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasUserName
:hasUserName rdf:type owl:DatatypeProperty ;
             rdfs:domain :ConnectPayload ;
             rdfs:range xsd:string ;
             rdfs:comment "User Name in CONNECT payload. UTF-8 string present only if User Name Flag=1."@en ;
             rdfs:label "has User Name"@en ;
             <http://www.w3.org/2004/02/skos/core#example> "The User Name MUST be a UTF-8 Encoded String."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasUserNameFlag
:hasUserNameFlag rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :hasConnectFlag ;
                 rdfs:domain :ConnectVariableHeader ;
                 rdfs:range xsd:boolean ;
                 rdfs:comment "User Name Flag in CONNECT Flags. If 1, User Name is present in CONNECT payload."@en ;
                 rdfs:label "has Username Flag"@en ;
                 <http://www.w3.org/2004/02/skos/core#example> "If the User Name Flag is set to 1, a User Name MUST be present in the Payload."@en ,
                                                               "f the User Name Flag is set to 0, a User Name MUST NOT be present in the Payload."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasUserPropertyName
:hasUserPropertyName rdf:type owl:DatatypeProperty ;
                     rdfs:domain :UserProperty ;
                     rdfs:range xsd:string ;
                     rdfs:comment "User Property Name (first UTF-8 string of a User Property string pair)."@en ;
                     rdfs:label "has User Propery Name"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasUserPropertyValue
:hasUserPropertyValue rdf:type owl:DatatypeProperty ;
                      rdfs:domain :UserProperty ;
                      rdfs:range xsd:string ;
                      rdfs:comment "User Property Value (second UTF-8 string of a User Property string pair)."@en ;
                      rdfs:label "has User Property Value"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasVariableHeaderReasonCode
:hasVariableHeaderReasonCode rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf :hasReasonCode ;
                             rdf:type owl:FunctionalProperty ;
                             rdfs:domain [ rdf:type owl:Class ;
                                           owl:unionOf ( :AuthVariableHeader
                                                         :ConnackVariableHeader
                                                         :DisconnectVariableHeader
                                                         :PubackVariableHeader
                                                         :PubcompVariableHeader
                                                         :PubrecVariableHeader
                                                         :PubrelVariableHeader
                                                       )
                                         ] ;
                             rdfs:range [ rdf:type rdfs:Datatype ;
                                          owl:unionOf ( xsd:hexBinary
                                                        xsd:string
                                                        xsd:unsignedByte
                                                      )
                                        ] ;
                             rdfs:comment "Reason Code carried in a packet variable header when defined by MQTT 5.0 (one-byte reason value)."@en ;
                             rdfs:label "MQTT Reason Code in Variable Header"@en ;
                             <http://www.w3.org/2004/02/skos/core#example> """MQTT 5 Reason Codes

0 / 0x00: Success — CONNACK, PUBACK, PUBREC, PUBREL, PUBCOMP, UNSUBACK, AUTH
0 / 0x00: Normal disconnection — DISCONNECT
0 / 0x00: Granted QoS 0 — SUBACK
1 / 0x01: Granted QoS 1 — SUBACK
2 / 0x02: Granted QoS 2 — SUBACK
4 / 0x04: Disconnect with Will Message — DISCONNECT
16 / 0x10: No matching subscribers — PUBACK, PUBREC
17 / 0x11: No subscription existed — UNSUBACK
24 / 0x18: Continue authentication — AUTH
25 / 0x19: Re-authenticate — AUTH
128 / 0x80: Unspecified error — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
129 / 0x81: Malformed Packet — CONNACK, DISCONNECT
130 / 0x82: Protocol Error — CONNACK, DISCONNECT
131 / 0x83: Implementation specific error — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
132 / 0x84: Unsupported Protocol Version — CONNACK
133 / 0x85: Client Identifier not valid — CONNACK
134 / 0x86: Bad User Name or Password — CONNACK
135 / 0x87: Not authorized — CONNACK, PUBACK, PUBREC, SUBACK, UNSUBACK, DISCONNECT
136 / 0x88: Server unavailable — CONNACK
137 / 0x89: Server busy — CONNACK, DISCONNECT
138 / 0x8A: Banned — CONNACK
139 / 0x8B: Server shutting down — DISCONNECT
140 / 0x8C: Bad authentication method — CONNACK, DISCONNECT
141 / 0x8D: Keep Alive timeout — DISCONNECT
142 / 0x8E: Session taken over — DISCONNECT
143 / 0x8F: Topic Filter invalid — SUBACK, UNSUBACK, DISCONNECT
144 / 0x90: Topic Name invalid — CONNACK, PUBACK, PUBREC, DISCONNECT
145 / 0x91: Packet Identifier in use — PUBACK, PUBREC, SUBACK, UNSUBACK
146 / 0x92: Packet Identifier not found — PUBREL, PUBCOMP
147 / 0x93: Receive Maximum exceeded — DISCONNECT
148 / 0x94: Topic Alias invalid — DISCONNECT
149 / 0x95: Packet too large — CONNACK, DISCONNECT
150 / 0x96: Message rate too high — DISCONNECT
151 / 0x97: Quota exceeded — CONNACK, PUBACK, PUBREC, SUBACK, DISCONNECT
152 / 0x98: Administrative action — DISCONNECT
153 / 0x99: Payload format invalid — CONNACK, PUBACK, PUBREC, DISCONNECT
154 / 0x9A: Retain not supported — CONNACK, DISCONNECT
155 / 0x9B: QoS not supported — CONNACK, DISCONNECT
156 / 0x9C: Use another server — CONNACK, DISCONNECT
157 / 0x9D: Server moved — CONNACK, DISCONNECT
158 / 0x9E: Shared Subscriptions not supported — SUBACK, DISCONNECT
159 / 0x9F: Connection rate exceeded — CONNACK, DISCONNECT
160 / 0xA0: Maximum connect time — DISCONNECT
161 / 0xA1: Subscription Identifiers not supported — SUBACK, DISCONNECT
162 / 0xA2: Wildcard Subscriptions not supported — SUBACK, DISCONNECT"""@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasWildcardSubscriptionAvailable
:hasWildcardSubscriptionAvailable rdf:type owl:DatatypeProperty ;
                                  rdfs:subPropertyOf :hasProperty ;
                                  rdf:type owl:FunctionalProperty ;
                                  rdfs:domain :ConnackProperties ;
                                  rdfs:range xsd:boolean ;
                                  rdfs:comment "Wildcard Subscription Available Property in CONNACK. Byte 0/1 indicating support for wildcard topic filters."@en ;
                                  rdfs:label "has Wildcard Subscription Available"@en ;
                                  <http://www.w3.org/2004/02/skos/core#example> "If a new Network Connection to this Session is made before the Will Delay Interval has passed, the Server MUST NOT send the Will Message."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasWillDelayInterval
:hasWillDelayInterval rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :hasProperty ;
                      rdf:type owl:FunctionalProperty ;
                      rdfs:domain :WillProperties ;
                      rdfs:range xsd:unsignedInt ;
                      rdfs:comment "Will Delay Interval Property. Four Byte Integer seconds delaying Will publication after connection loss."@en ;
                      rdfs:label "has Will Delay Interval"@en ;
                      <http://www.w3.org/2004/02/skos/core#example> "If a new Network Connection to this Session is made before the Will Delay Interval has passed, the Server MUST NOT send the Will Message"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasWillFlag
:hasWillFlag rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :hasConnectFlag ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain :ConnectVariableHeader ;
             rdfs:range xsd:boolean ;
             rdfs:comment "Will Flag in CONNECT Flags. If 1, Will Properties/Topic/Payload are present."@en ;
             rdfs:label "has Will Flag"@en ;
             <http://www.w3.org/2004/02/skos/core#example> "If the Will Flag is set to 1 this indicates that a Will Message MUST be stored on the Server and associated with the Session."@en ,
                                                           "If the Will Flag is set to 1, the Will Properties, Will Topic, and Will Payload fields MUST be present in the Payload."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasWillPayload
:hasWillPayload rdf:type owl:DatatypeProperty ;
                rdfs:domain :ConnectPayload ;
                rdfs:range [ rdf:type rdfs:Datatype ;
                             owl:unionOf ( xsd:base64Binary
                                           xsd:hexBinary
                                           xsd:string
                                         )
                           ] ;
                rdfs:comment "Will Payload in CONNECT payload. Binary Data constituting the Will Message payload."@en ;
                rdfs:label "has Will Payload"@en ;
                <http://www.w3.org/2004/02/skos/core#example> "The Will Payload defines the Application Message Payload that is to be published to the Will Topic."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasWillProperty
:hasWillProperty rdf:type owl:DatatypeProperty ;
                 rdfs:domain :WillProperties ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:unionOf ( xsd:base64Binary
                                            xsd:hexBinary
                                          )
                            ] ;
                 rdfs:comment "Will Properties container in CONNECT payload. Set of MQTT 5.0 Properties applying to the Will Message."@en ;
                 rdfs:label "has MQTT Will Property"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasWillQoS
:hasWillQoS rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :hasConnectFlag ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain :ConnectVariableHeader ;
            rdfs:range xsd:unsignedByte ;
            rdfs:comment "Will QoS in CONNECT Flags. Two-bit field with values 0, 1, or 2 for the Will Message QoS."@en ;
            rdfs:label "has Will QoS"@en ;
            <http://www.w3.org/2004/02/skos/core#example> "If the Will Flag is set to 0, then the Will QoS MUST be set to 0 (0x00)."@en ,
                                                          "If the Will Flag is set to 1, the value of Will QoS can be 0 (0x00), 1 (0x01), or 2 (0x02)."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hasWillRetain
:hasWillRetain rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :hasConnectFlag ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :ConnectVariableHeader ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Will Retain in CONNECT Flags. If 1, the Will Message is published as retained."@en ;
               rdfs:label "has Will Retain"@en ;
               <http://www.w3.org/2004/02/skos/core#example> "If the Will Flag is set to 0, then Will Retain MUST be set to 0."@en ,
                                                             "If the Will Flag is set to 1 and Will Retain is set to 0, the Server MUST publish the Will Message as a non-retained message."@en ,
                                                             "If the Will Flag is set to 1 and Will Retain is set to 1, the Server MUST publish the Will Message as a retained message."@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#usesTLS
:usesTLS rdf:type owl:DatatypeProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :NetworkConnection ;
         rdfs:range xsd:boolean ;
         rdfs:comment "True if the Network Connection is protected via TLS, otherwise false."@en ;
         rdfs:label "uses TLS"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/vocommons/voaf#Vocabulary
<http://purl.org/vocommons/voaf#Vocabulary> rdf:type owl:Class .


###  http://qudt.org/schema/qudt/AbstractQuantityKind
<http://qudt.org/schema/qudt/AbstractQuantityKind> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://www.w3.org/2004/02/skos/core#broader> ;
                                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind>
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://qudt.org/schema/qudt/latexSymbol> ;
                                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                   ] ;
                                                   rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                   rdfs:label "Quantity Kind (abstract)" .


###  http://qudt.org/schema/qudt/AngleUnit
<http://qudt.org/schema/qudt/AngleUnit> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://qudt.org/schema/qudt/DimensionlessUnit> .


###  http://qudt.org/schema/qudt/Aspect
<http://qudt.org/schema/qudt/Aspect> rdf:type owl:Class .


###  http://qudt.org/schema/qudt/AspectClass
<http://qudt.org/schema/qudt/AspectClass> rdf:type owl:Class ;
                                          rdfs:subClassOf rdfs:Class ;
                                          rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                          rdfs:label "Aspect Class" .


###  http://qudt.org/schema/qudt/BaseDimensionMagnitude
<http://qudt.org/schema/qudt/BaseDimensionMagnitude> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://qudt.org/schema/qudt/hasBaseQuantityKind> ;
                                                                       owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://qudt.org/schema/qudt/hasBaseQuantityKind> ;
                                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://qudt.org/schema/qudt/hasBaseQuantityKind> ;
                                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://qudt.org/schema/qudt/hasBaseQuantityKind> ;
                                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://qudt.org/schema/qudt/vectorMagnitude> ;
                                                                       owl:allValuesFrom xsd:float
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://qudt.org/schema/qudt/vectorMagnitude> ;
                                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://qudt.org/schema/qudt/vectorMagnitude> ;
                                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://qudt.org/schema/qudt/vectorMagnitude> ;
                                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ;
                                                     <http://purl.org/dc/terms/description> """
  <p>A <em>Dimension</em> expresses a magnitude for a base quantity kind such as mass, length and time.
  </p>
  <p>DEPRECATED - each exponent is expressed as a property. 
  Keep until a validation of this has been done.
  </p>"""^^rdf:HTML ;
                                                     <http://qudt.org/schema/qudt/informativeReference> "http://web.mit.edu/2.25/www/pdf/DA_unified.pdf"^^xsd:anyURI ,
                                                                                                        "https://en.wikipedia.org/wiki/Dimensional_analysis"^^xsd:anyURI ;
                                                     rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                     rdfs:label "Base Dimension Magnitude" .


###  http://qudt.org/schema/qudt/BinaryPrefix
<http://qudt.org/schema/qudt/BinaryPrefix> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://qudt.org/schema/qudt/Prefix> ;
                                           <http://purl.org/dc/terms/description> """
  <p>A <em>Binary Prefix</em> is a prefix for multiples of units in data processing, data transmission, and digital information,
   notably the bit and the byte, to indicate multiplication by a power of 2.
   </p>
  """^^rdf:HTML ;
                                           rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                           rdfs:label "Binary Prefix" .


###  http://qudt.org/schema/qudt/Citation
<http://qudt.org/schema/qudt/Citation> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://qudt.org/schema/qudt/url> ;
                                                         owl:allValuesFrom xsd:anyURI
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/dc/terms/description> ;
                                                         owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/dc/terms/description> ;
                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/dc/terms/description> ;
                                                         owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://qudt.org/schema/qudt/url> ;
                                                         owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                       ] ;
                                       <http://purl.org/dc/terms/description> "Provides a simple way of making citations."^^rdf:HTML ;
                                       rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                       rdfs:label "Citation" .


###  http://qudt.org/schema/qudt/Comment
<http://qudt.org/schema/qudt/Comment> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://qudt.org/schema/qudt/Verifiable> ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/rationale> ;
                                                        owl:allValuesFrom rdf:HTML
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/rationale> ;
                                                        owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://purl.org/dc/terms/description> ;
                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                      ] ;
                                      rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                      rdfs:label "Comment" .


###  http://qudt.org/schema/qudt/Concept
<http://qudt.org/schema/qudt/Concept> rdf:type owl:Class ;
                                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/abbreviation> ;
                                                        owl:allValuesFrom xsd:string
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/deprecatedInVersion> ;
                                                        owl:allValuesFrom xsd:string
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/exactMatch> ;
                                                        owl:allValuesFrom <http://qudt.org/schema/qudt/Concept>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/guidance> ;
                                                        owl:allValuesFrom rdf:HTML
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/hasRule> ;
                                                        owl:allValuesFrom <http://qudt.org/schema/qudt/Rule>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/id> ;
                                                        owl:allValuesFrom xsd:string
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/deprecated> ;
                                                        owl:allValuesFrom xsd:boolean
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/abbreviation> ;
                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/deprecated> ;
                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/deprecatedInVersion> ;
                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://qudt.org/schema/qudt/id> ;
                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                      ] ;
                                      <http://purl.org/dc/terms/description> "The root class for all QUDT concepts."^^rdf:HTML ;
                                      rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                      rdfs:label "QUDT Concept" .


###  http://qudt.org/schema/qudt/ConstantValue
<http://qudt.org/schema/qudt/ConstantValue> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityValue> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/exactConstant> ;
                                                              owl:allValuesFrom xsd:boolean
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/exactConstant> ;
                                                              owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                            ] ;
                                            <http://purl.org/dc/terms/description> "Used to specify the values of a constant."^^rdf:HTML ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                            rdfs:label "Constant value" .


###  http://qudt.org/schema/qudt/ContextualUnit
<http://qudt.org/schema/qudt/ContextualUnit> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://qudt.org/schema/qudt/Unit> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://www.w3.org/2004/02/skos/core#broader> ;
                                                               owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                             ] ;
                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                             rdfs:label "Contextual Unit" .


###  http://qudt.org/schema/qudt/CountingUnit
<http://qudt.org/schema/qudt/CountingUnit> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://qudt.org/schema/qudt/DimensionlessUnit> ;
                                           <http://purl.org/dc/terms/description> """
  <p>A <em>Counting Unit</em> is used for all units that express counts. 
  Examples are Atomic Number, Number, Number per Year, Percent and Sample per Second.
  </p>
  """^^rdf:HTML ;
                                           rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                           rdfs:label "Counting Unit" .


###  http://qudt.org/schema/qudt/CurrencyUnit
<http://qudt.org/schema/qudt/CurrencyUnit> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://qudt.org/schema/qudt/DimensionlessUnit> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/currencyCode> ;
                                                             owl:allValuesFrom xsd:string
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/currencyNumber> ;
                                                             owl:allValuesFrom xsd:string
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/currencyExponent> ;
                                                             owl:allValuesFrom xsd:integer
                                                           ] ;
                                           <http://purl.org/dc/terms/description> """
  Currency Units have their own subclass of unit because:
   (a) they have additional properties such as 'country' and
   (b) their URIs do not conform to the same rules as other units.
  """^^rdf:HTML ;
                                           rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                           rdfs:label "Currency Unit" .


###  http://qudt.org/schema/qudt/DataItem
<http://qudt.org/schema/qudt/DataItem> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ;
                                       <http://purl.org/dc/terms/description> """
  <p>A <em>Data Item</em> holds a value that maybe a scalar or structured datatype.
  <em>Quantity Value</em> specifies which case applies.
  </p>"""^^rdf:HTML ;
                                       rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                       rdfs:label "Data Item" .


###  http://qudt.org/schema/qudt/Datatype
<http://qudt.org/schema/qudt/Datatype> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ;
                                       <http://purl.org/dc/terms/description> """
   <p>A <em>Datatype</em> is a definition of the type of the \"value\" of a data item (for example, \"all integers between 0 and 10\"),
   and the allowable operations on those values; the meaning of the data; and the way values of that type can be stored. 
  Some types are primitive - built-in to the language, with no visible internal structure.
  For example \"Boolean\"; others are composite - constructed from one or more other types (of either kind).
  For example lists, arrays, structures, unions. 
  Some languages provide strong typing, others allow implicit type conversion and/or explicit type conversion.
  </p>"""^^rdf:HTML ;
                                       rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                       rdfs:label "Datatype" .


###  http://qudt.org/schema/qudt/DecimalPrefix
<http://qudt.org/schema/qudt/DecimalPrefix> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://qudt.org/schema/qudt/Prefix> ;
                                            <http://purl.org/dc/terms/description> """
  A <em>Decimal Prefix</em> is a prefix for multiples of units that are powers of 10.
  """ ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                            rdfs:label "Decimal Prefix" .


###  http://qudt.org/schema/qudt/DerivedUnit
<http://qudt.org/schema/qudt/DerivedUnit> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://qudt.org/schema/qudt/Unit> .


###  http://qudt.org/schema/qudt/DigitalCurrencyUnit
<http://qudt.org/schema/qudt/DigitalCurrencyUnit> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://qudt.org/schema/qudt/CurrencyUnit> ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://qudt.org/schema/qudt/blockchainNetwork> ;
                                                                    owl:allValuesFrom xsd:string
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://qudt.org/schema/qudt/currencyCode> ;
                                                                    owl:allValuesFrom xsd:string
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://qudt.org/schema/qudt/hasDTICode> ;
                                                                    owl:allValuesFrom xsd:string
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://qudt.org/schema/qudt/currencyExponent> ;
                                                                    owl:allValuesFrom xsd:integer
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://qudt.org/schema/qudt/blockchainNetwork> ;
                                                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://qudt.org/schema/qudt/currencyCode> ;
                                                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://qudt.org/schema/qudt/currencyExponent> ;
                                                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://qudt.org/schema/qudt/hasDTICode> ;
                                                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                  ] ;
                                                  <http://purl.org/dc/terms/description> "A currency-like unit for cryptographic or tokenized assets. Instances should reference an ISO 24165 Digital Token Identifier (DTI) when available."@en ;
                                                  <http://qudt.org/schema/qudt/informativeReference> <https://dtif.org/> ,
                                                                                                     <https://www.iso.org/standard/79891.html> ;
                                                  rdfs:comment "A currency-like unit for cryptographic or tokenized assets. Instances should reference an ISO 24165 Digital Token Identifier (DTI) when available."@en ;
                                                  rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                  rdfs:label "Digital Currency Unit"@en .


###  http://qudt.org/schema/qudt/DimensionlessUnit
<http://qudt.org/schema/qudt/DimensionlessUnit> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://qudt.org/schema/qudt/Unit> ;
                                                <http://purl.org/dc/terms/description> """
  <p>A <em>Dimensionless Unit</em> is a quantity for which all the exponents of the factors corresponding to the base quantities in its quantity dimension are zero.
  </p>"""^^rdf:HTML ;
                                                rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                rdfs:label "Dimensionless Unit" .


###  http://qudt.org/schema/qudt/Discipline
<http://qudt.org/schema/qudt/Discipline> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ;
                                         rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                         rdfs:label "Discipline" .


###  http://qudt.org/schema/qudt/EnumeratedQuantity
<http://qudt.org/schema/qudt/EnumeratedQuantity> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://qudt.org/schema/qudt/enumeratedValue> ;
                                                                   owl:allValuesFrom <http://qudt.org/schema/qudt/EnumeratedValue>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://qudt.org/schema/qudt/enumeration> ;
                                                                   owl:allValuesFrom <http://qudt.org/schema/qudt/Enumeration>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://qudt.org/schema/qudt/enumeratedValue> ;
                                                                   owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://qudt.org/schema/qudt/enumeration> ;
                                                                   owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                 ] ;
                                                 rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                 rdfs:label "Enumerated Quantity" .


###  http://qudt.org/schema/qudt/EnumeratedValue
<http://qudt.org/schema/qudt/EnumeratedValue> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://qudt.org/schema/qudt/Verifiable> ,
                                                              <http://www.linkedmodel.org/schema/dtype#EnumeratedValue> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://qudt.org/schema/qudt/abbreviation> ;
                                                                owl:allValuesFrom xsd:string
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://purl.org/dc/terms/description> ;
                                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://qudt.org/schema/qudt/abbreviation> ;
                                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                              ] ;
                                              <http://purl.org/dc/terms/description> """
  <p>An <em>Enumerated Value</em> class defines the members of an enumeration. 
  An enumeration is a set of literals from which a single value is selected. 
  Each literal can have a tag as an integer within a standard encoding appropriate to the range of integer values. 
  Consistency of enumeration types will allow them, and the enumerated values, to be referred to unambiguously either through symbolic name or encoding. 
  </p>
  <p>Enumerated values are also controlled vocabularies and as such need to be standardized. 
  Without this consistency enumeration literals can be stated differently and result in  data conflicts and misinterpretations.
  </p>
  <p>The tags are a set of positive whole numbers, not necessarily contiguous and having no numerical significance, each corresponding to the associated literal identifier. 
  An order attribute can also be given on the enumeration elements. 
  An enumeration can itself be a member of an enumeration. 
  This allows enumerations to be enumerated in a selection. 
  </p>
  <p>Enumerations are also subclasses of Scalar Datatype. 
  This allows them to be used as the reference of a datatype specification.
  </p>
  """^^rdf:HTML ;
                                              <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Enumeration"^^xsd:anyURI ;
                                              rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                              rdfs:label "Enumerated Value" .


###  http://qudt.org/schema/qudt/Enumeration
<http://qudt.org/schema/qudt/Enumeration> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://qudt.org/schema/qudt/abbreviation> ;
                                                            owl:allValuesFrom xsd:string
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://qudt.org/schema/qudt/default> ;
                                                            owl:allValuesFrom <http://qudt.org/schema/qudt/EnumeratedValue>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://qudt.org/schema/qudt/element> ;
                                                            owl:allValuesFrom <http://qudt.org/schema/qudt/EnumeratedValue>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://qudt.org/schema/qudt/element> ;
                                                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://qudt.org/schema/qudt/default> ;
                                                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://qudt.org/schema/qudt/abbreviation> ;
                                                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                          ] .


###  http://qudt.org/schema/qudt/FactorUnit
<http://qudt.org/schema/qudt/FactorUnit> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://qudt.org/schema/qudt/hasUnit> ;
                                                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://qudt.org/schema/qudt/hasUnit> ;
                                                           owl:cardinality "1"^^xsd:nonNegativeInteger
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://qudt.org/schema/qudt/hasUnit> ;
                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                         ] .


###  http://qudt.org/schema/qudt/Figure
<http://qudt.org/schema/qudt/Figure> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/figureCaption> ;
                                                       owl:allValuesFrom xsd:string
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/figureLabel> ;
                                                       owl:allValuesFrom xsd:string
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/height> ;
                                                       owl:allValuesFrom xsd:string
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/width> ;
                                                       owl:allValuesFrom xsd:string
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/image> ;
                                                       owl:allValuesFrom xsd:anyURI
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/imageLocation> ;
                                                       owl:allValuesFrom xsd:anyURI
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/landscape> ;
                                                       owl:allValuesFrom xsd:boolean
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/imageLocation> ;
                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/imageLocation> ;
                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/figureCaption> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/figureLabel> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/height> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/image> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/imageLocation> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/landscape> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://qudt.org/schema/qudt/width> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ;
                                     rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                     rdfs:label "Figure" .


###  http://qudt.org/schema/qudt/IntervalScale
<http://qudt.org/schema/qudt/IntervalScale> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://qudt.org/schema/qudt/Scale> ;
                                            <http://purl.org/dc/terms/description> """
  <p>The interval type allows for the degree of difference between items, but not the ratio between them. 
  Examples include temperature with the Celsius scale, which has two defined points
   (the freezing and boiling point of water at specific conditions) and then separated into 100 intervals,
   date when measured from an arbitrary epoch (such as AD), percentage such as a percentage return on a stock,
   location in Cartesian coordinates, and direction measured in degrees from true or magnetic north. 
  </p>
  <p>Ratios are not meaningful since 20 °C cannot be said to be \"twice as hot\" as 10 °C, nor can multiplication/division be carried out between any two dates directly. 
  However, ratios of differences can be expressed; for example, one difference can be twice another. 
  Interval type variables are sometimes also called \"scaled variables\", but the formal mathematical term is an affine space (in this case an affine line).
  </p>
  <p>Characteristics: median, percentile &amp; Monotonic increasing (order (&lt;) &amp; totally ordered set.</p>
  """^^rdf:HTML ;
                                            <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Level_of_measurement"^^xsd:anyURI ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                            rdfs:label "Interval scale" ;
                                            rdfs:seeAlso <http://qudt.org/schema/qudt/NominalScale> ,
                                                         <http://qudt.org/schema/qudt/OrdinalScale> ,
                                                         <http://qudt.org/schema/qudt/RatioScale> .


###  http://qudt.org/schema/qudt/LatexString
<http://qudt.org/schema/qudt/LatexString> rdf:type owl:Class ;
                                          rdfs:subClassOf xsd:string .


###  http://qudt.org/schema/qudt/LogarithmicUnit
<http://qudt.org/schema/qudt/LogarithmicUnit> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://qudt.org/schema/qudt/DimensionlessUnit> ;
                                              <http://purl.org/dc/terms/description> """
  Logarithmic units are abstract mathematical units that can be used to express any quantities
   (physical or mathematical) that are defined on a logarithmic scale, that is, as being proportional
   to the value of a logarithm function.
  Examples of logarithmic units include common units of information and entropy, such as the bit,
   and the byte, as well as units of relative signal strength magnitude such as the decibel.
  """^^rdf:HTML ;
                                              rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                              rdfs:label "Logarithmic Unit" .


###  http://qudt.org/schema/qudt/NIST_SP811_Comment
<http://qudt.org/schema/qudt/NIST_SP811_Comment> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://qudt.org/schema/qudt/Comment> ;
                                                 <http://purl.org/dc/terms/description> "National Institute of Standards and Technology (NIST) Special Publication 811 Comments on some quantities and their units" ;
                                                 rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                 rdfs:label "NIST SP~811 Comment" .


###  http://qudt.org/schema/qudt/NominalScale
<http://qudt.org/schema/qudt/NominalScale> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://qudt.org/schema/qudt/Scale> ;
                                           <http://purl.org/dc/terms/description> """
  A nominal scale differentiates between items or subjects based only on their names or (meta-)categories and other qualitative classifications they belong to;
   thus dichotomous data involves the construction of classifications as well as the classification of items. 
  Discovery of an exception to a classification can be viewed as progress. 
  Numbers may be used to represent the variables but the numbers do not have numerical value or relationship:
   for example, a Globally unique identifier. 
  Examples of these classifications include gender, nationality, ethnicity, language, genre, style, biological species, and form. 
  In a university one could also use hall of affiliation as an example.
  """^^rdf:HTML ;
                                           <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Level_of_measurement"^^xsd:anyURI ;
                                           rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                           rdfs:label "Nominal scale" ;
                                           rdfs:seeAlso <http://qudt.org/schema/qudt/IntervalScale> ,
                                                        <http://qudt.org/schema/qudt/OrdinalScale> ,
                                                        <http://qudt.org/schema/qudt/RatioScale> .


###  http://qudt.org/schema/qudt/OrdinalScale
<http://qudt.org/schema/qudt/OrdinalScale> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://qudt.org/schema/qudt/Scale> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/order> ;
                                                             owl:allValuesFrom xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/order> ;
                                                             owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/order> ;
                                                             owl:cardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/order> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ;
                                           <http://purl.org/dc/terms/description> """
  <p>The ordinal type allows for rank order (1st, 2nd, 3rd, etc.) by which data can be sorted,
   but still does not allow for relative degree of difference between them. 
  Examples include, on one hand, dichotomous data with dichotomous (or dichotomized) values such as:
   'sick' vs. 'healthy' when measuring health, 'guilty' vs. 'innocent' when making judgments in courts,
   'wrong/false' vs. 'right/true' when measuring truth value, and, on the other hand, non-dichotomous data consisting of a spectrum of values, such as:
   'completely agree', 'mostly agree', 'mostly disagree', 'completely disagree' when measuring opinion.
  </p>"""^^rdf:HTML ;
                                           <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Level_of_measurement"^^xsd:anyURI ;
                                           rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                           rdfs:label "Ordinal scale" ;
                                           rdfs:seeAlso <http://qudt.org/schema/qudt/IntervalScale> ,
                                                        <http://qudt.org/schema/qudt/NominalScale> ,
                                                        <http://qudt.org/schema/qudt/RatioScale> .


###  http://qudt.org/schema/qudt/Organization
<http://qudt.org/schema/qudt/Organization> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/url> ;
                                                             owl:allValuesFrom xsd:anyURI
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/url> ;
                                                             owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                           ] ;
                                           rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                           rdfs:label "Organization" .


###  http://qudt.org/schema/qudt/PhysicalConstant
<http://qudt.org/schema/qudt/PhysicalConstant> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://qudt.org/schema/qudt/Quantity> ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/applicableSystem> ;
                                                                 owl:allValuesFrom <http://qudt.org/schema/qudt/SystemOfUnits>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/applicableUnit> ;
                                                                 owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/hasDimensionVector> ;
                                                                 owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKindDimensionVector>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/iec61360Code> ;
                                                                 owl:allValuesFrom xsd:string
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/mathMLdefinition> ;
                                                                 owl:allValuesFrom xsd:string
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/dbpediaMatch> ;
                                                                 owl:allValuesFrom xsd:anyURI
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/exactConstant> ;
                                                                 owl:allValuesFrom xsd:boolean
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/isoNormativeReference> ;
