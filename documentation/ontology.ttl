###  https://www.w3id.org/MQTT4SSN-Ontology#hasProperties
:hasProperties rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :AuthVariableHeader
                                           :ConnackVariableHeader
                                           :ConnectVariableHeader
                                           :DisconnectVariableHeader
                                           :PubackVariableHeader
                                           :PubcompVariableHeader
                                           :PublishVariableHeader
                                           :PubrecVariableHeader
                                           :PubrelVariableHeader
                                           :SubackVariableHeader
                                           :SubscribeVariableHeader
                                           :UnsubackVariableHeader
                                           :UnsubscribeVariableHeader
                                         )
                           ] ;
               rdfs:range :Properties ;
               rdfs:comment "Links an MQTT Control Packet or higher-level message individual to its MQTT 5.0 Properties collection (variable header properties)."@en ;
               rdfs:label "has Properties"@en .


