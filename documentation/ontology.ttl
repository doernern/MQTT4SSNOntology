              rdfs:label "has Will Topic"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#hosts
:hosts rdf:type owl:ObjectProperty ;
       owl:inverseOf :isHostedBy ;
       rdfs:domain :Client ;
       rdfs:range <http://www.w3.org/ns/ssn/System> ;
       rdfs:comment "Links an MQTT Client (as a SOSA platform) to SSN systems (sensors/actuators) it hosts."@en ;
       rdfs:label "hosts"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#isAcceptedBy
:isAcceptedBy rdf:type owl:ObjectProperty ;
              rdfs:domain :NetworkConnection ;
              rdfs:range :Broker ;
              rdfs:comment "Indicates the MQTT Broker that accepted the client's connection request."@en ;
              rdfs:label "is accepted by"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#isActObsSubjectOf
:isActObsSubjectOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :isSubjectOf ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( <http://www.w3.org/ns/sosa/Actuation>
                                               <http://www.w3.org/ns/sosa/ActuationCollection>
                                               <http://www.w3.org/ns/sosa/Observation>
                                               <http://www.w3.org/ns/sosa/ObservationCollection>
                                             )
                               ] ;
                   rdfs:range :Topic ;
                   rdfs:comment "Links a topic subject (Actuation, Actuation collection, Observation or Observation Collection) to the MQTT Topic that carries it."@en ;
                   rdfs:label "is topic subject (Actuation, Actuation collection, Observation or Observation Collection) of"@en .


