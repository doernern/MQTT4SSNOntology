###  http://qudt.org/schema/qudt/applicableCGSUnit
<http://qudt.org/schema/qudt/applicableCGSUnit> rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf <http://qudt.org/schema/qudt/applicableUnit> ;
                                                rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                                rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                rdfs:label "applicable CGS unit" .


###  http://qudt.org/schema/qudt/applicableISOUnit
<http://qudt.org/schema/qudt/applicableISOUnit> rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf <http://qudt.org/schema/qudt/applicableUnit> ;
                                                rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                                rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                rdfs:label "applicable ISO unit" .


###  http://qudt.org/schema/qudt/applicableImperialUnit
<http://qudt.org/schema/qudt/applicableImperialUnit> rdf:type owl:ObjectProperty ;
                                                     rdfs:subPropertyOf <http://qudt.org/schema/qudt/applicableUnit> ;
                                                     rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                                     rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                     rdfs:label "applicable Imperial unit" .


###  http://qudt.org/schema/qudt/applicablePhysicalConstant
<http://qudt.org/schema/qudt/applicablePhysicalConstant> rdf:type owl:ObjectProperty ;
                                                         rdfs:range <http://qudt.org/schema/qudt/PhysicalConstant> ;
                                                         rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                         rdfs:label "applicable physical constant" .


###  http://qudt.org/schema/qudt/applicablePlanckUnit
<http://qudt.org/schema/qudt/applicablePlanckUnit> rdfs:subPropertyOf <http://qudt.org/schema/qudt/applicableUnit> .


###  http://qudt.org/schema/qudt/applicableSIUnit
<http://qudt.org/schema/qudt/applicableSIUnit> rdf:type owl:ObjectProperty ;
                                               rdfs:subPropertyOf <http://qudt.org/schema/qudt/applicableUnit> ;
                                               rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                               rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                               rdfs:label "applicable SI unit" .


###  http://qudt.org/schema/qudt/applicableSystem
<http://qudt.org/schema/qudt/applicableSystem> rdf:type owl:ObjectProperty ;
                                               rdfs:range <http://qudt.org/schema/qudt/SystemOfUnits> ;
                                               <http://purl.org/dc/terms/description> """
  This property relates a unit of measure with a unit system that may or may not define the unit,
   but within which the unit is compatible.
  """ ;
                                               rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                               rdfs:label "applicable system" .


###  http://qudt.org/schema/qudt/applicableUSCustomaryUnit
<http://qudt.org/schema/qudt/applicableUSCustomaryUnit> rdf:type owl:ObjectProperty ;
                                                        rdfs:subPropertyOf <http://qudt.org/schema/qudt/applicableUnit> ;
                                                        rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                                        rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                        rdfs:label "applicable US Customary unit" .


###  http://qudt.org/schema/qudt/applicableUnit
<http://qudt.org/schema/qudt/applicableUnit> rdf:type owl:ObjectProperty ;
                                             rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                             <http://purl.org/dc/terms/description> """
  <p>See this page on the QUDT GitHub<a href=\"https://github.com/qudt/qudt-public-repo/wiki/Advanced-User-Guide#4-computing-applicable-units-for-a-quantitykind\">Wiki</a>
   on how \"qudt:applicableUnit\" is computed from \"qudt:hasQuantityKind\" and then materialized.
  </p>"""^^rdf:HTML ;
                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                             rdfs:label "applicable unit" .


###  http://qudt.org/schema/qudt/baseDimensionEnumeration
<http://qudt.org/schema/qudt/baseDimensionEnumeration> rdf:type owl:ObjectProperty ,
                                                                owl:FunctionalProperty ;
                                                       rdfs:range <http://qudt.org/schema/qudt/Enumeration> ;
                                                       <http://purl.org/dc/terms/description> "This property associates a system of quantities with an enumeration that enumerates the base dimensions of the system in canonical order."^^rdf:HTML ;
                                                       rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                       rdfs:label "base dimension enumeration" .


###  http://qudt.org/schema/qudt/baseUnitOfSystem
<http://qudt.org/schema/qudt/baseUnitOfSystem> rdf:type owl:ObjectProperty ;
                                               rdfs:subPropertyOf <http://qudt.org/schema/qudt/definedUnitOfSystem> ;
                                               owl:inverseOf <http://qudt.org/schema/qudt/hasBaseUnit> ;
                                               <http://purl.org/dc/terms/description> """
  This property relates a unit of measure to the system of units in which it is defined as a base unit for the system. 
  The base units of a system are used to define the derived units of the system by expressing the derived units as products of the base units raised to a rational power.
  """ ;
                                               rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                               rdfs:label "is base unit of system" .


###  http://qudt.org/schema/qudt/belongsToSystemOfQuantities
<http://qudt.org/schema/qudt/belongsToSystemOfQuantities> rdf:type owl:ObjectProperty ;
                                                          rdfs:range <http://qudt.org/schema/qudt/SystemOfQuantityKinds> ;
                                                          rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                          rdfs:label "belongs to system of quantities" .


###  http://qudt.org/schema/qudt/coherentUnitSystem
<http://qudt.org/schema/qudt/coherentUnitSystem> rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasUnitSystem> .


###  http://qudt.org/schema/qudt/datatype
<http://qudt.org/schema/qudt/datatype> rdf:type owl:ObjectProperty ;
                                       rdfs:isDefinedBy <http://qudt.org/schema/datatype> .


###  http://qudt.org/schema/qudt/default
<http://qudt.org/schema/qudt/default> rdf:type owl:ObjectProperty ,
                                               owl:FunctionalProperty ;
                                      rdfs:range <http://qudt.org/schema/qudt/EnumeratedValue> ;
                                      <http://purl.org/dc/terms/description> "The default element in an enumeration"^^rdf:HTML ;
                                      rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                      rdfs:label "default" .


###  http://qudt.org/schema/qudt/definedUnitOfSystem
<http://qudt.org/schema/qudt/definedUnitOfSystem> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf <http://qudt.org/schema/qudt/isUnitOfSystem> ;
                                                  owl:inverseOf <http://qudt.org/schema/qudt/hasDefinedUnit> ;
                                                  rdfs:range <http://qudt.org/schema/qudt/SystemOfUnits> ;
                                                  <http://purl.org/dc/terms/description> "This property relates a unit of measure with the unit system that defines the unit."^^rdf:HTML ;
                                                  rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                  rdfs:label "defined unit of system" .


###  http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem
<http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem> rdf:type owl:ObjectProperty ;
                                                          rdfs:subPropertyOf <http://qudt.org/schema/qudt/definedUnitOfSystem> ,
                                                                             <http://qudt.org/schema/qudt/derivedUnitOfSystem> ;
                                                          owl:inverseOf <http://qudt.org/schema/qudt/hasDerivedCoherentUnit> ;
                                                          rdfs:range <http://qudt.org/schema/qudt/SystemOfUnits> ;
                                                          <http://purl.org/dc/terms/description> "This property relates a unit of measure to the unit system in which the unit is derived from the system's base units with a proportionality constant of one."^^rdf:HTML ;
                                                          rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                          rdfs:label "is coherent derived unit of system" .


###  http://qudt.org/schema/qudt/derivedNonCoherentUnitOfSystem
<http://qudt.org/schema/qudt/derivedNonCoherentUnitOfSystem> rdf:type owl:ObjectProperty ;
                                                             rdfs:subPropertyOf <http://qudt.org/schema/qudt/derivedUnitOfSystem> ;
                                                             <http://purl.org/dc/terms/description> """
  This property relates a unit of measure to the unit system in which the unit is derived from the system's
   base units without proportionality constant of one.
  """ ;
                                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                             rdfs:label "is non-coherent derived unit of system" .


###  http://qudt.org/schema/qudt/derivedUnitOfSystem
<http://qudt.org/schema/qudt/derivedUnitOfSystem> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf <http://qudt.org/schema/qudt/isUnitOfSystem> ;
                                                  owl:inverseOf <http://qudt.org/schema/qudt/hasDerivedUnit> ;
                                                  rdfs:range <http://qudt.org/schema/qudt/SystemOfUnits> ;
                                                  <http://purl.org/dc/terms/description> """
  This property relates a unit of measure to the system of units in which it is defined as a derived unit. 
  That is, the derived unit is defined as a product of the base units for the system raised to some rational power.
  """ ;
                                                  rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                  rdfs:label "is derived unit of system" .


###  http://qudt.org/schema/qudt/dimensionInverse
<http://qudt.org/schema/qudt/dimensionInverse> rdf:type owl:ObjectProperty ;
                                               owl:inverseOf <http://qudt.org/schema/qudt/dimensionInverse> ;
                                               rdf:type owl:InverseFunctionalProperty ,
                                                        owl:SymmetricProperty ;
                                               rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                               rdfs:label "dimension inverse" .


###  http://qudt.org/schema/qudt/dimensionVectorForSI
<http://qudt.org/schema/qudt/dimensionVectorForSI> rdf:type owl:ObjectProperty ,
                                                            owl:FunctionalProperty ;
                                                   rdfs:range <http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI> ;
                                                   rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                   rdfs:label "dimension vector for SI" .


###  http://qudt.org/schema/qudt/element
<http://qudt.org/schema/qudt/element> rdf:type owl:ObjectProperty ;
                                      rdfs:range <http://qudt.org/schema/qudt/EnumeratedValue> ;
                                      <http://purl.org/dc/terms/description> "An element of an enumeration"^^rdf:HTML ;
                                      rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                      rdfs:label "element" .


###  http://qudt.org/schema/qudt/enumeratedValue
<http://qudt.org/schema/qudt/enumeratedValue> rdf:type owl:ObjectProperty ;
                                              rdfs:isDefinedBy <http://qudt.org/schema/qudt> .


###  http://qudt.org/schema/qudt/enumeration
<http://qudt.org/schema/qudt/enumeration> rdf:type owl:ObjectProperty ;
                                          rdfs:isDefinedBy <http://qudt.org/schema/datatype> .


###  http://qudt.org/schema/qudt/exactMatch
<http://qudt.org/schema/qudt/exactMatch> rdf:type owl:ObjectProperty ;
                                         rdfs:range <http://qudt.org/schema/qudt/Concept> .


###  http://qudt.org/schema/qudt/guidance
<http://qudt.org/schema/qudt/guidance> rdfs:range rdf:HTML .


###  http://qudt.org/schema/qudt/hasAllowedUnit
<http://qudt.org/schema/qudt/hasAllowedUnit> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasUnit> ;
                                             rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                             <http://purl.org/dc/terms/description> """
  This property relates a unit system with a unit of measure that is not defined by or part of the system,
   but is allowed for use within the system.
   An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system.
  """ ;
                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                             rdfs:label "allowed unit" .


###  http://qudt.org/schema/qudt/hasBaseQuantityKind
<http://qudt.org/schema/qudt/hasBaseQuantityKind> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasQuantityKind> ;
                                                  rdfs:range <http://qudt.org/schema/qudt/QuantityKind> ;
                                                  rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                  rdfs:label "has base quantity kind" .


###  http://qudt.org/schema/qudt/hasBaseUnit
<http://qudt.org/schema/qudt/hasBaseUnit> rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasCoherentUnit> ;
                                          rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                          <http://purl.org/dc/terms/description> """
  This property relates a system of units to a base unit defined within the system.
  The base units of a system are used to define the derived units of the system by expressing
   the derived units as products of the base units raised to a rational power.
  """ ;
                                          rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                          rdfs:label "base unit" .


###  http://qudt.org/schema/qudt/hasCoherentUnit
<http://qudt.org/schema/qudt/hasCoherentUnit> rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasDefinedUnit> ;
                                              rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                              <http://purl.org/dc/terms/description> """
  A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers
   of the system's base units with the proportionality factor of one.
  """ ;
                                              rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                              rdfs:label "coherent unit" .


###  http://qudt.org/schema/qudt/hasDefinedUnit
<http://qudt.org/schema/qudt/hasDefinedUnit> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasUnit> ;
                                             rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                             <http://purl.org/dc/terms/description> "This property relates a unit system with a unit of measure that is defined by the system."^^rdf:HTML ;
                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                             rdfs:label "defined unit" .


###  http://qudt.org/schema/qudt/hasDerivedCoherentUnit
<http://qudt.org/schema/qudt/hasDerivedCoherentUnit> rdf:type owl:ObjectProperty ;
                                                     rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasCoherentUnit> ,
                                                                        <http://qudt.org/schema/qudt/hasDerivedUnit> ;
                                                     rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                                     rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                     rdfs:label "derived coherent unit" .


###  http://qudt.org/schema/qudt/hasDerivedNonCoherentUnit
<http://qudt.org/schema/qudt/hasDerivedNonCoherentUnit> rdf:type owl:ObjectProperty ;
                                                        rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasDerivedUnit> ;
                                                        owl:inverseOf <http://qudt.org/schema/qudt/derivedNonCoherentUnitOfSystem> ;
                                                        rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                        rdfs:label "has coherent derived unit" .


###  http://qudt.org/schema/qudt/hasDerivedUnit
<http://qudt.org/schema/qudt/hasDerivedUnit> rdf:type owl:ObjectProperty ;
                                             rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                             <http://purl.org/dc/terms/description> """
  This property relates a system of units to a unit of measure that is defined within the system in terms
   of the base units for the system. 
  That is, the derived unit is defined as a product of the base units for the system raised to some rational power.
  """ ;
                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                             rdfs:label "derived unit" .


###  http://qudt.org/schema/qudt/hasDimensionVector
<http://qudt.org/schema/qudt/hasDimensionVector> rdf:type owl:ObjectProperty ;
                                                 rdfs:range <http://qudt.org/schema/qudt/QuantityKindDimensionVector> ;
                                                 rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                 rdfs:label "has dimension vector" .


###  http://qudt.org/schema/qudt/hasFactorUnit
<http://qudt.org/schema/qudt/hasFactorUnit> rdf:type owl:ObjectProperty ;
                                            <http://purl.org/dc/terms/description> "This property relates a derived unit to one of its constituent factor units"^^rdf:HTML ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                            rdfs:label "hasFactorUnit" .


###  http://qudt.org/schema/qudt/hasPrefixUnit
<http://qudt.org/schema/qudt/hasPrefixUnit> rdfs:subPropertyOf <http://qudt.org/schema/qudt/hasDefinedUnit> .


###  http://qudt.org/schema/qudt/hasQuantityKind
<http://qudt.org/schema/qudt/hasQuantityKind> rdf:type owl:ObjectProperty ;
                                              rdfs:range <http://qudt.org/schema/qudt/QuantityKind> ;
                                              rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                              rdfs:label "has quantity kind" .


###  http://qudt.org/schema/qudt/hasReciprocalUnit
<http://qudt.org/schema/qudt/hasReciprocalUnit> rdf:type owl:ObjectProperty ;
                                                rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                                <http://purl.org/dc/terms/description> "Used to relate a unit to its reciprocal unit." ;
                                                rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                rdfs:label "has reciprocal unit" .


###  http://qudt.org/schema/qudt/hasReferenceQuantityKind
<http://qudt.org/schema/qudt/hasReferenceQuantityKind> rdf:type owl:ObjectProperty ;
                                                       rdfs:range <http://qudt.org/schema/qudt/QuantityKind> ;
                                                       rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                       rdfs:label "has reference quantity kind" .


###  http://qudt.org/schema/qudt/hasRule
<http://qudt.org/schema/qudt/hasRule> rdf:type owl:ObjectProperty ;
                                      rdfs:range <http://qudt.org/schema/qudt/Rule> ;
                                      rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                      rdfs:label "has rule" .


###  http://qudt.org/schema/qudt/hasUnit
<http://qudt.org/schema/qudt/hasUnit> rdf:type owl:ObjectProperty ;
                                      rdfs:range <http://qudt.org/schema/qudt/Unit> ;
                                      <http://purl.org/dc/terms/description> """
  <p>This property relates a factor unit to its unit or system of units with a unit of measure that is either:
  </p>
  <dl>
  <dd>a) defined by the system,</dd>
  <dd>b) accepted for use by the system and is convertible to a unit of equivalent dimension that is defined by the system,</dd>
  <dd>c) a reference to the unit of measure of a quantity (variable or constant) of interest.</dd>
  </dl>
  <p>Systems of units may distinguish between base and derived units.
  Base units are the units which measure the base quantities for the corresponding system of quantities. 
  The base units are used to define units for all other quantities as products of powers of the base units. 
  Such units are called derived units for the system. 
  </p>"""^^rdf:HTML ;
                                      rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                      rdfs:label "has unit" .


###  http://qudt.org/schema/qudt/hasUnitSystem
<http://qudt.org/schema/qudt/hasUnitSystem> rdf:type owl:ObjectProperty ,
                                                     owl:FunctionalProperty ;
                                            rdfs:range <http://qudt.org/schema/qudt/SystemOfUnits> ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                            rdfs:label "has unit system" .


###  http://qudt.org/schema/qudt/isUnitOfSystem
<http://qudt.org/schema/qudt/isUnitOfSystem> rdf:type owl:ObjectProperty ;
                                             rdfs:range <http://qudt.org/schema/qudt/SystemOfUnits> ;
                                             <http://purl.org/dc/terms/description> """
  This property relates a unit of measure with a system of units that either a) defines the unit
   or b) allows the unit to be used within the system.
  """ ;
                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                             rdfs:label "is unit of system" .


###  http://qudt.org/schema/qudt/permissibleMaths
<http://qudt.org/schema/qudt/permissibleMaths> rdf:type owl:ObjectProperty ;
                                               rdfs:range <http://qudt.org/schema/qudt/MathsFunctionType> ;
                                               rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                               rdfs:label "permissible maths" .


###  http://qudt.org/schema/qudt/permissibleTransformation
<http://qudt.org/schema/qudt/permissibleTransformation> rdf:type owl:ObjectProperty ;
                                                        rdfs:range <http://qudt.org/schema/qudt/TransformType> ;
                                                        rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                        rdfs:label "permissible transformation" .


###  http://qudt.org/schema/qudt/prefix
<http://qudt.org/schema/qudt/prefix> rdf:type owl:ObjectProperty ;
                                     rdfs:range <http://qudt.org/schema/qudt/Prefix> ;
                                     <http://purl.org/dc/terms/description> "Associates a unit with the appropriate prefix, if any." ;
                                     rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                     rdfs:label "prefix" .


###  http://qudt.org/schema/qudt/qkdvDenominator
<http://qudt.org/schema/qudt/qkdvDenominator> rdf:type owl:ObjectProperty ,
                                                       owl:FunctionalProperty ;
                                              rdfs:range <http://qudt.org/schema/qudt/QuantityKindDimensionVector> ;
                                              rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                              rdfs:label "denominator dimension vector" .


###  http://qudt.org/schema/qudt/qkdvNumerator
<http://qudt.org/schema/qudt/qkdvNumerator> rdf:type owl:ObjectProperty ,
                                                     owl:FunctionalProperty ;
                                            rdfs:range <http://qudt.org/schema/qudt/QuantityKindDimensionVector> ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                            rdfs:label "numerator dimension vector" .


###  http://qudt.org/schema/qudt/quantity
<http://qudt.org/schema/qudt/quantity> rdf:type owl:ObjectProperty ,
                                                owl:FunctionalProperty ;
                                       rdfs:range <http://qudt.org/schema/qudt/Quantity> ;
