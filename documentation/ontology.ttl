###  http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI
<http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityKindDimensionVector> ;
                                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                             rdfs:label "Quantity Kind Dimension vector (SI)" .


###  http://qudt.org/schema/qudt/QuantityType
<http://qudt.org/schema/qudt/QuantityType> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://qudt.org/schema/qudt/EnumeratedValue> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://www.linkedmodel.org/schema/dtype#value> ;
                                                             owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind>
                                                           ] ;
                                           <http://purl.org/dc/terms/description> """
  A $\\textit{Quantity Type}$ is an enumeration of quantity kinds. 
  It specializes $\\boxed{dtype:EnumeratedValue}$ by constrinaing $\\boxed{dtype:value}$ to instances of $\\boxed{qudt:QuantityKind}$.
  """^^<http://qudt.org/schema/qudt/LatexString> ;
                                           rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                           rdfs:label "Quantity type" .


###  http://qudt.org/schema/qudt/QuantityValue
<http://qudt.org/schema/qudt/QuantityValue> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                            <http://qudt.org/schema/qudt/Quantifiable> ,
                                                            <http://qudt.org/schema/qudt/Verifiable> ;
                                            <http://purl.org/dc/terms/description> """
  <p>A <em>Quantity Value</em> 
  </p>"""^^rdf:HTML ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                            rdfs:label "Quantity value" .


###  http://qudt.org/schema/qudt/RatioScale
<http://qudt.org/schema/qudt/RatioScale> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://qudt.org/schema/qudt/Scale> ;
                                         <http://purl.org/dc/terms/description> """
  <p>A <em>Ratio Scale</em> possesses a meaningful (unique and non-arbitrary) zero value. 
  Most measurement in the physical sciences and engineering is done on ratio scales. 
  Examples include mass, length, duration, plane angle, energy and electric charge.
  </p>
  <p>In contrast to interval scales, ratios are now meaningful because having a non-arbitrary zero point makes it meaningful to say,
   for example, that one object has \"twice the length\" of another (= is \"twice as long\"). 
  Very informally, many ratio scales can be described as specifying \"how much\" of something (i.e. an amount or magnitude) or \"how many\" (a count). 
  The Kelvin temperature scale is a ratio scale because it has a unique, non-arbitrary zero point called absolute zero.
  </p>"""^^rdf:HTML ;
                                         <http://qudt.org/schema/qudt/informativeReference> "https://en.wikipedia.org/wiki/Level_of_measurement"^^xsd:anyURI ;
                                         rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                         rdfs:label "Ratio scale" ;
                                         rdfs:seeAlso <http://qudt.org/schema/qudt/IntervalScale> ,
                                                      <http://qudt.org/schema/qudt/NominalScale> ,
                                                      <http://qudt.org/schema/qudt/OrdinalScale> .


###  http://qudt.org/schema/qudt/Rule
<http://qudt.org/schema/qudt/Rule> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                   <http://qudt.org/schema/qudt/Verifiable> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/rationale> ;
                                                     owl:allValuesFrom rdf:HTML
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/ruleType> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/RuleType>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/rationale> ;
                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                   ] ;
                                   rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                   rdfs:label "Rule" .


###  http://qudt.org/schema/qudt/RuleType
<http://qudt.org/schema/qudt/RuleType> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://qudt.org/schema/qudt/EnumeratedValue> ;
                                       rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                       rdfs:label "Rule Type" .


###  http://qudt.org/schema/qudt/ScalarDataItem
<http://qudt.org/schema/qudt/ScalarDataItem> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://qudt.org/schema/qudt/datatype> ;
                                                               owl:allValuesFrom <http://qudt.org/schema/qudt/ScalarDatatype>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://qudt.org/schema/qudt/datatype> ;
                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                             ] ;
                                             <http://purl.org/dc/terms/description> """
  <p>A <em>Data Item</em> holds a value that is compliant with a specified <em>Datatype</em>.
  </p>"""^^rdf:HTML ;
                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                             rdfs:label "Scalar Data Item" .


###  http://qudt.org/schema/qudt/ScalarDatatype
<http://qudt.org/schema/qudt/ScalarDatatype> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://qudt.org/schema/qudt/Datatype> ;
                                             <http://purl.org/dc/terms/description> """
  Scalar data types are those that have a single value. 
  The permissible values are defined over a domain that may be integers, float, character or boolean. 
  Often a scalar data type is referred to as a primitive data type.
  """ ;
                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                             rdfs:label "Scalar Datatype" .


###  http://qudt.org/schema/qudt/Scale
<http://qudt.org/schema/qudt/Scale> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                    <http://qudt.org/schema/qudt/Verifiable> ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://qudt.org/schema/qudt/dataStructure> ;
                                                      owl:allValuesFrom xsd:string
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://qudt.org/schema/qudt/permissibleMaths> ;
                                                      owl:allValuesFrom <http://qudt.org/schema/qudt/MathsFunctionType>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://qudt.org/schema/qudt/permissibleTransformation> ;
                                                      owl:allValuesFrom <http://qudt.org/schema/qudt/TransformType>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://qudt.org/schema/qudt/scaleType> ;
                                                      owl:allValuesFrom <http://qudt.org/schema/qudt/ScaleType>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://qudt.org/schema/qudt/scaleType> ;
                                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://qudt.org/schema/qudt/dataStructure> ;
                                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                    ] ;
                                    <http://purl.org/dc/terms/description> """
  <p>Scales (also called \"scales of measurement\" or \"levels of measurement\") are expressions that typically are based on scale types.
  </p>"""^^rdf:HTML ;
                                    rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                    rdfs:label "Scale" .


###  http://qudt.org/schema/qudt/ScaleType
<http://qudt.org/schema/qudt/ScaleType> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://qudt.org/schema/qudt/EnumeratedValue> ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://qudt.org/schema/qudt/dataStructure> ;
                                                          owl:allValuesFrom xsd:string
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://qudt.org/schema/qudt/permissibleMaths> ;
                                                          owl:allValuesFrom <http://qudt.org/schema/qudt/MathsFunctionType>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://qudt.org/schema/qudt/permissibleTransformation> ;
                                                          owl:allValuesFrom <http://qudt.org/schema/qudt/TransformType>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://qudt.org/schema/qudt/dataStructure> ;
                                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                        ] ;
                                        <http://qudt.org/schema/qudt/plainTextDescription> """
  Scales, or scales of measurement (or categorization) provide ways of quantifying measurements, values and other enumerated values according to a normative frame of reference. 
  Four different types of scales are typically used. 
  These are interval, nominal, ordinal and ratio scales.
  """ ;
                                        rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                        rdfs:label "Scale type" .


###  http://qudt.org/schema/qudt/SolidAngleUnit
<http://qudt.org/schema/qudt/SolidAngleUnit> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://qudt.org/schema/qudt/AngleUnit> ;
                                             <http://purl.org/dc/terms/description> """
  The solid angle subtended by a surface S is defined as the surface area of a unit sphere covered by the surface S's projection onto the sphere. 
  A solid angle is related to the surface of a sphere in the same way an ordinary angle is related to the circumference of a circle. 
  Since the total surface area of the unit sphere is 4*pi, the measure of solid angle will always be between 0 and 4*pi.
  """ ;
                                             rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                             rdfs:label "Solid Angle Unit" .


###  http://qudt.org/schema/qudt/Statement
<http://qudt.org/schema/qudt/Statement> rdf:type owl:Class ;
                                        rdfs:subClassOf rdf:Statement ;
                                        rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                        rdfs:label "Statement" .


###  http://qudt.org/schema/qudt/Symbol
<http://qudt.org/schema/qudt/Symbol> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ;
                                     rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                     rdfs:label "Symbol" .


###  http://qudt.org/schema/qudt/SymmetricRelation
<http://qudt.org/schema/qudt/SymmetricRelation> rdf:type owl:Class ;
                                                rdfs:subClassOf rdf:Property ;
                                                rdfs:comment "A `SymmetricRelation` is modeling construct used to define symmetric behavior for appropriate relations." ;
                                                rdfs:label "Symmetric relation" .


###  http://qudt.org/schema/qudt/SystemOfQuantityKinds
<http://qudt.org/schema/qudt/SystemOfQuantityKinds> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                                    <http://qudt.org/schema/qudt/Verifiable> ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://qudt.org/schema/qudt/baseDimensionEnumeration> ;
                                                                      owl:allValuesFrom <http://qudt.org/schema/qudt/Enumeration>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://qudt.org/schema/qudt/hasBaseQuantityKind> ;
                                                                      owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> ;
                                                                      owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://qudt.org/schema/qudt/hasUnitSystem> ;
                                                                      owl:allValuesFrom <http://qudt.org/schema/qudt/SystemOfUnits>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://qudt.org/schema/qudt/systemDerivedQuantityKind> ;
                                                                      owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind>
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://qudt.org/schema/qudt/hasBaseQuantityKind> ;
                                                                      owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> ;
                                                                      owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://qudt.org/schema/qudt/systemDerivedQuantityKind> ;
                                                                      owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://qudt.org/schema/qudt/baseDimensionEnumeration> ;
                                                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                    ] ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://qudt.org/schema/qudt/hasUnitSystem> ;
                                                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                    ] ;
                                                    <http://purl.org/dc/terms/description> """
  <p>A <em>System of Quantity Kinds</em> is a set of one or more quantity kinds together with a set of zero or more algebraic equations that define relationships between quantity kinds in the set. 
  In the physical sciences, the equations relating quantity kinds are typically physical laws and definitional relations, and constants of proportionality. 
  Examples include Newton's First Law of Motion, Coulomb's Law, and the definition of velocity as the instantaneous change in position.  
  In almost all cases, the system identifies a subset of base quantity kinds. 
  </p>
  <p>The base set is chosen so that all other quantity kinds of interest can be derived from the base quantity kinds and the algebraic equations. 
  If the unit system is explicitly associated with a quantity kind system, then the unit system must define at least one unit for each quantity kind.  
  From a scientific point of view, the division of quantities into base quantities and derived quantities is a matter of convention.
  </p>"""^^rdf:HTML ;
                                                    rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                    rdfs:label "System of Quantity Kinds" .


###  http://qudt.org/schema/qudt/SystemOfUnits
<http://qudt.org/schema/qudt/SystemOfUnits> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                            <http://qudt.org/schema/qudt/Verifiable> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/applicablePhysicalConstant> ;
                                                              owl:allValuesFrom <http://qudt.org/schema/qudt/PhysicalConstant>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/hasAllowedUnit> ;
                                                              owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/hasBaseUnit> ;
                                                              owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/hasCoherentUnit> ;
                                                              owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/hasDefinedUnit> ;
                                                              owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/hasDerivedCoherentUnit> ;
                                                              owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/hasDerivedUnit> ;
                                                              owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/hasUnit> ;
                                                              owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://qudt.org/schema/qudt/prefix> ;
                                                              owl:allValuesFrom <http://qudt.org/schema/qudt/Prefix>
                                                            ] ;
                                            <http://purl.org/dc/terms/description> """
  <p>A <em>System of Units</em> is a set of units which are chosen as the reference scales for some set of quantity kinds together with the definitions of each unit. 
  Units may be defined by experimental observation or by proportion to another unit not included in the system. 
  If the unit system is explicitly associated with a quantity kind system, then the unit system must define at least one unit for each quantity kind.
  </p>"""^^rdf:HTML ;
                                            <http://qudt.org/schema/qudt/informativeReference> "http://dbpedia.org/resource/Category:Systems_of_units"^^xsd:anyURI ,
                                                                                               "http://www.ieeeghn.org/wiki/index.php/System_of_Measurement_Units"^^xsd:anyURI ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                            rdfs:label "System of Units" .


###  http://qudt.org/schema/qudt/TransformType
<http://qudt.org/schema/qudt/TransformType> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://qudt.org/schema/qudt/EnumeratedValue> ;
                                            rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                            rdfs:label "Transform type" ;
                                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Transform type" .


###  http://qudt.org/schema/qudt/UCUMcs
<http://qudt.org/schema/qudt/UCUMcs> rdf:type owl:Class ;
                                     rdfs:subClassOf xsd:string .


###  http://qudt.org/schema/qudt/Unit
<http://qudt.org/schema/qudt/Unit> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                   <http://qudt.org/schema/qudt/Verifiable> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/applicableSystem> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/SystemOfUnits>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/definedUnitOfSystem> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/SystemOfUnits>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/SystemOfUnits>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/derivedUnitOfSystem> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/SystemOfUnits>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/hasDimensionVector> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKindDimensionVector>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/hasReciprocalUnit> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/iec61360Code> ;
                                                     owl:allValuesFrom xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/isUnitOfSystem> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/SystemOfUnits>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/mathMLdefinition> ;
                                                     owl:allValuesFrom xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/prefix> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/Prefix>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/qkdvDenominator> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKindDimensionVector>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/qkdvNumerator> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKindDimensionVector>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/scalingOf> ;
                                                     owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/siUnitsExpression> ;
                                                     owl:allValuesFrom xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/udunitsCode> ;
                                                     owl:allValuesFrom xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/uneceCommonCode> ;
                                                     owl:allValuesFrom xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/hasDimensionVector> ;
                                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> ;
                                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/hasDimensionVector> ;
                                                     owl:cardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/hasDimensionVector> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/prefix> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/qkdvDenominator> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/qkdvNumerator> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/scalingOf> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/conversionMultiplier> ;
                                                     owl:allValuesFrom xsd:decimal
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/conversionMultiplierSN> ;
                                                     owl:allValuesFrom xsd:double
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/conversionOffset> ;
                                                     owl:allValuesFrom xsd:decimal
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/conversionOffsetSN> ;
                                                     owl:allValuesFrom xsd:double
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/factorUnitScalar> ;
                                                     owl:allValuesFrom xsd:decimal
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/latexDefinition> ;
                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/latexSymbol> ;
                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/siUnitsExpression> ;
                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/conversionMultiplier> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/conversionMultiplierSN> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/conversionOffset> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/conversionOffsetSN> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/factorUnitScalar> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/mathMLdefinition> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://qudt.org/schema/qudt/ucumCode> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ;
                                   <http://purl.org/dc/terms/description> """
  A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). 
  For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures). 
  Any measurement of the length can be expressed as a number multiplied by the unit meter. 
  More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  $Q = nU$.
  """^^<http://qudt.org/schema/qudt/LatexString> ;
                                   <http://qudt.org/schema/qudt/informativeReference> "http://dbpedia.org/resource/Category:Units_of_measure"^^xsd:anyURI ,
                                                                                      "http://www.allmeasures.com/Fullconversion.asp"^^xsd:anyURI ;
                                   rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                   rdfs:label "Unit" .


###  http://qudt.org/schema/qudt/UserQuantityKind
<http://qudt.org/schema/qudt/UserQuantityKind> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://qudt.org/schema/qudt/AbstractQuantityKind> ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> ;
                                                                 owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> ;
                                                                 owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> ;
                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://qudt.org/schema/qudt/hasQuantityKind> ;
                                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ;
                                               rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                               rdfs:label "User Quantity Kind" .


###  http://qudt.org/schema/qudt/Verifiable
<http://qudt.org/schema/qudt/Verifiable> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://qudt.org/schema/qudt/Aspect> .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#List
rdf:List rdf:type owl:Class .


###  http://www.w3.org/2006/time#TemporalEntity
<http://www.w3.org/2006/time#TemporalEntity> rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/ActuatableProperty
<http://www.w3.org/ns/sosa/ActuatableProperty> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.w3.org/ns/ssn/Property> ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/ns/sosa/isActedOnBy> ;
                                                                 owl:allValuesFrom <http://www.w3.org/ns/sosa/Actuation>
                                                               ] ;
                                               rdfs:comment "An actuatable quality (property, characteristic) of a FeatureOfInterest."@en ;
                                               rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                               rdfs:label "Actuatable Property"@en ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "An actuatable quality (property, characteristic) of a FeatureOfInterest."@en ;
                                               <http://www.w3.org/2004/02/skos/core#example> "A window actuator acts by changing the state between a frame and a window. The ability of the window to be opened and closed is its ActuatableProperty."@en .


###  http://www.w3.org/ns/sosa/Actuation
<http://www.w3.org/ns/sosa/Actuation> rdf:type owl:Class ;
                                      rdfs:subClassOf :Activity ,
                                                      :TopicSubject ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/sosa/actsOnProperty> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/sosa/ActuatableProperty>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/sosa/FeatureOfInterest>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/sosa/Result>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/sosa/madeByActuator> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/sosa/Actuator>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/sosa/usedProcedure> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/sosa/Procedure>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/sosa/actsOnProperty> ;
                                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                        owl:cardinality "1"^^xsd:nonNegativeInteger
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/sosa/madeByActuator> ;
                                                        owl:cardinality "1"^^xsd:nonNegativeInteger
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/sosa/resultTime> ;
                                                        owl:cardinality "1"^^xsd:nonNegativeInteger
                                                      ] ;
                                      rdfs:comment "An Actuation carries out an (Actuation) Procedure to change the state of the world using an Actuator."@en ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                      rdfs:label "Actuation"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "An Actuation carries out an (Actuation) Procedure to change the state of the world using an Actuator."@en ;
                                      <http://www.w3.org/2004/02/skos/core#example> "The activity of automatically closing a window if the temperature in a room drops below 20 degree Celsius. The activity is the Actuation and the device that closes the window is the Actuator. The Procedure is the rule, plan, or specification that defines the conditions that triggers the Actuation, here a drop in temperature. "@en .


###  http://www.w3.org/ns/sosa/ActuationCollection
<http://www.w3.org/ns/sosa/ActuationCollection> rdf:type owl:Class ;
                                                rdfs:subClassOf :Activity ,
                                                                :TopicSubject .


###  http://www.w3.org/ns/sosa/Actuator
<http://www.w3.org/ns/sosa/Actuator> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://www.w3.org/ns/ssn/System> ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/madeActuation> ;
                                                       owl:allValuesFrom <http://www.w3.org/ns/sosa/Actuation>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/ssn/forProperty> ;
                                                       owl:allValuesFrom <http://www.w3.org/ns/sosa/ActuatableProperty>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/ssn/implements> ;
                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ;
                                     rdfs:comment "A device that is used by, or implements, an (Actuation) Procedure that changes the state of the world."@en ;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                     rdfs:label "Actuator"@en ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "A device that is used by, or implements, an (Actuation) Procedure that changes the state of the world."@en ;
                                     <http://www.w3.org/2004/02/skos/core#example> "A window actuator for automatic window control, i.e., opening or closing the window."@en .


###  http://www.w3.org/ns/sosa/FeatureOfInterest
<http://www.w3.org/ns/sosa/FeatureOfInterest> rdf:type owl:Class ;
                                              rdfs:subClassOf :TopicSubject ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://www.w3.org/ns/sosa/hasSample> ;
                                                                owl:allValuesFrom <http://www.w3.org/ns/sosa/Sample>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://www.w3.org/ns/ssn/hasProperty> ;
                                                                owl:allValuesFrom <http://www.w3.org/ns/ssn/Property>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://www.w3.org/ns/ssn/hasProperty> ;
                                                                owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                              ] ;
                                              rdfs:comment "The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling."@en ;
                                              rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                              rdfs:label "Feature Of Interest"@en ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling."@en ;
                                              <http://www.w3.org/2004/02/skos/core#example> "When measuring the height of a tree, the height is the observed ObservableProperty, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuator."@en .


###  http://www.w3.org/ns/sosa/ObservableProperty
<http://www.w3.org/ns/sosa/ObservableProperty> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.w3.org/ns/ssn/Property> ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/ns/sosa/isObservedBy> ;
                                                                 owl:allValuesFrom <http://www.w3.org/ns/sosa/Sensor>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty [ owl:inverseOf <http://www.w3.org/ns/sosa/observedProperty>
                                                                                ] ;
                                                                 owl:allValuesFrom <http://www.w3.org/ns/sosa/Observation>
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty [ owl:inverseOf <http://www.w3.org/ns/ssn/isProxyFor>
                                                                                ] ;
                                                                 owl:allValuesFrom <http://www.w3.org/ns/ssn/Stimulus>
                                                               ] ;
                                               rdfs:comment "An observable quality (property, characteristic) of a FeatureOfInterest."@en ;
                                               rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                               rdfs:label "Observable Property"@en ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "An observable quality (property, characteristic) of a FeatureOfInterest."@en ;
                                               <http://www.w3.org/2004/02/skos/core#example> "The height of a tree, the depth of a water body, or the temperature of a surface are examples of observable properties, while the value of a classic car is not (directly) observable but asserted."@en .


###  http://www.w3.org/ns/sosa/Observation
<http://www.w3.org/ns/sosa/Observation> rdf:type owl:Class ;
                                        rdfs:subClassOf :Activity ,
                                                        :TopicSubject ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                          owl:allValuesFrom <http://www.w3.org/ns/sosa/FeatureOfInterest>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                          owl:allValuesFrom <http://www.w3.org/ns/sosa/Result>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/madeBySensor> ;
                                                          owl:allValuesFrom <http://www.w3.org/ns/sosa/Sensor>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                          owl:allValuesFrom <http://www.w3.org/ns/sosa/ObservableProperty>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/usedProcedure> ;
                                                          owl:allValuesFrom <http://www.w3.org/ns/sosa/Procedure>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/ssn/wasOriginatedBy> ;
                                                          owl:allValuesFrom <http://www.w3.org/ns/ssn/Stimulus>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                          owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/madeBySensor> ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/phenomenonTime> ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/ssn/wasOriginatedBy> ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/resultTime> ;
                                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                                        ] ;
                                        rdfs:comment "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."@en ;
                                        rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                        rdfs:label "Observation"@en ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."@en ;
                                        <http://www.w3.org/2004/02/skos/core#example> "The activity of estimating the intensity of an Earthquake using the Mercalli intensity scale is an Observation as is measuring the moment magnitude, i.e., the energy released by said earthquake."@en .


###  http://www.w3.org/ns/sosa/ObservationCollection
<http://www.w3.org/ns/sosa/ObservationCollection> rdf:type owl:Class ;
                                                  rdfs:subClassOf :Activity ,
                                                                  :TopicSubject .


###  http://www.w3.org/ns/sosa/Platform
<http://www.w3.org/ns/sosa/Platform> rdf:type owl:Class ;
                                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/hosts> ;
                                                       owl:allValuesFrom <http://www.w3.org/ns/ssn/System>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/ssn/inDeployment> ;
                                                       owl:allValuesFrom <http://www.w3.org/ns/ssn/Deployment>
                                                     ] ;
                                     rdfs:comment "A Platform is an entity that hosts other entities, particularly Sensors, Actuators, Samplers, and other Platforms."@en ;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                     rdfs:label "Platform"@en ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "A Platform is an entity that hosts other entities, particularly Sensors, Actuators, Samplers, and other Platforms."@en ;
                                     <http://www.w3.org/2004/02/skos/core#example> "A post, buoy, vehicle, ship, aircraft, satellite, cell-phone, human or animal may act as platforms for (technical or biological) sensors or actuators."@en .


###  http://www.w3.org/ns/sosa/Procedure
<http://www.w3.org/ns/sosa/Procedure> rdf:type owl:Class ;
                                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/ssn/hasInput> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/ssn/Input>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/ssn/hasOutput> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/ssn/Output>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/ssn/implementedBy> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/ssn/System>
                                                      ] ;
                                      rdfs:comment "A workflow, protocol, plan, algorithm, or computational method specifying how to make an Observation, create a Sample, or make a change to the state of the world (via an Actuator). A Procedure is re-usable, and might be involved in many Observations, Samplings, or Actuations. It explains the steps to be carried out to arrive at reproducible results."@en ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                      rdfs:label "Procedure"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "A workflow, protocol, plan, algorithm, or computational method specifying how to make an Observation, create a Sample, or make a change to the state of the world (via an Actuator). A Procedure is re-usable, and might be involved in many Observations, Samplings, or Actuations. It explains the steps to be carried out to arrive at reproducible results."@en ;
                                      <http://www.w3.org/2004/02/skos/core#example> "The measured wind speed differs depending on the height of the sensor above the surface, e.g., due to friction. Consequently, procedures for measuring wind speed define a standard height for anemometers above ground, typically 10m for meteorological measures and 2m in Agrometeorology. This definition of height, sensor placement, and so forth are defined by the Procedure."@en ;
                                      <http://www.w3.org/2004/02/skos/core#note> "Many observations may be created via the same Procedure, the same way as many tables are assembled using the same instructions (as information objects, not their concrete realization)."@en .


###  http://www.w3.org/ns/sosa/Property
<http://www.w3.org/ns/sosa/Property> rdf:type owl:Class ;
                                     rdfs:subClassOf :TopicSubject .


###  http://www.w3.org/ns/sosa/Result
<http://www.w3.org/ns/sosa/Result> rdf:type owl:Class ;
                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/isResultOf> ;
                                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ;
                                   rdfs:comment "The Result of an Observation, Actuation, or act of Sampling. To store an observation's simple result value one can use the hasSimpleResult property."@en ;
                                   rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                   rdfs:label "Result"@en ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "The Result of an Observation, Actuation, or act of Sampling. To store an observation's simple result value one can use the hasSimpleResult property."@en ;
                                   <http://www.w3.org/2004/02/skos/core#example> "The value 20 as the height of a certain tree together with the unit, e.g., Meter."@en .


###  http://www.w3.org/ns/sosa/Sample
<http://www.w3.org/ns/sosa/Sample> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                   <http://www.w3.org/ns/sosa/Result> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/isResultOf> ;
                                                     owl:allValuesFrom <http://www.w3.org/ns/sosa/Sampling>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/isSampleOf> ;
                                                     owl:allValuesFrom <http://www.w3.org/ns/sosa/FeatureOfInterest>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/isResultOf> ;
                                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/isSampleOf> ;
                                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ;
                                   rdfs:comment "A Sample is the result from an act of Sampling."@en ,
                                                "Feature which is intended to be representative of a FeatureOfInterest on which Observations may be made."@en ,
                                                "Physical samples are sometimes known as 'specimens'."@en ,
                                                """Samples are artifacts of an observational strategy, and have no significant function outside of their role in the observation process. The characteristics of the samples themselves are of little interest, except perhaps to the manager of a sampling campaign.

A Sample is intended to sample some FatureOfInterest, so there is an expectation of at least one isSampleOf property. However, in some cases the identity, and even the exact type, of the sampled feature may not be known when observations are made using the sampling features."""@en ;
                                   rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                   rdfs:label "Sample"@en ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Feature which is intended to be representative of a FeatureOfInterest on which Observations may be made."@en ;
                                   <http://www.w3.org/2004/02/skos/core#example> "A 'station' is essentially an identifiable locality where a sensor system or Procedure may be deployed and an observation made. In the context of the observation model, it connotes the 'world in the vicinity of the station', so the observed properties relate to the physical medium at the station, and not to any physical artifact such as a mooring, buoy, benchmark, monument, well, etc."@en ,
                                                                                 "A statistical sample is often designed to be characteristic of an entire population, so that observations can be made regarding the sample that provide a good estimate of the properties of the population."@en ;
                                   <http://www.w3.org/2004/02/skos/core#note> "A transient sample, such as a ships-track or flight-line, might be identified and described, but is unlikely to be revisited exactly."@en .


###  http://www.w3.org/ns/sosa/Sampler
<http://www.w3.org/ns/sosa/Sampler> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://www.w3.org/ns/ssn/System> ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://www.w3.org/ns/sosa/madeSampling> ;
                                                      owl:allValuesFrom <http://www.w3.org/ns/sosa/Sampling>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://www.w3.org/ns/ssn/implements> ;
                                                      owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                    ] ;
                                    rdfs:comment "A device that is used by, or implements, a Sampling Procedure to create or transform one or more samples."@en ;
                                    rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                    rdfs:label "Sampler"@en ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "A device that is used by, or implements, a Sampling Procedure to create or transform one or more samples."@en ;
                                    <http://www.w3.org/2004/02/skos/core#example> "A ball mill, diamond drill, hammer, hypodermic syringe and needle, image Sensor or a soil auger can all act as sampling devices (i.e., be Samplers). However, sometimes the distinction between the Sampler and the Sensor is not evident, as they are packaged as a unit. A Sampler need not be a physical device."@en .


###  http://www.w3.org/ns/sosa/Sampling
<http://www.w3.org/ns/sosa/Sampling> rdf:type owl:Class ;
                                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                       owl:allValuesFrom <http://www.w3.org/ns/sosa/FeatureOfInterest>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                       owl:allValuesFrom <http://www.w3.org/ns/sosa/Sample>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/madeBySampler> ;
                                                       owl:allValuesFrom <http://www.w3.org/ns/sosa/Sampler>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/usedProcedure> ;
                                                       owl:allValuesFrom <http://www.w3.org/ns/sosa/Procedure>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasResult> ;
                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/madeBySampler> ;
                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/resultTime> ;
                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                     ] ;
                                     rdfs:comment "An act of Sampling carries out a sampling Procedure to create or transform one or more samples."@en ;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                     rdfs:label "Sampling"@en ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "An act of Sampling carries out a sampling Procedure to create or transform one or more samples."@en ;
                                     <http://www.w3.org/2004/02/skos/core#example> "Crushing a rock sample in a ball mill."@en ,
                                                                                   "Digging a pit through a soil sequence."@en ,
                                                                                   "Dividing a field site into quadrants."@en ,
                                                                                   "Drawing blood from a patient."@en ,
                                                                                   "Drilling an observation well."@en ,
                                                                                   "Establishing a station for environmental monitoring."@en ,
                                                                                   "Registering an image of the landscape."@en ,
                                                                                   "Selecting a subset of a population."@en ,
                                                                                   "Sieving a powder to separate the subset finer than 100-mesh."@en ,
                                                                                   "Splitting a piece of drill-core to create two new samples."@en ,
                                                                                   "Taking a diamond-drill core from a rock outcrop."@en .


###  http://www.w3.org/ns/sosa/Sensor
<http://www.w3.org/ns/sosa/Sensor> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.w3.org/ns/ssn/System> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/madeObservation> ;
                                                     owl:allValuesFrom <http://www.w3.org/ns/sosa/Observation>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/observes> ;
                                                     owl:allValuesFrom <http://www.w3.org/ns/sosa/ObservableProperty>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/ssn/detects> ;
                                                     owl:allValuesFrom <http://www.w3.org/ns/ssn/Stimulus>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/ssn/implements> ;
                                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ;
                                   rdfs:comment "Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure. Sensors respond to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations, and generate a Result. Sensors can be hosted by Platforms."@en ;
                                   rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                   rdfs:label "Sensor"@en ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure. Sensors respond to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations, and generate a Result. Sensors can be hosted by Platforms."@en ;
                                   <http://www.w3.org/2004/02/skos/core#example> "Accelerometers, gyroscopes, barometers, magnetometers, and so forth are Sensors that are typically mounted on a modern smart phone (which acts as Platform). Other examples of sensors include the human eyes."@en .


###  http://www.w3.org/ns/ssn/Deployment
<http://www.w3.org/ns/ssn/Deployment> rdf:type owl:Class ;
                                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/ssn/deployedOnPlatform> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/sosa/Platform>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/ssn/deployedSystem> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/ssn/System>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/ns/ssn/forProperty> ;
                                                        owl:allValuesFrom <http://www.w3.org/ns/ssn/Property>
                                                      ] ;
                                      rdfs:comment "Describes the Deployment of one or more Systems for a particular purpose. Deployment may be done on a Platform."@en ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/ssn/> ;
                                      rdfs:label "Deployment"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Describes the Deployment of one or more Systems for a particular purpose. Deployment may be done on a Platform."@en ;
                                      <http://www.w3.org/2004/02/skos/core#example> "For example, a temperature Sensor deployed on a wall, or a whole network of Sensors deployed for an Observation campaign."@en .


###  http://www.w3.org/ns/ssn/Input
<http://www.w3.org/ns/ssn/Input> rdf:type owl:Class ;
                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                   owl:onProperty [ owl:inverseOf <http://www.w3.org/ns/ssn/hasInput>
                                                                  ] ;
                                                   owl:allValuesFrom <http://www.w3.org/ns/sosa/Procedure>
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty [ owl:inverseOf <http://www.w3.org/ns/ssn/hasInput>
                                                                  ] ;
                                                   owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                 ] ;
                                 rdfs:comment "Any information that is provided to a Procedure for its use."@en ;
                                 rdfs:isDefinedBy <http://www.w3.org/ns/ssn/> ;
                                 rdfs:label "Input"@en ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Any information that is provided to a Procedure for its use."@en .


###  http://www.w3.org/ns/ssn/Output
<http://www.w3.org/ns/ssn/Output> rdf:type owl:Class ;
                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                    owl:onProperty [ owl:inverseOf <http://www.w3.org/ns/ssn/hasOutput>
                                                                   ] ;
                                                    owl:allValuesFrom <http://www.w3.org/ns/sosa/Procedure>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty [ owl:inverseOf <http://www.w3.org/ns/ssn/hasOutput>
                                                                   ] ;
                                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                  ] ;
                                  rdfs:comment "Any information that is reported from a Procedure."@en ;
                                  rdfs:isDefinedBy <http://www.w3.org/ns/ssn/> ;
                                  rdfs:label "Output"@en ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Any information that is reported from a Procedure."@en .


###  http://www.w3.org/ns/ssn/Property
<http://www.w3.org/ns/ssn/Property> rdf:type owl:Class ;
                                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://www.w3.org/ns/ssn/isPropertyOf> ;
                                                      owl:allValuesFrom <http://www.w3.org/ns/sosa/FeatureOfInterest>
                                                    ] ;
                                    rdfs:comment "A quality of an entity. An aspect of an entity that is intrinsic to and cannot exist without the entity."@en ;
                                    rdfs:isDefinedBy <http://www.w3.org/ns/ssn/> ;
                                    rdfs:label "Property"@en ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "A quality of an entity. An aspect of an entity that is intrinsic to and cannot exist without the entity."@en .


###  http://www.w3.org/ns/ssn/Stimulus
<http://www.w3.org/ns/ssn/Stimulus> rdf:type owl:Class ;
                                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://www.w3.org/ns/ssn/isProxyFor> ;
                                                      owl:allValuesFrom <http://www.w3.org/ns/sosa/ObservableProperty>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty [ owl:inverseOf <http://www.w3.org/ns/ssn/detects>
                                                                     ] ;
                                                      owl:allValuesFrom <http://www.w3.org/ns/sosa/Sensor>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty [ owl:inverseOf <http://www.w3.org/ns/ssn/wasOriginatedBy>
                                                                     ] ;
                                                      owl:allValuesFrom <http://www.w3.org/ns/sosa/Observation>
                                                    ] ;
                                    rdfs:comment "An event in the real world that 'triggers' the Sensor. The properties associated to the Stimulus may be different to the eventual observed ObservableProperty. It is the event, not the object, that triggers the Sensor."@en ;
                                    rdfs:isDefinedBy <http://www.w3.org/ns/ssn/> ;
                                    rdfs:label "Stimulus"@en ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "An event in the real world that 'triggers' the Sensor. The properties associated to the Stimulus may be different to the eventual observed ObservableProperty. It is the event, not the object, that triggers the Sensor."@en .


###  http://www.w3.org/ns/ssn/System
<http://www.w3.org/ns/ssn/System> rdf:type owl:Class ;
                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://www.w3.org/ns/sosa/isHostedBy> ;
                                                    owl:allValuesFrom <http://www.w3.org/ns/sosa/Platform>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://www.w3.org/ns/ssn/hasDeployment> ;
                                                    owl:allValuesFrom <http://www.w3.org/ns/ssn/Deployment>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://www.w3.org/ns/ssn/hasSubSystem> ;
                                                    owl:allValuesFrom <http://www.w3.org/ns/ssn/System>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://www.w3.org/ns/ssn/implements> ;
                                                    owl:allValuesFrom <http://www.w3.org/ns/sosa/Procedure>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty [ owl:inverseOf <http://www.w3.org/ns/ssn/hasSubSystem>
                                                                   ] ;
                                                    owl:allValuesFrom <http://www.w3.org/ns/ssn/System>
                                                  ] ;
                                  rdfs:comment "System is a unit of abstraction for pieces of infrastructure that implement Procedures. A System may have components, its subsystems, which are other systems."@en ;
                                  rdfs:isDefinedBy <http://www.w3.org/ns/ssn/> ;
                                  rdfs:label "System"@en ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "System is a unit of abstraction for pieces of infrastructure that implement Procedures. A System may have components, its subsystems, which are other systems."@en .


###  http://xmlns.com/foaf/0.1/Agent
<http://xmlns.com/foaf/0.1/Agent> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Organization
<http://xmlns.com/foaf/0.1/Organization> rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
<http://xmlns.com/foaf/0.1/Person> rdf:type owl:Class .


###  https://www.w3.org/2019/wot/mqtt#Client
<https://www.w3.org/2019/wot/mqtt#Client> rdf:type owl:Class ;
                                          owl:equivalentClass :Client .


###  https://www.w3.org/2019/wot/mqtt#ControlPacket
<https://www.w3.org/2019/wot/mqtt#ControlPacket> rdf:type owl:Class ;
                                                 owl:equivalentClass :ControlPacket .


###  https://www.w3.org/2019/wot/mqtt#NetworkConnection
<https://www.w3.org/2019/wot/mqtt#NetworkConnection> rdf:type owl:Class ;
                                                     owl:equivalentClass :NetworkConnection .


###  https://www.w3.org/2019/wot/mqtt#PUBLISH
<https://www.w3.org/2019/wot/mqtt#PUBLISH> rdf:type owl:Class ;
                                           owl:equivalentClass :PublishPacket .


###  https://www.w3.org/2019/wot/mqtt#SUBSCRIBE
<https://www.w3.org/2019/wot/mqtt#SUBSCRIBE> rdf:type owl:Class ;
                                             owl:equivalentClass :SubscribePacket .


###  https://www.w3.org/2019/wot/mqtt#Server
<https://www.w3.org/2019/wot/mqtt#Server> rdf:type owl:Class ;
                                          owl:equivalentClass :Broker .


###  https://www.w3.org/2019/wot/mqtt#TopicFilter
<https://www.w3.org/2019/wot/mqtt#TopicFilter> rdf:type owl:Class ;
                                               owl:equivalentClass :TopicFilter .


###  https://www.w3.org/2019/wot/mqtt#TopicName
<https://www.w3.org/2019/wot/mqtt#TopicName> rdf:type owl:Class ;
                                             owl:equivalentClass :Topic .


###  https://www.w3.org/2019/wot/mqtt#UNSUBSCRIBE
<https://www.w3.org/2019/wot/mqtt#UNSUBSCRIBE> rdf:type owl:Class ;
                                               owl:equivalentClass :UnsubscribePacket .


###  https://www.w3id.org/MQTT4SSN-Ontology#Activity
:Activity rdf:type owl:Class ;
          rdfs:comment "An Generalisation of SOSA Observation, ObservationCollection, Actuation, ActuationCollection."@en ;
          rdfs:label "SOSA Activity"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ApplicationMessage
:ApplicationMessage rdf:type owl:Class ;
                    rdfs:comment "Protocol independent Application Message description"@en ;
                    rdfs:label "Application Message"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#AuthFixedHeader
:AuthFixedHeader rdf:type owl:Class ;
                 rdfs:subClassOf :FixedHeader ;
                 rdfs:comment "The Fixed Header of an AUTH packet."@en ;
                 rdfs:label "MQTT AUTH Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#AuthPacket
:AuthPacket rdf:type owl:Class ;
            rdfs:subClassOf :ControlPacket ;
            rdfs:comment "An MQTT Control Packet used to perform extended authentication exchanges between Client and Server."@en ;
            rdfs:label "MQTT AUTH Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#AuthProperties
:AuthProperties rdf:type owl:Class ;
                rdfs:subClassOf :Properties ;
                rdfs:comment "Properties section of the AUTH packet variable header in MQTT 5.0 for Enhanced Authentication (e.g., Authentication Method, Authentication Data, Reason String, User Properties)."@en ;
                rdfs:label "MQTT Auth Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#AuthVariableHeader
:AuthVariableHeader rdf:type owl:Class ;
                    rdfs:subClassOf :VariableHeader ;
                    rdfs:comment "The Variable Header of an AUTH packet."@en ;
                    rdfs:label "MQTT AUTH Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#Broker
:Broker rdf:type owl:Class ;
        rdfs:subClassOf :NetworkParticipant ;
        rdfs:comment "An MQTT Broker that accepts client connections, manages subscriptions, and forwards published messages."@en ;
        rdfs:label "MQTT Broker"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#Client
:Client rdf:type owl:Class ;
        rdfs:subClassOf :NetworkParticipant ;
        rdfs:comment "An MQTT Client that connects to an MQTT Broker and publishes or subscribes to MQTT Topics; may host SOSA systems."@en ;
        rdfs:label "MQTT Client"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ConnackFixedHeader
:ConnackFixedHeader rdf:type owl:Class ;
                    rdfs:subClassOf :FixedHeader ;
                    rdfs:comment "The Fixed Header of an CONNACK packet."@en ;
                    rdfs:label "MQTT CONNACK Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ConnackPacket
:ConnackPacket rdf:type owl:Class ;
               rdfs:subClassOf :ControlPacket ;
               rdfs:comment "An MQTT Control Packet sent by the Server in response to a CONNECT Packet, indicating the result of the connection attempt."@en ;
               rdfs:label "MQTT CONNACK Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ConnackProperties
:ConnackProperties rdf:type owl:Class ;
                   rdfs:subClassOf :Properties ;
                   rdfs:comment "Properties section of the CONNACK packet variable header in MQTT 5.0 (e.g., Session Expiry Interval, Receive Maximum, Maximum QoS, Retain Available, Assigned Client Identifier, Server Keep Alive, Response Information, Server Reference, capability flags, User Properties)."@en ;
                   rdfs:label "MQTT Connack Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ConnackVariableHeader
:ConnackVariableHeader rdf:type owl:Class ;
                       rdfs:subClassOf :VariableHeader ;
                       rdfs:comment "The Variable Header of an CONNACK packet."@en ;
                       rdfs:label "MQTT CONNACK Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ConnectFixedHeader
:ConnectFixedHeader rdf:type owl:Class ;
                    rdfs:subClassOf :FixedHeader ;
                    rdfs:comment "The Fixed Header of an CONNECT packet."@en ;
                    rdfs:label "MQTT CONNECT Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ConnectPacket
:ConnectPacket rdf:type owl:Class ;
               rdfs:subClassOf :ControlPacket ;
               rdfs:comment "An MQTT Control Packet sent by a Client to establish a connection to an MQTT Server."@en ;
               rdfs:label "MQTT CONNECT Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ConnectPayload
:ConnectPayload rdf:type owl:Class ;
                rdfs:subClassOf :Payload ;
                rdfs:comment "CONNECT packet payload in MQTT 5.0. Contains Client Identifier, Will Properties/Topic/Payload (if Will Flag=1), User Name (if User Name Flag=1), and Password (if Password Flag=1)."@en ;
                rdfs:label "MQTT CONNECT Payload"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ConnectProperties
:ConnectProperties rdf:type owl:Class ;
                   rdfs:subClassOf :Properties ;
                   rdfs:comment "Properties section of the CONNECT packet variable header in MQTT 5.0 (e.g., Session Expiry Interval, Receive Maximum, Maximum Packet Size, Authentication Method/Data, Request Problem/Response Information, User Properties)."@en ;
                   rdfs:label "MQTT Connect Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ConnectVariableHeader
:ConnectVariableHeader rdf:type owl:Class ;
                       rdfs:subClassOf :VariableHeader ;
                       rdfs:comment "The Variable Header of an CONNECT packet."@en ;
                       rdfs:label "MQTT CONNECT Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#ControlPacket
:ControlPacket rdf:type owl:Class ;
               rdfs:comment "An MQTT Control Packet such as PUBLISH, SUBSCRIBE, or UNSUBSCRIBE."@en ;
               rdfs:label "MQTT Control Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#DisconnectFixedHeader
:DisconnectFixedHeader rdf:type owl:Class ;
                       rdfs:subClassOf :FixedHeader ;
                       rdfs:comment "The Fixed Header of a DISCONNECT packet."@en ;
                       rdfs:label "MQTT DISCONNECT Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#DisconnectPacket
:DisconnectPacket rdf:type owl:Class ;
                  rdfs:subClassOf :ControlPacket ;
                  rdfs:comment "An MQTT Control Packet sent by a Client or Server to indicate that the connection is being closed intentionally."@en ;
                  rdfs:label "MQTT DISCONNECT Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#DisconnectProperties
:DisconnectProperties rdf:type owl:Class ;
                      rdfs:subClassOf :Properties ;
                      rdfs:comment "Properties section of the DISCONNECT packet variable header in MQTT 5.0 (e.g., Session Expiry Interval, Reason String, Server Reference, User Properties) accompanying the Disconnect Reason Code."@en ;
                      rdfs:label "MQTT Disconnect Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#DisconnectVariableHeader
:DisconnectVariableHeader rdf:type owl:Class ;
                          rdfs:subClassOf :VariableHeader ;
                          rdfs:comment "The Variable Header of a DISCONNECT packet."@en ;
                          rdfs:label "MQTT DISCONNECT Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#FixedHeader
:FixedHeader rdf:type owl:Class ;
             rdfs:comment "The header present in all MQTT Control Packets, containing the packet type and flags."@en ;
             rdfs:label "MQTT Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#NetworkConnection
:NetworkConnection rdf:type owl:Class ;
                   rdfs:subClassOf :NetworkEntity ;
                   rdfs:comment "A transport-layer connection between an MQTT Client and an MQTT Broker (optionally secured with TLS)."@en ;
                   rdfs:label "MQTT Network Connection"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#NetworkEntity
:NetworkEntity rdf:type owl:Class ;
               rdfs:comment "Entities involved in a network."@en ;
               rdfs:label "Network Entity"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#NetworkParticipant
:NetworkParticipant rdf:type owl:Class ;
                    rdfs:subClassOf :NetworkEntity ;
                    rdfs:comment "An entity participating in an MQTT network, such as an MQTT Client or an MQTT Broker."@en ;
                    rdfs:label "MQTT Network Participant"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#NetworkSession
:NetworkSession rdf:type owl:Class ;
                rdfs:subClassOf :NetworkEntity ;
                rdfs:comment "Persistent Session across a sequence of Network Connections."@en ;
                rdfs:label "MQTT Network Session"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#Payload
:Payload rdf:type owl:Class ;
         rdfs:comment "The application data carried by an MQTT Control Packet."@en ;
         rdfs:label "MQTT Payload"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PingreqFixedHeader
:PingreqFixedHeader rdf:type owl:Class ;
                    rdfs:subClassOf :FixedHeader ;
                    rdfs:comment "The Fixed Header of a PINGREQ packet."@en ;
                    rdfs:label "MQTT PINGREQ Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PingreqPacket
:PingreqPacket rdf:type owl:Class ;
               rdfs:subClassOf :ControlPacket ;
               rdfs:comment "An MQTT Control Packet sent by a Client to the Server to indicate that the Client is alive and to maintain the network connection."@en ;
               rdfs:label "MQTT PINGREQ Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PingrespFixedHeader
:PingrespFixedHeader rdf:type owl:Class ;
                     rdfs:subClassOf :FixedHeader ;
                     rdfs:comment "The Fixed Header of a PINGRESP packet."@en ;
                     rdfs:label "MQTT PINGRESP Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PingrespPacket
:PingrespPacket rdf:type owl:Class ;
                rdfs:subClassOf :ControlPacket ;
                rdfs:comment "An MQTT Control Packet sent by the Server in response to a PINGREQ Packet to indicate that the Server is alive."@en ;
                rdfs:label "MQTT PINGRESP Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#Properties
:Properties rdf:type owl:Class ;
            rdfs:comment "Abstract superclass for MQTT 5.0 Property collections. Each concrete *Properties class represents the Properties section of a specific Control Packet or Payload, encoded as a sequence of Property Identifiers and typed values."@en ;
            rdfs:label "MQTT Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubackFixedHeader
:PubackFixedHeader rdf:type owl:Class ;
                   rdfs:subClassOf :FixedHeader ;
                   rdfs:comment "The Fixed Header of a PUBACK packet."@en ;
                   rdfs:label "MQTT PUBACK Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubackPacket
:PubackPacket rdf:type owl:Class ;
              rdfs:subClassOf :ControlPacket ;
              rdfs:comment "An MQTT Control Packet sent by a Receiver to acknowledge receipt of a PUBLISH Packet with QoS 1."@en ;
              rdfs:label "MQTT PUBACK Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubackProperties
:PubackProperties rdf:type owl:Class ;
                  rdfs:subClassOf :Properties ;
                  rdfs:comment "Properties section of the PUBACK packet variable header in MQTT 5.0 (e.g., Reason String, User Properties) accompanying the PUBACK Reason Code."@en ;
                  rdfs:label "MQTT Puback Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubackVariableHeader
:PubackVariableHeader rdf:type owl:Class ;
                      rdfs:subClassOf :VariableHeader ;
                      rdfs:comment "The Variable Header of a PUBACK packet."@en ;
                      rdfs:label "MQTT PUBACK Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubcompFixedHeader
:PubcompFixedHeader rdf:type owl:Class ;
                    rdfs:subClassOf :FixedHeader ;
                    rdfs:comment "The Fixed Header of a PUBCOMP packet."@en ;
                    rdfs:label "MQTT PUBCOMP Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubcompPacket
:PubcompPacket rdf:type owl:Class ;
               rdfs:subClassOf :ControlPacket ;
               rdfs:comment "An MQTT Control Packet sent by a Receiver as the final acknowledgement in the QoS 2 publish flow."@en ;
               rdfs:label "MQTT PUBCOMP Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubcompProperties
:PubcompProperties rdf:type owl:Class ;
                   rdfs:subClassOf :Properties ;
                   rdfs:comment "Properties section of the PUBCOMP packet variable header in MQTT 5.0 (e.g., Reason String, User Properties) accompanying the PUBCOMP Reason Code."@en ;
                   rdfs:label "MQTT Pubcomp Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubcompVariableHeader
:PubcompVariableHeader rdf:type owl:Class ;
                       rdfs:subClassOf :VariableHeader ;
                       rdfs:comment "The Variable Header of a PUBCOMP packet."@en ;
                       rdfs:label "MQTT PUBCOMP Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PublishFixedHeader
:PublishFixedHeader rdf:type owl:Class ;
                    rdfs:subClassOf :FixedHeader ;
                    rdfs:comment "The Fixed Header used in PUBLISH packets."@en ;
                    rdfs:label "MQTT PUBLISH Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PublishPacket
:PublishPacket rdf:type owl:Class ;
               rdfs:subClassOf :ControlPacket ;
               rdfs:comment "An MQTT Control Packet used by an MQTT Client to publish an application message to an MQTT Topic."@en ;
               rdfs:label "MQTT PUBLISH Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PublishPayload
:PublishPayload rdf:type owl:Class ;
                rdfs:subClassOf :Payload ;
                rdfs:comment "The payload of a PUBLISH packet (application message body)."@en ;
                rdfs:label "MQTT PUBLISH Payload"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PublishProperties
:PublishProperties rdf:type owl:Class ;
                   rdfs:subClassOf :Properties ;
                   rdfs:comment "Properties section of the PUBLISH packet variable header in MQTT 5.0 (e.g., Payload Format Indicator, Message Expiry Interval, Topic Alias, Response Topic, Correlation Data, Subscription Identifier(s), Content Type, User Properties)."@en ;
                   rdfs:label "MQTT Publish Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PublishVariableHeader
:PublishVariableHeader rdf:type owl:Class ;
                       rdfs:subClassOf :VariableHeader ;
                       rdfs:comment "The Variable Header of a PUBLISH packet; includes the MQTT Topic and optionally a packet identifier."@en ;
                       rdfs:label "MQTT PUBLISH Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubrecFixedHeader
:PubrecFixedHeader rdf:type owl:Class ;
                   rdfs:subClassOf :FixedHeader ;
                   rdfs:comment "The Fixed Header of a PUBREC packet."@en ;
                   rdfs:label "MQTT PUBREC Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubrecPacket
:PubrecPacket rdf:type owl:Class ;
              rdfs:subClassOf :ControlPacket ;
              rdfs:comment "An MQTT Control Packet sent by a Receiver to indicate that a PUBLISH Packet with QoS 2 has been received and is being processed."@en ;
              rdfs:label "MQTT PUBREC Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubrecProperties
:PubrecProperties rdf:type owl:Class ;
                  rdfs:subClassOf :Properties ;
                  rdfs:comment "Properties section of the PUBREC packet variable header in MQTT 5.0 (e.g., Reason String, User Properties) accompanying the PUBREC Reason Code."@en ;
                  rdfs:label "MQTT Pubrec Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubrecVariableHeader
:PubrecVariableHeader rdf:type owl:Class ;
                      rdfs:subClassOf :VariableHeader ;
                      rdfs:comment "The Variable Header of a PUBREC packet."@en ;
                      rdfs:label "MQTT PUBREC Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubrelFixedHeader
:PubrelFixedHeader rdf:type owl:Class ;
                   rdfs:subClassOf :FixedHeader ;
                   rdfs:comment "The Fixed Header of an PUBREL packet."@en ;
                   rdfs:label "MQTT PUBREL Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubrelPacket
:PubrelPacket rdf:type owl:Class ;
              rdfs:subClassOf :ControlPacket ;
              rdfs:comment "An MQTT Control Packet sent by a Sender in the QoS 2 publish flow to release a previously received PUBREC response."@en ;
              rdfs:label "MQTT PUBREL Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubrelProperties
:PubrelProperties rdf:type owl:Class ;
                  rdfs:subClassOf :Properties ;
                  rdfs:comment "Properties section of the PUBREL packet variable header in MQTT 5.0 (e.g., Reason String, User Properties) accompanying the PUBREL Reason Code."@en ;
                  rdfs:label "MQTT Pubrel Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#PubrelVariableHeader
:PubrelVariableHeader rdf:type owl:Class ;
                      rdfs:subClassOf :VariableHeader ;
                      rdfs:comment "The Variable Header of an PUBREL packet."@en ;
                      rdfs:label "MQTT PUBREL Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubackFixedHeader
:SubackFixedHeader rdf:type owl:Class ;
                   rdfs:subClassOf :FixedHeader ;
                   rdfs:comment "The Fixed Header of a SUBACK packet."@en ;
                   rdfs:label "MQTT SUBACK Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubackPacket
:SubackPacket rdf:type owl:Class ;
              rdfs:subClassOf :ControlPacket ;
              rdfs:comment "An MQTT Control Packet sent by the Server to acknowledge a SUBSCRIBE request and indicate the assigned subscription options or failure codes."@en ;
              rdfs:label "MQTT SUBACK Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubackPayload
:SubackPayload rdf:type owl:Class ;
               rdfs:subClassOf :Payload ;
               rdfs:comment "SUBACK packet payload in MQTT 5.0. Sequence of Suback Reason Codes, one for each Topic Filter in the corresponding SUBSCRIBE request."@en ;
               rdfs:label "MQTT SUBACK Payload"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubackProperties
:SubackProperties rdf:type owl:Class ;
                  rdfs:subClassOf :Properties ;
                  rdfs:comment "Properties section of the SUBACK packet variable header in MQTT 5.0 (e.g., Reason String, User Properties) accompanying the Suback Payload."@en ;
                  rdfs:label "MQTT Suback Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubackVariableHeader
:SubackVariableHeader rdf:type owl:Class ;
                      rdfs:subClassOf :VariableHeader ;
                      rdfs:comment "The Variable Header of a SUBACK packet."@en ;
                      rdfs:label "MQTT SUBACK Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubscribeFixedHeader
:SubscribeFixedHeader rdf:type owl:Class ;
                      rdfs:subClassOf :FixedHeader ;
                      rdfs:comment "The Fixed Header used in SUBSCRIBE packets."@en ;
                      rdfs:label "MQTT SUBSCRIBE Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubscribePacket
:SubscribePacket rdf:type owl:Class ;
                 rdfs:subClassOf :ControlPacket ;
                 rdfs:comment "An MQTT Control Packet used by an MQTT Client to subscribe to one or more MQTT Topic Filters."@en ;
                 rdfs:label "MQTT SUBSCRIBE Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubscribePayload
:SubscribePayload rdf:type owl:Class ;
                  rdfs:subClassOf :Payload ;
                  rdfs:comment "The payload of a SUBSCRIBE packet, listing MQTT Subscription Entries."@en ;
                  rdfs:label "MQTT SUBSCRIBE Payload"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubscribeProperties
:SubscribeProperties rdf:type owl:Class ;
                     rdfs:subClassOf :Properties ;
                     rdfs:comment "Properties section of the SUBSCRIBE packet variable header in MQTT 5.0 (e.g., Subscription Identifier, User Properties)."@en ;
                     rdfs:label "MQTT Subscribe Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubscribeVariableHeader
:SubscribeVariableHeader rdf:type owl:Class ;
                         rdfs:subClassOf :VariableHeader ;
                         rdfs:comment "The Variable Header of a SUBSCRIBE packet; typically includes the packet identifier."@en ;
                         rdfs:label "MQTT SUBSCRIBE Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#SubscriptionEntry
:SubscriptionEntry rdf:type owl:Class ;
                   rdfs:comment "A single requested subscription consisting of an MQTT Topic Filter and an associated QoS level."@en ;
                   rdfs:label "MQTT Subscription Entry"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#Topic
:Topic rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :hasActObsSubject ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass [ rdf:type owl:Class ;
                                       owl:unionOf ( <http://www.w3.org/ns/sosa/Actuation>
                                                     <http://www.w3.org/ns/sosa/ActuationCollection>
                                                     <http://www.w3.org/ns/sosa/Observation>
                                                     <http://www.w3.org/ns/sosa/ObservationCollection>
                                                   )
                                     ]
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasFoISubject ;
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasPropertySubject ;
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger
                       ] ;
       rdfs:comment "A hierarchical MQTT Topic to which MQTT Clients publish and/or subscribe."@en ;
       rdfs:label "MQTT Topic"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#TopicFilter
:TopicFilter rdf:type owl:Class ;
             rdfs:comment "A filter expression (e.g., with wildcards) used in SUBSCRIBE/UNSUBSCRIBE to match MQTT Topics."@en ;
             rdfs:label "MQTT Topic Filter"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#TopicSubject
:TopicSubject rdf:type owl:Class ;
              rdfs:comment "A conceptual subject carried on an MQTT Topic, e.g., an Observation, Actuation, Property, or Feature of Interest."@en ;
              rdfs:label "MQTT Topic Subject"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UnsubackFixedHeader
:UnsubackFixedHeader rdf:type owl:Class ;
                     rdfs:subClassOf :FixedHeader ;
                     rdfs:comment "The Fixed Header of an UNSUBACK packet."@en ;
                     rdfs:label "MQTT UNSUBACK Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPacket
:UnsubackPacket rdf:type owl:Class ;
                rdfs:subClassOf :ControlPacket ;
                rdfs:comment "An MQTT Control Packet sent by the Server to acknowledge an UNSUBSCRIBE request."@en ;
                rdfs:label "MQTT UNSUBACK Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UnsubackPayload
:UnsubackPayload rdf:type owl:Class ;
                 rdfs:subClassOf :Payload ;
                 rdfs:comment "UNSUBACK packet payload in MQTT 5.0. Sequence of Unsuback Reason Codes, one for each Topic Filter in the corresponding UNSUBSCRIBE request."@en ;
                 rdfs:label "MQTT UNSUBACK Payload"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UnsubackProperties
:UnsubackProperties rdf:type owl:Class ;
                    rdfs:subClassOf :Properties ;
                    rdfs:comment "Properties section of the UNSUBACK packet variable header in MQTT 5.0 (e.g., Reason String, User Properties) accompanying the Unsuback Payload."@en ;
                    rdfs:label "MQTT Unsuback Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UnsubackVariableHeader
:UnsubackVariableHeader rdf:type owl:Class ;
                        rdfs:subClassOf :VariableHeader ;
                        rdfs:comment "The Variable Header of an UNSUBACK packet."@en ;
                        rdfs:label "MQTT UNSUBACK Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeFixedHeader
:UnsubscribeFixedHeader rdf:type owl:Class ;
                        rdfs:subClassOf :FixedHeader ;
                        rdfs:comment "The Fixed Header used in UNSUBSCRIBE packets."@en ;
                        rdfs:label "MQTT UNSUBSCRIBE Fixed Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribePacket
:UnsubscribePacket rdf:type owl:Class ;
                   rdfs:subClassOf :ControlPacket ;
                   rdfs:comment "An MQTT Control Packet used by an MQTT Client to remove one or more subscriptions."@en ;
                   rdfs:label "MQTT UNSUBSCRIBE Packet"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribePayload
:UnsubscribePayload rdf:type owl:Class ;
                    rdfs:subClassOf :Payload ;
                    rdfs:comment "The payload of an UNSUBSCRIBE packet, listing MQTT Topic Filters to be removed."@en ;
                    rdfs:label "MQTT UNSUBSCRIBE Payload"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeProperties
:UnsubscribeProperties rdf:type owl:Class ;
                       rdfs:subClassOf :Properties ;
                       rdfs:comment "Properties section of the UNSUBSCRIBE packet variable header in MQTT 5.0 (e.g., User Properties)."@en ;
                       rdfs:label "MQTT Unsubscribe Properties"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UnsubscribeVariableHeader
:UnsubscribeVariableHeader rdf:type owl:Class ;
                           rdfs:subClassOf :VariableHeader ;
                           rdfs:comment "The Variable Header of an UNSUBSCRIBE packet."@en ;
                           rdfs:label "MQTT UNSUBSCRIBE Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#UserProperty
:UserProperty rdf:type owl:Class ;
              rdfs:comment "MQTT 5.0 User Property. A UTF-8 String Pair (Name, Value) that can appear in many packet property sets. Semantics are application-defined."@en ;
              rdfs:label "User Property"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#VariableHeader
:VariableHeader rdf:type owl:Class ;
                rdfs:comment "The optional header carrying packet-specific metadata (e.g., packet identifier, MQTT Topic name)."@en ;
                rdfs:label "MQTT Variable Header"@en .


###  https://www.w3id.org/MQTT4SSN-Ontology#WillProperties
:WillProperties rdf:type owl:Class ;
                rdfs:comment "Will Properties in the CONNECT payload in MQTT 5.0 (e.g., Will Delay Interval, Payload Format Indicator, Message Expiry Interval, Content Type, Response Topic, Correlation Data, User Properties) applying to the Will Message."@en ;
                rdfs:label "MQTT Will Properties"@en .


