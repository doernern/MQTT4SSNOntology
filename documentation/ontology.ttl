###  http://qudt.org/schema/qudt/example
<http://qudt.org/schema/qudt/example> rdf:type owl:AnnotationProperty ;
                                      <http://purl.org/dc/terms/description> """
  The 'qudt:example' property is used to annotate an instance of a class with a reference to a concept that is an example. 
  The type of this property is 'rdf:Property'. 
  This allows both scalar and object ranges.
  """ ;
                                      rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                      rdfs:label "example" .


###  http://qudt.org/schema/qudt/exponent
<http://qudt.org/schema/qudt/exponent> rdf:type owl:AnnotationProperty ;
                                       <http://purl.org/dc/terms/description> "This property relates a factor unit its exponent"^^rdf:HTML ;
                                       <http://qudt.org/schema/qudt/plainTextDescription> "Defines the exponent of a factor unit" ;
                                       rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                       rdfs:label "exponent" .


###  http://qudt.org/schema/qudt/expression
<http://qudt.org/schema/qudt/expression> rdf:type owl:AnnotationProperty ;
                                         <http://purl.org/dc/terms/description> """
  An 'expression' is a finite combination of symbols that are well-formed according to rules that apply to units of measure, quantity kinds and their dimensions.
  """ ;
                                         rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                         rdfs:label "expression" .


###  http://qudt.org/schema/qudt/fieldCode
<http://qudt.org/schema/qudt/fieldCode> rdf:type owl:AnnotationProperty ;
                                        <http://qudt.org/schema/qudt/plainTextDescription> """
  A field code is a generic property for representing unique codes that make up other identifiers. 
  For example each QuantityKind class caries a domain code as its field code.
  """ ;
                                        rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                        rdfs:label "field code" .


###  http://qudt.org/schema/qudt/figure
<http://qudt.org/schema/qudt/figure> rdf:type owl:AnnotationProperty ;
