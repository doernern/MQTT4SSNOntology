                :PubackPacket
                :PubcompPacket
                :PublishPacket
                :PubrecPacket
                :PubrelPacket
                :SubackPacket
                :SubscribePacket
                :UnsubackPacket
                :UnsubscribePacket
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AuthProperties
                :ConnackProperties
                :ConnectProperties
                :DisconnectProperties
                :PubackProperties
                :PubcompProperties
                :PublishProperties
                :PubrecProperties
                :PubrelProperties
                :SubackProperties
                :SubscribeProperties
                :UnsubackProperties
                :UnsubscribeProperties
              )
] .


[ rdf:type owl:AllDisjointClasses ;
