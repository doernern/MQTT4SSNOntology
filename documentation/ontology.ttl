                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableISOUnit> ;
                                                             owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableImperialUnit> ;
                                                             owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableSIUnit> ;
                                                             owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableUSCustomaryUnit> ;
                                                             owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableUnit> ;
                                                             owl:allValuesFrom <http://qudt.org/schema/qudt/Unit>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/belongsToSystemOfQuantities> ;
                                                             owl:allValuesFrom <http://qudt.org/schema/qudt/SystemOfQuantityKinds>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/dimensionVectorForSI> ;
