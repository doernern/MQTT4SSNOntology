                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/hasUnit> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/relativeStandardUncertainty> ;
                                                             owl:allValuesFrom xsd:double
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/standardUncertainty> ;
                                                             owl:allValuesFrom xsd:decimal
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/standardUncertaintySN> ;
                                                             owl:allValuesFrom xsd:double
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/relativeStandardUncertainty> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/standardUncertainty> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/standardUncertaintySN> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ;
                                           <http://purl.org/dc/terms/description> """
  <p><em>Quantifiable</em> is an aspect class that affords to an entity properties for being measurable,
   observable, or countable.
  </p>"""^^rdf:HTML ;
                                           rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
