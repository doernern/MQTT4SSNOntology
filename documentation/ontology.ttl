###  https://www.w3id.org/MQTT4SSN-Ontology#hasUserProperty
:hasUserProperty rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :AuthProperties
                                             :ConnackProperties
                                             :ConnectProperties
                                             :DisconnectProperties
                                             :PubackProperties
                                             :PubcompProperties
                                             :PublishProperties
                                             :PubrecProperties
                                             :PubrelProperties
                                             :SubackProperties
                                             :SubscribeProperties
                                             :UnsubackProperties
                                             :UnsubscribeProperties
                                             :WillProperties
                                           )
                             ] ;
                 rdfs:range :UserProperty ;
                 rdfs:comment "Links a Properties collection to one contained UserProperty (Name/Value pair). Multiple values may occur."@en ;
                 rdfs:label "has User Property"@en .


