                :DisconnectVariableHeader
                :PubackVariableHeader
                :PubcompVariableHeader
                :PublishVariableHeader
                :PubrecVariableHeader
                :PubrelVariableHeader
                :SubackVariableHeader
                :SubscribeVariableHeader
                :UnsubackVariableHeader
                :UnsubscribeVariableHeader
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :ConnectPayload
                :PublishPayload
                :SubackPayload
                :SubscribePayload
                :UnsubackPayload
                :UnsubscribePayload
              )
] .


[ rdf:type owl:AllDisjointProperties ;
  owl:members ( :applicationMessageEncodesActuation
                :applicationMessageEncodesActuationCollection
                :applicationMessageEncodesObservation
                :applicationMessageEncodesObservationCollection
              )
] .


[ rdf:type owl:AllDisjointProperties ;
  owl:members ( :hasActObsSubject
                :hasFoISubject
                :hasPropertySubject
              )
] .


[ rdf:type owl:AllDisjointProperties ;
  owl:members ( :hasAuthFixedHeader
                :hasConnackFixedHeader
                :hasConnectFixedHeader
                :hasDisconnectFixedHeader
                :hasPingreqFixedHeader
                :hasPingrespFixedHeader
                :hasPubackFixedHeader
                :hasPubcompFixedHeader
                :hasPublishFixedHeader
                :hasPubrecFixedHeader
                :hasPubrelFixedHeader
                :hasSubackFixedHeader
                :hasSubscribeFixedHeader
                :hasUnsubackFixedHeader
                :hasUnsubscribeFixedHeader
              )
] .


[ rdf:type owl:AllDisjointProperties ;
  owl:members ( :hasAuthVariableHeader
                :hasConnackVariableHeader
                :hasConnectVariableHeader
                :hasDisconnectVariableHeader
                :hasPubackVariableHeader
                :hasPubcompVariableHeader
                :hasPublishVariableHeader
                :hasPubrecVariableHeader
                :hasPubrelVariableHeader
                :hasSubackVariableHeader
