                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/hasDimensionVector> ;
                                                             owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKindDimensionVector>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/iec61360Code> ;
                                                             owl:allValuesFrom xsd:string
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/mathMLdefinition> ;
                                                             owl:allValuesFrom xsd:string
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/qkdvDenominator> ;
                                                             owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKindDimensionVector>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/qkdvNumerator> ;
                                                             owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKindDimensionVector>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableCGSUnit> ;
                                                             owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableISOUnit> ;
                                                             owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableImperialUnit> ;
                                                             owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableSIUnit> ;
                                                             owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableUSCustomaryUnit> ;
                                                             owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/applicableUnit> ;
                                                             owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/hasDimensionVector> ;
                                                             owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/hasDimensionVector> ;
                                                             owl:cardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/dimensionVectorForSI> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/hasDimensionVector> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/qkdvDenominator> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/qkdvNumerator> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/baseCGSUnitDimensions> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/baseISOUnitDimensions> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/baseImperialUnitDimensions> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/baseSIUnitDimensions> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/baseUSCustomaryUnitDimensions> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/latexDefinition> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://qudt.org/schema/qudt/mathMLdefinition> ;
                                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                           ] ;
                                           <http://purl.org/dc/terms/description> """
  <p>A <em>Quantity Kind</em> is any observable property that can be  measured and quantified numerically. 
  Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. 
  Less familiar examples include currency, interest rate, price to earning ratio, and information capacity.
  </p>"""^^rdf:HTML ;
                                           <http://qudt.org/schema/qudt/informativeReference> "http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=112-01-04"^^xsd:anyURI ;
                                           rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                           rdfs:label "Quantity Kind" .


###  http://qudt.org/schema/qudt/QuantityKindDimensionVector
<http://qudt.org/schema/qudt/QuantityKindDimensionVector> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://qudt.org/schema/qudt/Concept> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://qudt.org/schema/qudt/hasReferenceQuantityKind> ;
                                                                            owl:allValuesFrom <http://qudt.org/schema/qudt/QuantityKind>
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> ;
                                                                            owl:allValuesFrom xsd:integer
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> ;
                                                                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://qudt.org/schema/qudt/latexSymbol> ;
                                                                            owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> ;
                                                                            owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent> ;
                                                                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://qudt.org/schema/qudt/latexDefinition> ;
                                                                            owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                          ] ;
                                                          <http://purl.org/dc/terms/description> """
 $\\text{Quantity Kind Dimension Vector}$ describes the dimensionality of a quantity kind in the context of a system of units. 
 In the SI system of units, the dimensions of a quantity kind are expressed as a product of the basic
  physical dimensions mass ($M$), length ($L$), time ($T$) current ($I$), amount of substance ($N$),
   luminous intensity ($J$) and absolute temperature 
   ($\\theta$) as $dim \\, Q = L^{\\alpha} \\, M^{\\beta} \\, T^{\\gamma} \\, I ^{\\delta} \\, \\theta ^{\\epsilon} \\, N^{\\eta} \\, J ^{\\nu}$.


  The rational powers of the dimensional exponents, $\\alpha, \\, \\beta, \\, \\gamma, \\, \\delta, \\, \\epsilon, \\, \\eta, \\, \\nu$, are positive, negative, or zero.

  For example, the dimension of the physical quantity kind $\\it{speed}$ is $\\boxed{length/time}$, $L/T$ or $LT^{-1}$,
   and the dimension of the physical quantity kind force is $\\boxed{mass \\times acceleration}$ or $\\boxed{mass \\times (length/time)/time}$, $ML/T^2$ or $MLT^{-2}$ respectively.
 """^^<http://qudt.org/schema/qudt/LatexString> ;
                                                          <http://qudt.org/schema/qudt/informativeReference> "http://web.mit.edu/2.25/www/pdf/DA_unified.pdf"^^xsd:anyURI ,
                                                                                                             "https://en.wikipedia.org/wiki/Dimensional_analysis"^^xsd:anyURI ;
                                                          rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                          rdfs:label "Quantity Kind Dimension Vector" .


###  http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS
<http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityKindDimensionVector> ;
                                                              <http://purl.org/dc/terms/description> "A <em>CGS Dimension Vector</em> is used to specify the dimensions for a C.G.S. quantity kind."^^rdf:HTML ;
                                                              rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                              rdfs:label "CGS Dimension vector" .


###  http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-EMU
<http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-EMU> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS> ;
                                                                  <http://purl.org/dc/terms/description> "A <em>CGS EMU Dimension Vector</em> is used to specify the dimensions for EMU C.G.S. quantity kind."^^rdf:HTML ;
                                                                  rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                                  rdfs:label "CGS EMU Dimension vector" .


###  http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-ESU
<http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-ESU> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS> ;
                                                                  <http://purl.org/dc/terms/description> "A <em>CGS ESU Dimension Vector</em> is used to specify the dimensions for ESU C.G.S. quantity kind."^^rdf:HTML ;
                                                                  rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                                  rdfs:label "CGS ESU Dimension vector" .


###  http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-GAUSS
<http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-GAUSS> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS> ;
                                                                    <http://purl.org/dc/terms/description> "A <em>CGS GAUSS Dimension Vector</em> is used to specify the dimensions for Gaussioan C.G.S. quantity kind."^^rdf:HTML ;
                                                                    rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                                    rdfs:label "CGS GAUSS Dimension vector" .


###  http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-LH
<http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-LH> rdf:type owl:Class ;
                                                                 rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS> ;
                                                                 <http://purl.org/dc/terms/description> "A <em>CGS LH Dimension Vector</em> is used to specify the dimensions for Lorentz-Heaviside C.G.S. quantity kind."^^rdf:HTML ;
                                                                 rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                                 rdfs:label "CGS LH Dimension vector" .


###  http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO
<http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityKindDimensionVector> ;
                                                              rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
                                                              rdfs:label "ISO Dimension vector" .


###  http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial
<http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial> rdf:type owl:Class ;
                                                                   rdfs:subClassOf <http://qudt.org/schema/qudt/QuantityKindDimensionVector> ;
                                                                   rdfs:isDefinedBy <http://qudt.org/schema/qudt> ;
